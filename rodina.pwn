						DestroyVehicleIter(GroveCar[4]);
						DestroyVehicleIter(GroveCar[5]);
						DestroyVehicleIter(GroveCar[6]);
						GroveCar[0] = CreateTeamVehicle(TEAM_FANTOMAS,1, 600, 2485.0903, -1680.8488, 13.2813, 19.7400, 86, 86,RES_CAR_TIME);
						GroveCar[1] = CreateTeamVehicle(TEAM_FANTOMAS,1, 600, 2488.3083, -1680.7385, 13.2813, 19.7400, 86, 86,RES_CAR_TIME);
