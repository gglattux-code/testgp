lendar_none\"},{\"id\":22,\"day\":22,\"title\":\"Секретный приз\",\"amount\":0,\"image\":\"calendar_none\"},{\"id\":23,\"day\":23,\"title\":\"Секретный приз\",\"amount\":0,\"image\":\"calendar_none\"},{\"id\":24,\"day\":24,\"title\":\"Секретный приз\",\"amount\":0,\"image\":\"calendar_none\"},{\"id\":25,\"day\":25,\"title\":\"Секретный приз\",\"amount\":0,\"image\":\"calendar_none\"},{\"id\":26,\"day\":26,\"title\":\"Секретный приз\",\"amount\":0,\"image\":\"calendar_none\"},{\"id\":27,\"day\":27,\"title\":\"Секретный приз\",\"amount\":0,\"image\":\"calendar_none\"},{\"id\":28,\"day\":28,\"title\":\"Секретный приз\",\"amount\":0,\"image\":\"calendar_none\"},{\"id\":29,\"day\":29,\"title\":\"Секретный приз\",\"amount\":0,\"image\":\"calendar_none\"},{\"id\":30,\"day\":30,\"title\":\"Секретный приз\",\"amount\":0,\"image\":\"calendar_none\"},{\"id\":31,\"day\":31,\"title\":\"Секретный приз\",\"amount\":0,\"image\":\"calendar_none\"}]]');");
	executeEvent(playerid, 0, (str_f("window.executeEvent('event.dailyReward.initializePlayerDay', '[{\"currentDay\":%d,\"needToPlay\":3600,\"played\":%d,\"received\":%d}]');", PI[playerid][currentDay], PI[playerid][played], PI[playerid][received])));
	hidePlayerHud(playerid);
	cursorPlayer(playerid, 0, true), dialog_player[playerid][D_Custom] = 1;
	return 1;
}

stock executeEvent(playerid, browser_id, event[])
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs,
		PR_UINT8, 220,
		PR_UINT8, 17,
		PR_UINT32, browser_id,
		PR_UINT16, strlen(event),
		PR_UINT8, 0,
		PR_STRING, event,
		PR_UINT32, 255);

	return PR_SendPacket(bs, playerid), BS_Delete(bs);
}

stock eventMobile(playerid, browser_id[], event[], event_encoded = 1)
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs, 
		PR_UINT8, 220,
		PR_UINT8, GetPlayerLauncher(playerid) == 2 ? 84 : 17,
		GetPlayerLauncher(playerid) == 2 ? PR_UINT8:PR_UINT32, browser_id[0]);

	if(GetPlayerLauncher(playerid) == 2)
		BS_WriteValue(bs, 
		PR_UINT8, browser_id[1]);

	BS_WriteValue(bs, 
	PR_UINT16, strlen(event), 
	PR_UINT8, event_encoded,
	event_encoded ? PR_CSTRING : PR_STRING, event, strlen(event));
	
	//else BS_WriteValue(bs, PR_STRING32, event);

	if(GetPlayerLauncher(playerid) != 2)
		BS_WriteUint32(bs, GetPlayerLauncher(playerid) == 1 ? 255 : 13);

	return PR_SendPacket(bs, playerid, GetPlayerLauncher(playerid) == 2 ? PR_HIGH_PRIORITY : PR_MEDIUM_PRIORITY, GetPlayerLauncher(playerid) == 2 ? PR_RELIABLE_ORDERED : PR_RELIABLE, GetPlayerLauncher(playerid) == 2 ? 0 : 6), BS_Delete(bs);
}
stock setPlayerTag(playerid, forplayerid, bool:set = false, tagName[] = "")
{
	new BitStream:bs = BS_New(), string[3][30];

	sscanf(tagName, "P<|>a<s[30]>[3]", string);

	BS_WriteValue(bs,
		PR_UINT8, 220,
		PR_UINT8, 120,
		PR_UINT16, playerid,
		PR_BOOL, bool:set);

	if(set)
		for(new i; i < 3; i++)
			if(!isnull(string[i]))
				BS_WriteValue(bs,
					PR_STRING8, string[i]);

	return PR_SendPacket(bs, forplayerid), BS_Delete(bs);
}

