}

stock ShowPhoneUpdateSettings(playerid)
{
	global_str = "\
		{AFAFAF}Объявления (/ad/благотворительность/Эдвард)\t\t%s\n\
		{AFAFAF}Рация (/r)\t\t\t%s\n\
		{AFAFAF}Департамент (/d)\t\t%s\n\
		{AFAFAF}Действия админов\t\t%s\n\
    	{AFAFAF}Сообщения об убийствах / розыске\t%s\n\
		{AFAFAF}VIP чат (/vr)\t\t\t%s\n\
		{AFAFAF}Рация семьи\t\t\t%s\n\
		{AFAFAF}Сообщения спавна авто\t%s";

	f(global_str, sizeof(global_str), global_str,
		PhoneImprovementsData[playerid][pdAnnouncements] ? ("{FF6347} [OFF]") : ("{9ACD32} [ON]"),
		PhoneImprovementsData[playerid][pdWalkieTalkie] ? ("{FF6347} [OFF]") : ("{9ACD32} [ON]"),
		PhoneImprovementsData[playerid][pdDepartment] ? ("{FF6347} [OFF]") : ("{9ACD32} [ON]"),
		PhoneImprovementsData[playerid][pdAdminAction] ? ("{FF6347} [OFF]") : ("{9ACD32} [ON]"),
		PhoneImprovementsData[playerid][pdReportsDeath] ? ("{FF6347} [OFF]") : ("{9ACD32} [ON]"),
		PhoneImprovementsData[playerid][pdVIPChat] ? ("{FF6347} [OFF]") : ("{9ACD32} [ON]"),
		PhoneImprovementsData[playerid][pdFamilyChat] ? ("{FF6347} [OFF]") : ("{9ACD32} [ON]"),
		PhoneImprovementsData[playerid][pdSpawnCarMessage] ? ("{FF6347} [OFF]") : ("{9ACD32} [ON]")
	);

    return SPD(playerid, 800, 2, "Выберите пункт", global_str, "Выбор", "Отмена");
}

stock ResetSpawnInfo(playerid, team)
	return SetSpawnInfo( playerid, 255, GetSkinOfPlayer(playerid), SpawnInfo[team][spawnCoord][0], SpawnInfo[team][spawnCoord][1], SpawnInfo[team][spawnCoord][2], SpawnInfo[team][spawnCoord][3], 0, 0, 0, 0, 0, 0);

stock IsValidEMail(email[])
{
	new bool:Succes = true, bool:Good;

	for(new i;i < strlen(email);i ++)
	{
	    if(email[i] == '@')
		{
		    if(!Good) Good = true;
		    else
			{
				Good = false;
		    	break;
			}
		}
	    if(!((email[i] >= 'A' && email[i] <= 'Z') || (email[i] >= 'a' && email[i] <= 'z') || (email[i] >= '0' && email[i] <= '9') || (email[i] == '-') || (email[i] == '_') || (email[i] == '@') || (email[i] == '.'))) Succes = false;
	}

	if(!Good) Succes = false;
	if(!TextFind(email,".ru") && !TextFind(email,".com") && !TextFind(email,".ua") && !TextFind(email,".su")) Succes = false;
	if(!TextFind(email,"@")) Succes = false;

  	return Succes;
}

stock DistancePointToPoint(Float: x, Float: y, Float: z, Float: fx, Float:fy, Float: fz) return floatround(floatsqroot(floatpower(fx - x, 2) + floatpower(fy - y, 2) + floatpower(fz - z, 2)));


stock CheckPassword(pass[])
{
	for(new i; i < strlen(pass); i++)
	{
	    if((pass[i] >= 'a' && pass[i] <= 'z') || (pass[i] >= 'A' && pass[i] <= 'Z') || (pass[i] >= 'а' && pass[i] <= 'я') || (pass[i] >= 'А' && pass[i] <= 'Я') || (pass[i] >= '0' && pass[i] <= '9')) continue;
		else return false;
	}
	return true;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
	if(dialogid && GetPVarInt(playerid, "DialogID") != dialogid) 
		return false;

	static inputtextsave[256];
	global_str = "";

	mysql_escape_string(inputtext, inputtextsave);

	for(new i; i < strlen(inputtextsave); i++)
	{
		switch inputtextsave[i] do
		{
			case 'A'..'Z', 'a'..'z', 'А'..'Я', 'а'..'я', '0'..'9', ' ', '>', '<', '(', ')', '/', '+', '-','_', '?', '!', '.', ',', '@': continue;
			default: inputtextsave[i] = ' ';
		}
	}
	
	for(new i; i < strlen(inputtextsave); i ++)
	{
		if(inputtextsave[i] == '%') inputtextsave[i] = '#';
		else if(inputtextsave[i] == '{' && inputtextsave[i+7] == '}') strdel(inputtextsave, i, i+8);
	}
	
	PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
	DeletePVar(playerid, "DialogOpen"), DeletePVar(playerid, "DialogID");

	if(dialogopen{playerid}) 
		dialogopen{playerid} = false;

	switch dialogid do
	{
	    case 24536:
		{
			if(!response)
				return false;
			
			if(PI[playerid][pMoney] < 25000)
				return false;

			GiveMoney(playerid, -25000);
					
			new vehiclei_id = ShowVeh[playerid];

			LinkVehicleToInterior(vehiclei_id, GetPlayerInterior(playerid));
			SetVehicleVirtualWorld(vehiclei_id, GetPlayerVirtualWorld(playerid));
			
			SetVehiclePos(vehiclei_id, 1868.2014, 1298.8839, 1660.2104);
			SetVehicleZAngle(vehiclei_id, 244);
			PutPlayerInVehicle(playerid, vehiclei_id, 0);
			pTemp[playerid][tParkingCar] = false;
			
		}

		case 25528:
	    {
	        if !response *then
	            return PlayerADDVIPSpawn(playerid);

			for new i; i < 25; i++ do {
				if(listitem == test3[playerid][i] && test3[playerid][i] != 0) {
					PI[playerid][pDCTime] = 1, PI[playerid][pHouseKey] = test1[playerid][i];
					break;
				}
			}
            if listitem == GlobalMassive[playerid][0] *then
	            PI[playerid][pDCTime] = 10;
	            
	        else if listitem == GlobalMassive[playerid][1] *then
	            PI[playerid][pDCTime] = 0;
	            
	        else if listitem == GlobalMassive[playerid][3] *then
	        {
                if FP_Data[playerid][F_FAMILY_ID] == -1 *then
					return SCM(playerid, COLOR_OLDRED, "[Ошибка] {FFFFFF}Вы не состоите в одной из семей!"), PlayerADDVIPSpawn(playerid);
					
	            if GetFamilyDataInt(FP_Data[playerid][F_FAMILY_ID], "kv_id") == -1 *then
             		return SCM(playerid, COLOR_OLDRED, "[Ошибка] {FFFFFF}У вашей семьи нету семейной квартиры / семейного дома!"), PlayerADDVIPSpawn(playerid);
                        
	            PI[playerid][pDCTime] = 6;
			}
	            
	        else if listitem == GlobalMassive[playerid][4] *then
	        {
	            if !PI[playerid][pMember][0] *then
	                return SCM(playerid, COLOR_WHITE, ">> {BE2D2D} Вы не состоите в организации!"), PlayerADDVIPSpawn(playerid);
	                
	            PI[playerid][pDCTime] = 2;
			}
			
			else if listitem == GlobalMassive[playerid][5] *then
			{
			    if PI[playerid][pVIP][0] < 7 *then
					return SCM(playerid, COLOR_OLDRED, "[Ошибка] {FFFFFF}У вас слишком маленький уровень VIP"), PlayerADDVIPSpawn(playerid);
					
	            PI[playerid][pDCTime] = 7;
			}
			
			return pTemp[playerid][tAddVipSpawn] = 0, PlayerSpawn(playerid);
	    }
		case 26522:
        {
            new table_id = g_player_dice_data[playerid][E_PLAYER_DICE_TABLE];

            if(response && table_id != INVALID_DATA_ID)
            {
                ClearPlayerDice(playerid, true),
                ClearAnimationsEx(playerid);

                showPlayerHud(playerid);

                if(g_dice_points[table_id][E_DICE_HOSTER] == playerid)
                    g_dice_points[table_id][E_DICE_HOSTER] = INVALID_PLAYER_ID;
            }

            else
            {
                executeEvent(playerid, 0, "window.executeEvent('event.setActiveView', `[\"Dice\"]`);"),
                cursorPlayer(playerid, 0, true);

                foreach(DiceTablePlayers[table_id], i) {
                    executeEvent(playerid, 0, (str_f("window.executeEvent('event.Dice.addPlayer', `[{ \"id\": %d, \"name\": \"%s\", \"status\": \"1\", \"score\": 0, \"isCurrent\": 0 }]`);", g_player_dice_data[i][E_PLAYER_DICE_ID], PN(i), g_dice_points[table_id][E_DICE_HOSTER] == i ? 2 : 1, playerid == i ? 1 : 0)));
                }

                if(g_dice_points[table_id][E_DICE_HOSTER] != playerid && g_dice_points[table_id][E_DICE_SESSION] == 2)
                	executeEvent(playerid, 0, (str_f("window.executeEvent('event.Dice.updateSession', `[{ \"status\": \"Ожидание игроков\", \"seconds\": null, \"buttonText\": \"Вступить в игру\", \"readyBets\": [], \"bet\": %d, \"sumBet\": %d, \"cubes\": null}]`);", g_dice_points[table_id][E_DICE_NEED_BET], g_dice_points[table_id][E_DICE_WIN_PRIZE])));

                else if(g_dice_points[table_id][E_DICE_SESSION] == 1 && g_dice_points[table_id][E_DICE_HOSTER] == playerid)
                	executeEvent(playerid, 0, "window.executeEvent('event.Dice.updateSession', `[{ \"status\": \"Выбор ставки\", \"seconds\": null, \"buttonText\": \"Сделать ставку\", \"readyBets\": [20000,100000,200000,1000000], \"bet\": null, \"sumBet\": 0, \"cubes\": null}]`);");

            }
		}
		case 26695:
		{
			if(!response) 
				return false;

			if(PI[playerid][pMoney] < TuningStationPlayerData[playerid][pCartCount])
				return SendPlayerError(playerid, "У вас не достаточно денег.");

			return TuningStationPlayerBuyTuning(playerid);
	    }
		case 25644:
		{
			if(!response)
				return true;

			new count = gpdList(playerid, 0), //SearchDonate(index, type)
				index = gpdList(playerid, 1),
				input = strval(inputtextsave),
				cost = PI[playerid][pVirMoney];
			
			if(count > 1 && !(1 <= input <= 100))
				return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "{FF6666}Ошибка", "{FF6666}- {FFFFFF}Допустимое количество: от 1 до 100", "Закрыть", "");

			if(cost < DonateInfo[index][dPrice]*count)
				return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "{FF6666}Ошибка", "{FF6666}- {FFFFFF}У вас не хватает денег на счету", "Закрыть", "");

			GiveDonate(playerid, -DonateInfo[index][dPrice] * (count > 1 ? input : 1) );

			AddItem(playerid, DonateInfo[index][dItem], (count > 1 ? input : 1), 0, -1, DonateInfo[index][dID] == 4 ? 1:0, IsAAks(DonateInfo[index][dItem]) or IsASkinInv(DonateInfo[index][dItem]) ? 100 : 0);

			if(GetPlayerLauncher(playerid) == 1) executeEvent(playerid, 0, (str_f("window.executeEvent('event.donateShop.initializeMainInfo', `[{\"buttonEventName\": \"BATTLEPASS\", \"buttonEventStatus\": 1,\"buttonEventImage\": 0,\"countMoney\": %d,\"countDonate\": %d,\"getBoostPayment\": 4}]`);", PI[playerid][pMoney], PI[playerid][pVirMoney])));
