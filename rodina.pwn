	return true;
}

CMD:time(playerid)
{
    if(CreateMats[playerid] == 4 || CreateMats[playerid] == 3) return 1;

    if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && PI[playerid][pHeal] == 0 && !PlayerLie{playerid})
        ApplyAnimationEx(playerid, "COP_AMBIENT", "Coplook_watch", 4.1, 0, 0, 0, 0, 0, 1);

    if(GetPlayerLauncher(playerid) != 1)
    {
        static const Mmtext[12][20] = {
            "Января", "Февраля", "Марта", "Апреля",
            "Мая", "Июня", "Июля", "Августа",
            "Сентября", "Октября", "Ноября", "Декабря"
        };

        new month, day, hour, minuite;
        gettime(hour, minuite, _);
        getdate(_, month, day);

        new time_str[140];
        f(time_str, sizeof time_str,
            "%d %s. %02d:%02d. Отыграно за час: %d минут!",
            day,
            Mmtext[month - 1],
            hour,
            minuite,
            floatround(float(PI[playerid][pPlayedTime]) / 60.0)
        );

        sendAlert(playerid, 1, "Информация", time_str, 6000);
    }
    else
    {
		SendPlayerJsonEvent(playerid, false, false, false, true);
        executeEvent(playerid, 0, (str_f("window.executeEvent('cef.hud.updateTimeWidgetInfo', `[{\"timestamp\":%d,\"playedToday\":%d,\"playedHour\":%d,\"components\":[{\"title\":\"Пора поесть\",\"description\":\"Ваш персонаж голоден!\",\"image\":\"foodWarning.webp\",\"gradientColors\":[\"#932200\",\"#FF9F05\"]}]}]`);",\
            Global_Time,\
            floatround(float(PI[playerid][pPlayedTime]) / 60.0),\
            floatround(float(PI[playerid][pPlayedTime]) / 60.0))));

        SetTimerEx("sendTimer", 5000, false, "ii", playerid, 75);
    }

    f(global_str, 150, "%s взглянул(a) на часы", PN(playerid));
    SetPlayerChatBubble(playerid, global_str, COLOR_PURPLE, 10.0, 5000);
    return 1;
}



