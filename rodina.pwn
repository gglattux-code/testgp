{
    if(ServerSetting[1] == false) return SCM(playerid, COLOR_RED, "[Ошибка]{FFFFFF} Неизвестная команда! Введите /help для просмотра доступных функций.");
    
	if !CheckFD(playerid, 3) *then
	    return SCM(playerid, COLOR_RED, "[Ошибка]{FFFFFF} Неизвестная команда! Введите /help для просмотра доступных функций.");
	    
