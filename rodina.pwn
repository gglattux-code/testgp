stock Give_Vip(playerid, vipid)
{
	if(PI[playerid][pVIP][0] >= 4+vipid)	
		return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "Ошибка", "У вас уже есть этот уровень VIP!", "Понял", "");

	PI[playerid][pVIP][0] = 4+vipid;
	PI[playerid][pVipTime] = Global_Time+(1800*24*60*60);

	f(mysql_string, 12, "%s", vipid == 4 ? "Dimond VIP":vipid == 5 ? "Titan VIP":"PREMIUM VIP");

	SQL("UPDATE `accounts` SET `VIP` = '%d', `VipTime` = '%d' WHERE `ID` = '%d'", PI[playerid][pVIP][0], PI[playerid][pVipTime], PI[playerid][pID]);
	SPDF(playerid, 0, 0, "", "{5FDA27}Поздравляем с покупкой %s!\n\n{FFFFFF}Посмотреть свои возможности вы можете в /help.", "Принять", "", mysql_string);
	SCMALLF(COLOR_RED, "[Информация]{FFFFFF} Игрок %s приобрел %s.", PN(playerid), mysql_string);

	return true;
}

stock getdonateID(id){
	for(new i; i < sizeof(DonateInfo); i++){
		if(DonateInfo[i][dID] == id){
			return i;
		}
	}
	return -2;
}

stock Buy_Other(playerid, money, type)
{
	if(money >= 1 && PI[playerid][pVirMoney] >= money)
	{
		switch(type)
		{
			case -1: GiveMoney(playerid, money*12000, "обмен доната на виртуальную валюту.");
			case -2:
			{
				if money > 1000 *then
					return SPD(playerid, 0, 0, "", "{BE2D2D}Произошла ошибка.Возможно одна из них:{FFFFFF}\n\n- Введено некоректное число\n- У вас недостаточно AZ-coins.\n", "Закрыть","");

				PI[playerid][pExp] += money * 2;
				CheckNextLevel(playerid);
			}
		}
	}
	else 
		return SPD(playerid, 0, 0, "", "{BE2D2D}Произошла ошибка.Возможно одна из них:{FFFFFF}\n\n- Введено некоректное число\n- У вас недостаточно AZ-coins.\n", "Закрыть","");

	PI[playerid][pVirMoney]-=money;

	if(GetPlayerLauncher(playerid) == 1) executeEvent(playerid, 0, (str_f("window.executeEvent('event.donateShop.initializeMainInfo', `[{\"buttonEventName\": \"BATTLEPASS\", \"buttonEventStatus\": 1,\"buttonEventImage\": 0,\"countMoney\": %d,\"countDonate\": %d,\"getBoostPayment\": 4}]`);", PI[playerid][pMoney], PI[playerid][pVirMoney])));
	else eventMobile(playerid, {42, 2}, (str_f("{\"buttonEventName\": \"BATTLEPASS\", \"buttonEventStatus\": 1,\"buttonEventImage\": 0,\"countMoney\": %d,\"countDonate\": %d,\"getBoostPayment\": 4}", PI[playerid][pMoney], PI[playerid][pVirMoney])));
	return sendAlert(playerid, 0, "Донат", "Успешная покупка!", 3500);
}
stock Buy_EXP(playerid, EXP)
{
	return 1;
}

stock Buy_Donate(playerid, number, count)
{
	if(number < 0)
		return Buy_Other(playerid, count, number);

	new id = getdonateID(number), item = DonateInfo[id][dItem], price = DonateInfo[id][dPrice];

	if(PI[playerid][pVirMoney] < DonateInfo[id][dPrice]*count) return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "Ошибка", "Недостаточно AZ-Coins", "Понял", ""); 

	if(item == -1)
	{
		switch(DonateInfo[id][dID])
		{
			case 0,1,2: Give_Vip(playerid, DonateInfo[id][dID]);
			case 118: SPDF(playerid, 912, DIALOG_STYLE_MSGBOX, "", "{FFFFFF}Сменить {6bc02e}Ник\n{FFFFFF}Стоимость: {6bc02e}%i {FFFFFF}az coins\n\nДает возможность сменить Ник вашего персонажа.\nНажмите {6bc02e}Enter {FFFFFF}чтобы приобрести.", "Обмен", "Отмена", price);
			case 119: PI[playerid][pBL] = 0, SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "Успешно!", "Вы успешно вышли из черного списка!", "Понял", "");
			case 120: SPDF(playerid, 1612, DIALOG_STYLE_MSGBOX, "", "{FFFFFF}Сменить пол\nСтоимость: {6bc02e}%i {FFFFFF}AZ Coins\n\nПосле приобретения, ваш {f0d52a}пол {FFFFFF}будет изменен.\nНажмите {6bc02e}Enter {FFFFFF}чтобы приобрести.", "Обмен", "Отмена", price);
			case 121: PI[playerid][pAllRepl] = 0, SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "Успешно!", "Вы успешно убрали наркозависимость!", "Понял", "");
			case 122: SPDF(playerid, 903, DIALOG_STYLE_MSGBOX, "", "{FFFFFF}2-3х значный номер для {6bc02e}телефона\n{FFFFFF}Стоимость: {6bc02e}%i {FFFFFF}AZ Coins\n\nДает возможность владеть рандомным 2-х или 3-х\nзначным номером для любых телефонов.\n\n{FFFF00}Осталось свободных номеров: %d шт.\n\n{FFFFFF}Нажмите {6bc02e}Enter {FFFFFF}чтобы приобрести.", "Обмен", "Отмена", price, 6);
			case 123:
			{
				if(!IsPlayerInHisVehicle(playerid))
					return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "Ошибка", "Вы не в своем авто!", "Понял", "");
				
				CarInfo[GetVehicleID(GetPlayerVehicleID(playerid))][cMilage] = 0;
				
				return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "", "\n\n{FFFFFF}Вы успешно убрали пробег с авто!\nТеперь его пробег равен нулю.\n\n", "Окей", "");
			}
			case 124: SPDF(playerid, 8991, DIALOG_STYLE_MSGBOX, "", "{FFFFFF}Семейная репутация: {6BC02E}1000 очков{FFFFFF}\nСтоимость: {6BC02E}%i{FFFFFF} AZ Coins\n\nНеобходима для покупки улучшений и семейных квартир.\nНажмите {6BC02E}Enter{FFFFFF} чтобы приобрести.", "Обмен", "Отмена", price);
			case 125: SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "Ошибка", "Вы не находитесь в тюрьме!", "Понял", "");
			case 128: SPDF(playerid, 9003, DIALOG_STYLE_MSGBOX, "", "{FFFFFF}Все доступные лицензии.\nСтоимость: {6BC02E}%i{FFFFFF} AZ Coins\n\nПосле покупки ваш персонаж будет владеть\nвсеми {F0D52A}лицензиями{FFFFFF}, доступными в игре.\nСрок годности лицензий: {F0D52A}1 год{FFFFFF}.\nНажмите {6BC02E}Enter{FFFFFF} чтобы приобрести.", "Обмен", "Отмена", price);
			case 137: SPDF(playerid, 8990, DIALOG_STYLE_MSGBOX, "", "{FFFFFF}Улучшение: {6BC02E}Дополнительные 6 ячеек{FFFFFF} инвентаря\nСтоимость: {6BC02E}%d{FFFFFF} AZ Coins\n\nПосле приобретения количество ячеек в вашем инвентере\nбудет увеличено на 6 пунктов, а так-же появится 3 страница.\nВсего можно увеличить инвентарь на 36 пунктов (6 улучшений)\nНажмите {6BC02E}Enter{FFFFFF} чтобы приобрести.", "Обмен", "Отмена", price);
			case 312: SPDF(playerid, 906, DIALOG_STYLE_MSGBOX, "", "{FFFFFF}Улучшение: {6bc02e}Навыки стрельбы\n{FFFFFF}Стоимость: {6bc02e}%i {FFFFFF}AZ coins\n\nПосле приобретения все навыки стрельбы будут улучшены\nдо максимального уровня.\nНажмите {6bc02e}Enter {FFFFFF}чтобы приобрести.", "Обмен", "Отмена", price);
			default: SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "Ошибка", "Данный товар временно недоступен!", "Понял", "");
		}
	}
	else
	{
		new itemCount = ItemsInfo[item][itemStack];
		
		
		
		f(global_str, sizeof global_str, " Вы действительно хотите приобрести товар - {FAAC58}%s{ffffff}?\n\n%s\n%s\n\n{FAAC58}|{ffffff} Стоимость приобретения: {FAAC58}%d {FFFFFF}AZ-Coins\nДля продолжения покупки нажмите кнопку Далее\n\n", ItemsInfo[item][itemName], ItemsInfo[item][itemName], ItemStory[GetItemStory(item)][itemStory], price);
	
		if itemCount > 1 *then
			strcat(global_str, "{cccccc}Вы так же можете ввести кол-во предмета, которое хотите приобрести.\nОт 1 до 100 штук за раз\n\n");
	
		spdList(playerid, 0, itemCount);
		spdList(playerid, 1, id);

		SPD(playerid, 25644, itemCount > 1 ? DIALOG_STYLE_INPUT : DIALOG_STYLE_MSGBOX, (str_f("{FAAC58}Приобретение %s", ItemsInfo[item][itemName])), global_str, "Далее", "Закрыть");
	}
	return true;
}

stock SendPlayerJsonEvent(playerid, bool:banner = false, visual = false, visual1 = false, visual2 = false){
	global_str[0] = EOS;

	if(PI[playerid][pCustomInterface][2]) strcat(global_str, "'hotkeysInformation','walletMoney','needsInformation','serverInformation','wanted','weaponInformation','voiceChatSpeakers','questsInformation','radio','levelInformation',");
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) strcat(global_str, "'speedometer',");
	if(SettingData[playerid][sdShowAddVip]) strcat(global_str, "'playerVipDuration',");
	if(banner) strcat(global_str, "'banner',");
	if(visual) strcat(global_str, "'interactionButton',");
	if(visual1) strcat(global_str, "'payDayWidget',");//'timeWidget',
	if(visual2) strcat(global_str, "'timeWidget',");
	if(Taxinfo[playerid][taxiID] == 3) strcat(global_str, "'taximeter',");
	if(ArendTime[playerid] != -1 || Taxinfo[playerid][taxiTimer][1] || _usePerson[playerid][0]) strcat(global_str, "'timer',");
	executeEvent(playerid, 0, (str_f("window.executeEvent('cef.hud.updateVisibleComponents', JSON.stringify([[%s]]));", global_str)));
}

cmd:setnamerus(playerid, data[])
{
	new targetid, textnick[128];
	if(sscanf(data, "ds[128]", targetid, textnick)) return SCM(playerid, COLOR_OLDRED, "[Ошибка] Используйте: /setnamerus [id] [nickname [RUS]]");
	SendAdminsMessage(COLOR_GREY, (str_f("[A] A: %s[%d] поменял игроку %s[%d] перевод ника на %s", PI[playerid][pRusName], playerid, PI[targetid][pRusName], targetid, textnick)));
	SCMF(targetid, COLOR_OLDRED, "[Информация] Администратора %s[%d] поменял вам перевод никнейма на %s", PI[playerid][pRusName], playerid, textnick);
	SetString(PI[targetid][pRusName], textnick), SQL("UPDATE `accounts` SET `NameRus` = '%s' WHERE `ID` = '%d' LIMIT 1", textnick, PI[playerid][pID]), setplayernameall(playerid);
	return 1;
}
stock LoadParking(){
    new Cache:result = mysql_query(mysql, "SELECT * FROM `orgsvehicles`"), count = cache_num_rows();
	if(!count) return 1;
    for (new i = 1; i < count; i++) {
        cache_get_value_name_int(i, "id", org_vehicles[i][cID]);
        cache_get_value_name_int(i, "fraction", org_vehicles[i][cFraction]);
		cache_get_value_name_int(i, "model", org_vehicles[i][cModel]);

		cache_get_value_name_int(i, "color_1", org_vehicles[i][cColor_1]);
		cache_get_value_name_int(i, "color_2", org_vehicles[i][cColor_2]);

        cache_get_value_name_int(i, "rank", org_vehicles[i][cRank]);

        org_vehicles[i][cCreated] = 0;
    }

	cache_delete(result);
    return 1;
}
stock LoadHotKeys(playerid)
{
	for(new i; i < sizeof(HotKeys); i++)
	{
		new BitStream:bs = BS_New();
		BS_WriteValue(bs, PR_UINT8, 220, PR_UINT8, 0, PR_UINT8, HotKeys[i][hkUid], PR_UINT8, 128);
        PR_SendPacket(bs, playerid);
	    BS_Delete(bs);
	}
	return 1; 
}

