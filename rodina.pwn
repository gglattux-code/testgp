		      			SCM(playerid,COLOR_GREEN, "[Подсказка] {FFFFFF}Используйте /house для управления домом.");
		      			SCM(playerid,COLOR_GREEN, "[Подсказка] {FFFFFF}Используйте /med чтобы использовать аптечку из дома!");
