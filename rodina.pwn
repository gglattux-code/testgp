stock SearchClickID(const text[], searchid)
{
	for new i; i < sizeof(browserClicked); i++ do
		if TextFind(text, browserClicked[i][searchtext]) *then return browserClicked[i][clickid][searchid];

	return -1;
}

stock GetMobileHideWebView(browserid, subid_1, subid_2)
{
	for(new i; i < sizeof(browserClicked); i++)
		if(browserClicked[i][clickid][0] == browserid && browserClicked[i][clickid][1] == subid_1 && browserClicked[i][clickid][2] == subid_2 && (TextFind(browserClicked[i][searchtext], "exit") or TextFind(browserClicked[i][searchtext], "hide") or TextFind(browserClicked[i][searchtext], "close")))
			return true;

	return false;
}

stock GetSizeToner(size)
{
	switch(size)
	{
		case 0, 5: return 245;
		case 10: return 235;
		case 15: return 225;
		case 20: return 216;
		case 25: return 206;
		case 30: return 196;
		case 35: return 186;
		case 40: return 176;
		case 45: return 166;
		case 50: return 157;
		case 55: return 147;
		case 60: return 137;
		case 65: return 127;
		case 70: return 117;
		case 75: return 107;
		case 80: return 97;
		case 85: return 88;
		case 90: return 78;
		case 95: return 68;
		case 100: return 58;
	}
	return 0;
}

public: SPD_function(playerid)
	return OnDialogResponse(playerid, dialog_player[playerid][D_ID], dialog_player[playerid][D_RESPONSE], dialog_player[playerid][D_LIST], dialog_player[playerid][D_INPUT]);

stock DialogConvert(playerid, input[])
{
	new string[256];
	f(string, sizeof(string), "%s", input);
	if(!strlen(string)) SetString(string, "NoData");
	return SetString(dialog_player[playerid][D_INPUT], string);
}

stock SendChatBubblePed(sendId, npcid, color_text, const text[], Float:drawdistance, time)
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs,
		PR_UINT8, 221,
		PR_UINT16, 85,
		PR_UINT16, npcid,
		PR_STRING32, text,
		PR_UINT32, color_text,
		PR_FLOAT, drawdistance,
		PR_UINT32, time);

	return PR_SendPacketToStream(bs, sendId), BS_Delete(bs);
}

stock CreateTaxiNPC(playerid, type)
{
	switch(type)
	{
		case 0:
		{
			new npcid = Iter_Free(CustomNPC);

			Taxi_actorData[npcid][taxi_OwnerID] = playerid,
			Taxi_actorData[npcid][taxi_Npcid] = Taxi_playerData[playerid][taxi_ID] = npcid;

			Iter_Add(CustomNPC, npcid);

			CreatePed(playerid,
			Taxi_actorData[npcid][taxi_Npcid],
			randomF(14,37),
			TaxiNpc[Taxinfo[playerid][taxiNpc][Taxinfo[playerid][taxiGet]]][npc_Pos][0], TaxiNpc[Taxinfo[playerid][taxiNpc][Taxinfo[playerid][taxiGet]]][npc_Pos][1], TaxiNpc[Taxinfo[playerid][taxiNpc][Taxinfo[playerid][taxiGet]]][npc_Pos][2], TaxiNpc[Taxinfo[playerid][taxiNpc][Taxinfo[playerid][taxiGet]]][npc_Pos][3],
			100.0, 0.0,
			0, 0,
			0xFFFFFFFF, (str_f("%s", TaxiStr_1[Taxinfo[playerid][taxiName][Taxinfo[playerid][taxiGet]]])),
			0xFFA600FF, "Клиент такси" );
		}
		case 1:
		{
			new npcid = Taxi_playerData[playerid][taxi_ID];
			enter_vehiclePed(playerid, npcid, GetPlayerVehicleID(playerid), 1);
			Taxi_actorData[npcid][taxi_CarIdSeat] = GetPlayerVehicleID(playerid);
			Taxi_playerData[playerid][taxi_PutInVehicle] = true;
		}
		case 2:
		{
			new npcid = Taxi_playerData[playerid][taxi_ID];
			DestroyPed(playerid, npcid);

			Taxi_playerData[playerid][taxi_Spawn] = false,
			Taxi_actorData[npcid][taxi_OwnerID] = Taxi_actorData[npcid][taxi_Npcid] = Taxi_playerData[playerid][taxi_ID] = INVALID_PLAYER_ID,
			Iter_Remove(CustomNPC, npcid);
		}
		case 3:
		{
			new npcid = Taxi_playerData[playerid][taxi_ID];
			exit_vehiclePed(playerid, npcid);
			Taxi_playerData[playerid][taxi_PutInVehicle] = false;
		}
	}
	return true;
}

stock exit_vehiclePed(sendId, npcid)
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs,
		PR_UINT8, 221,
		PR_UINT16, 84,
		PR_UINT16, npcid);

	return PR_SendPacketToStream(bs, sendId), BS_Delete(bs);
}

stock CEF_IsValidRegistrationNickname(const nickname[])
{
	new len = strlen(nickname);
	if(len < 3 || len > 20) return false;

	for(new i; i < len; i++)
	{
		if((nickname[i] >= 'A' && nickname[i] <= 'Z') ||
		   (nickname[i] >= 'a' && nickname[i] <= 'z') ||
		   (nickname[i] >= '0' && nickname[i] <= '9') ||
		   nickname[i] == '_') continue;
		return false;
	}
	return true;
}

stock CEF_IsValidRegistrationEmail(const email[])
{
	new len = strlen(email), at = -1, dot = -1;
	if(len < 5 || len >= 50) return false;

	for(new i; i < len; i++)
	{
		new ch = email[i];
		if(ch == '@')
		{
			if(at != -1 || i == 0) return false;
			at = i;
			continue;
		}
		if(ch == '.') dot = i;
		if((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') ||
		   (ch >= '0' && ch <= '9') || ch == '_' || ch == '-' || ch == '.') continue;
		return false;
	}

	return at > 0 && dot > at + 1 && dot < len - 2;
}

stock CEF_RegistrationError(playerid, const eventName[], const message[])
{
	executeEvent(playerid, 0, (str_f("window.executeEvent('%s', '[ \"%s\" ]');", eventName, message)));
	return false;
}

stock CEF_HandleAuthorization(playerid, const text[])
{
	new request[32], nickname[24], password[52], remember;
	if(sscanf(text, "P<|>s[32]s[24]s[52]i", request, nickname, password, remember))
		return CEF_RegistrationError(playerid, "event.auth.sendLoginError", "Некорректные данные авторизации");

	if(!CEF_IsValidRegistrationNickname(nickname))
		return CEF_RegistrationError(playerid, "event.auth.sendLoginError", "Введите корректный никнейм");

	if(strlen(password) < 1 || strlen(password) > 50)
		return CEF_RegistrationError(playerid, "event.auth.sendPasswordError", "Введите корректный пароль");

	if(!SetPlayerNameEx(playerid, nickname))
		return CEF_RegistrationError(playerid, "event.auth.sendLoginError", "Не удалось применить никнейм");

	new escapedNick[48];
	mysql_escape_string(nickname, escapedNick);
	mysql_tquery(mysql, (str_f("SELECT `ID`, `Password`, `LastIP`, `Mail`, `EmailAuth`, `SecurityID` FROM `accounts` WHERE `NickName` = '%s' LIMIT 1", escapedNick)), "LoginDialogMySQL", "ds", playerid, password);
	return true;
}

stock CEF_HandleRegistration(playerid, const text[])
{
	new request[32], nickname[24], password[52], mail[52], referral[24], promo[40];
	if(sscanf(text, "P<|>s[32]s[24]s[52]s[52]s[24]s[40]", request, nickname, password, mail, referral, promo))
		return CEF_RegistrationError(playerid, "event.auth.updateNicknameErrorMessage", "Некорректные данные регистрации");

	if(!CEF_IsValidRegistrationNickname(nickname))
		return CEF_RegistrationError(playerid, "event.auth.updateNicknameErrorMessage", "Никнейм должен содержать 3-20 символов: A-Z, 0-9 или _");

	if(strlen(password) < 6 || strlen(password) > 50)
		return CEF_RegistrationError(playerid, "event.auth.updatePasswordErrorMessage", "Пароль должен содержать от 6 до 50 символов");

	new escapedNick[48];
	mysql_escape_string(nickname, escapedNick);
	new Cache:result = mysql_query(mysql, (str_f("SELECT `ID` FROM `accounts` WHERE `NickName` = '%s' LIMIT 1", escapedNick)));
	if(cache_num_rows())
	{
		cache_delete(result);
		return CEF_RegistrationError(playerid, "event.auth.updateNicknameErrorMessage", "Данный никнейм уже зарегистрирован на сервере");
	}
	cache_delete(result);

	new onlinePlayer = GetPlayerID(nickname);
	if(onlinePlayer != INVALID_PLAYER_ID && onlinePlayer != playerid)
		return CEF_RegistrationError(playerid, "event.auth.updateNicknameErrorMessage", "Игрок с таким никнеймом уже подключен");

	mysql_escape_string(password, PI[playerid][pRegistrationPass]);

	if(!strcmp(mail, "null", true)) SetString(PlayerMail[playerid], "-");
	else
	{
		if(!CEF_IsValidRegistrationEmail(mail))
			return CEF_RegistrationError(playerid, "event.auth.updateMailErrorMessage", "Введите корректный E-Mail");
		mysql_escape_string(mail, PlayerMail[playerid]);
	}

	PI[playerid][pReferalID] = 0;
	SetString(PI[playerid][pReferalNickName], "");
	if(strcmp(referral, "null", true))
	{
		if(!CEF_IsValidRegistrationNickname(referral) || !strcmp(referral, nickname, true))
			return CEF_RegistrationError(playerid, "event.auth.updateReferralErrorMessage", "Реферал с таким никнеймом не найден");

		new escapedReferral[48];
		mysql_escape_string(referral, escapedReferral);
		result = mysql_query(mysql, (str_f("SELECT `ID` FROM `accounts` WHERE `NickName` = '%s' LIMIT 1", escapedReferral)));
		if(!cache_num_rows())
		{
			cache_delete(result);
			return CEF_RegistrationError(playerid, "event.auth.updateReferralErrorMessage", "Реферал с таким никнеймом не найден");
		}
		cache_get_value_name_int(0, "ID", PI[playerid][pReferalID]);
		SetString(PI[playerid][pReferalNickName], referral);
		cache_delete(result);
	}

	pTemp[playerid][tPromoUseID] = 0;
	DeletePVar(playerid, "RegistrationPromoLevel");
	if(strcmp(promo, "null", true))
	{
		new escapedPromo[80], promoLevel;
		mysql_escape_string(promo, escapedPromo);
		result = mysql_query(mysql, (str_f("SELECT `ID`, `promo_Lvl` FROM `promocode` WHERE `promo_Name` = '%s' LIMIT 1", escapedPromo)));
		if(!cache_num_rows())
		{
			cache_delete(result);
			return CEF_RegistrationError(playerid, "event.auth.updatePromoErrorMessage", "Промокод не найден");
		}
		cache_get_value_name_int(0, "ID", pTemp[playerid][tPromoUseID]);
		cache_get_value_name_int(0, "promo_Lvl", promoLevel);
		if(promoLevel < 1 || promoLevel > sizeof(PromoCodeInfo)) promoLevel = 1;
		SetPVarInt(playerid, "RegistrationPromoLevel", promoLevel);
		cache_delete(result);
	}

	if(!SetPlayerNameEx(playerid, nickname))
		return CEF_RegistrationError(playerid, "event.auth.updateNicknameErrorMessage", "Не удалось применить никнейм. Попробуйте другой");

	executeEvent(playerid, 0, "window.executeEvent('event.auth.successfulRegistration', '[ null ]');");
	executeEvent(playerid, 0, "window.executeEvent('event.auth.initializeCharacterEditor', '[ null ]');");
	return true;
}

stock ShowCefPublic(playerid, const text[], const mobileData[] = "0,0,0")
{
	if(GetPlayerLauncher(playerid) != 2 && RD_HandleCef(playerid, text)) return true;
	new request[150], id_var[5], stringData[3][40];

	if(GetPlayerLauncher(playerid) != 2) sscanf(text, "P<|>s[150]iiiii", request, id_var[0], id_var[1], id_var[2], id_var[3], id_var[4]);	
	else sscanf(mobileData, "P<,>a<i>[4]", id_var);

	//printf("debug mobile: id_var[0]: %d, id_var[1]: %d, id_var[2]: %d, id_var[3]: %d, id_var[4]: %d | const text: %s | const mobileData: %s", id_var[0], id_var[1], id_var[2], id_var[3], id_var[4], text, mobileData);
	
	if(TextFind(text, "close") || TextFind(text, "Escape")) for(new i; i < 2; i++) HideCef(playerid, i);

	//print(mobileData);
	print(text);

	switch(GetPlayerLauncher(playerid) == 2 ? id_var[0] : SearchClickID(text, 0))
	{
		case 25:
		{
			if(!PI[playerid][pProgressBar][0])
				return false;

			
			PI[playerid][pProgressBar][1] += 5;
			
			if(PI[playerid][pProgressBar][1] > 100)
				PI[playerid][pProgressBar][1] = 100, progressBarEnd(playerid);			

			eventMobile(playerid, {25, 0}, (str_f("{\"progress\":%d,\"text\":\"Для взаимодействия быстро нажимайте на палец\"}", PI[playerid][pProgressBar][1])));

		}
		
		case 124:
		{
			switch(GetPlayerLauncher(playerid) == 2 ? id_var[2] : SearchClickID(text, 0))
			{
				case 1:
				{
					new  i = pTemp[playerid][pSellCar], carid = autoBazarInfo[i][autoBazarCarID];


					if (autoBazarInfo[i][autoBazarplayerid] == INVALID_PLAYER_ID)
						return false;
					
					//if (!IsPlayerRegCar(autoBazarInfo[i][autoBazarplayerid], carid))
					//	return false;

					switch(autoBazarInfo[i][aCost]) 
					{
						case 0: if(PI[playerid][pMoney] < autoBazarInfo[i][autoBazarCost])  return sendAlert(playerid, 2, "Ошибка", "Недостаточно средств.", 3500);
						case 1: if(GetCount(playerid, 3207) < autoBazarInfo[i][autoBazarCost]) return sendAlert(playerid, 2, "Ошибка", "Недостаточно биткоина.", 3500);
					}

					if (IsValidNumberCars(playerid))
					{		
						switch(autoBazarInfo[i][aCost]) 
						{
							case 0: GiveMoney(autoBazarInfo[i][autoBazarplayerid], autoBazarInfo[i][autoBazarCost]), GiveMoney(playerid, -autoBazarInfo[i][autoBazarCost]);
							case 1: AddItem(autoBazarInfo[i][autoBazarplayerid], 3207, autoBazarInfo[i][autoBazarCost]), AddItem(playerid, 3207, -autoBazarInfo[i][autoBazarCost]);
						}

						SetCarOwner(carid, PN(playerid));
						GetNumberCars(playerid, PI[playerid][pCars]);
						GetNumberCars(autoBazarInfo[i][autoBazarplayerid], PI[playerid][pCars]);
						CarInfo[carid][cShtrafer] = 0;
						
						SCM(playerid, COLOR_VALIK, "[Информация] {FFFFFF}Поздравляем с приобретением транспортного средства");
						SCM(autoBazarInfo[i][autoBazarplayerid], COLOR_VALIK, "[Информация] {FFFFFF}Поздравляем с продажей транспортного средства.");
						RemovePlayerFromVehicle(autoBazarInfo[i][autoBazarplayerid]);
										
						autoBazarInfo[i][autoBazarCarID] = INVALID_VEHICLE_ID;
						autoBazarInfo[i][autoBazarplayerid] = INVALID_PLAYER_ID;
						
						DestroyDynamicArea(autoBazarInfo[i][autoBazarArea]);
						DestroyDynamic3DTextLabel(autoBazarInfo[i][autoBazarText]);
						for new z; z < 4; z++ do 
							DestroyDynamicObject(autoBazarInfo[i][autoBazarObject][z]);
						
						UpdateDynamic3DTextLabelText(autoBazarInfo[i][autoBazarLabel], -1, "{BE433D}Посигнальте\n{FFFFFF}чтобы выставить транспорт на продажу");
						SaveOwnableCar(GetVehicleID(carid));

						cursorPlayer(playerid, GetPlayerLauncher(playerid) != 2 ? 1 : 124, false);
					}
					else
					{
						SCM(playerid, COLOR_GREY, "[Ошибка] {FFFFFF}Ваш уровень VIP недостаточно высок чтобы иметь столько авто!");
						SCM(playerid, COLOR_GREY, "[Ошибка] {FFFFFF}Возможно у вас нет дома, он даст вам +1 слот к авто");
					}

				}
				case 2:
					return cursorPlayer(playerid, 124, false);
			}
			
		}
		
		
		case 66,57:
			ShowCefPublic(playerid, text, (str_f("52, %d, %d", id_var[1], id_var[2])));
	
		case 114:
		{
			switch(GetPlayerLauncher(playerid) != 2 ? SearchClickID(text, 1) : id_var[2])
			{
				case 2:
				{					
					switch(GetPlayerLauncher(playerid) != 2 ? SearchClickID(text, 2) : id_var[3])
					{
						case 0:
						{
							new count_prize = randomF(1,3), case_i = finder_caseID(pTemp[playerid][tCaseID]);
							
							if(!GetCount(playerid, CaseInfo[case_i][CaseIDItem]))
								return false;
							
							DeleteItem(playerid,  CaseInfo[case_i][CaseIDItem]);
							global_str[0] = EOS;
							for(new i, random_prize; i < count_prize; i++)
							{
								random_prize = random(CaseInfo[case_i][CasePrizeMax]);

								if(random_prize > CaseInfo[case_i][CasePrizeMax]-5)
									random_prize = random(CaseInfo[case_i][CasePrizeMax]);


								pTemp[playerid][tCasePrizes][i] = random_prize;
								f(global_str, sizeof(global_str), "%s{\"item\":%d,\"count\":%d}%s", global_str, CaseInfo[case_i][CasePrize][random_prize], CaseInfo[case_i][CasePrizeAmount][random_prize], i < count_prize-1 ? "," : "");
							}
							switch(GetPlayerLauncher(playerid))
							{
								case 1:
								{
									executeEvent(playerid, 0, "window.executeEvent('openCase.updatedGauranteedProgresses', `[7]`);");
									executeEvent(playerid, 0, (str_f("window.executeEvent('openCase.initializeRewards', `[[%s]]`);", global_str)));
									executeEvent(playerid, 0, "window.executeEvent('openCase.selectVideo', `[\"bp26\"]`); ");
								}
								case 2:
								{
									eventMobile(playerid, {114, 1}, (str_f("[%s]", global_str)));
									eventMobile(playerid, {114, 4}, "bp26");
								}
							}
						}
						case 1:
						{
							new amount_shards, case_i = finder_caseID(pTemp[playerid][tCaseID]), text_request[64], count;

							switch(GetPlayerLauncher(playerid))
							{
								case 1:
								{
									sscanf(text, "P<|>s[64]s[64]", request, text_request);
									
									for(new i; i < 3; i++)
										id_var[i] = -1;
									
									sscanf(text_request, "P<,>ddd", id_var[0], id_var[1], id_var[2]);
								}
								case 2:
								{
									for(new i; i < 3; i++)
										id_var[i] = -1;
									
									sscanf(text, "P<,>ddd", id_var[0], id_var[1], id_var[2]);
								}
							}

							for(new i; i < 3; i++)
							{
								if(id_var[i] == -1)
									continue;
								
								if(pTemp[playerid][tCasePrizes][id_var[i]] != -1)
									amount_shards += CaseInfo[case_i][CaseShards][pTemp[playerid][tCasePrizes][id_var[i]]];
								
								pTemp[playerid][tCasePrizes][id_var[i]] = -1;
							}
							for(new i; i < 3; i++)
							{
								if(pTemp[playerid][tCasePrizes][i] != -1)
									count++;
							}
							if(!count)
								playerCaseViewer(playerid, pTemp[playerid][tCaseID], 1);

							
							if(!amount_shards)
								return false;

							
