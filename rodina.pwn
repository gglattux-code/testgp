            executeEvent(playerid, 0, "window.executeEvent('event.questsApp.initializeQuestProgress', '[[{ \"id\":0,\"categoryId\":2,\"statusId\":1,\"accessType\": -1,\"timeLeft\": 0,\"stages\": [{\"id\": 0, \"progress\": 0 }]},{ \"id\":1,\"categoryId\":2,\"statusId\":1,\"accessType\": -1,\"timeLeft\": 0,\"stages\": [{\"id\": 0, \"progress\": 0 }]},{ \"id\":2,\"categoryId\":2,\"statusId\":1,\"accessType\": -1,\"timeLeft\": 0,\"stages\": [{\"id\": 0, \"progress\": 0 }]},{ \"id\":3,\"categoryId\":2,\"statusId\":1,\"accessType\": -1,\"timeLeft\": 0,\"stages\": [{\"id\": 0, \"progress\": 0 }]},{ \"id\":4,\"categoryId\":2,\"statusId\":1,\"accessType\": -1,\"timeLeft\": 0,\"stages\": [{\"id\": 0, \"progress\": 0 }]},{ \"id\":5,\"categoryId\":2,\"statusId\":1,\"accessType\": -1,\"timeLeft\": 0,\"stages\": [{\"id\": 0, \"progress\": 0 }]}]]');");
