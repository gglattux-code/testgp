public OnGameModeInit()
{
    ServerSetting[0] = true; // тюнинг on
    ServerSetting[1] = true; // mgb on
    
	RD_InitPortedSystems();

	new day, month, year;
	getdate(year, month, day);

	Load3DText();

	TaxiSettings[0] = 50000000;
	TaxiSettings[1] = 100000000;

	Global_Time = gettime();

	SetString(botCheckName, "The_State");

	for(new i; i < MAX_VEHICLES; i++)
	{
		OwnableCar[i] = INVALID_VEHICLE_ID;
		SetString(CarInfo[i][cOwner], "The State");
		SetString(CarInfo[i][cKeyer], "The State");
		SetString(VehicleInfo[i][vNumber], "Rodina ST");
		CarInfo[i][cID] =
		VehicleInfo[i][vID] =
		VehicleInfo[i][vFamily] =
		SellCard[i] = -1;
		if(i < MAX_PLAYERS)
		{
			TradeInfo[i][tradePlayer] = INVALID_PLAYER_ID;

			for(new idx; idx < 20; idx++)
			{
				if(idx < 10)
					TradeInfo[i][tradeItem][idx] = -1;

				FP_Data[i][F_FAMILY_IDCAR_CARS][idx] = INVALID_VEHICLE_ID,
				FP_Data[i][F_FAMILY_PLAYER_CARS][idx] = INVALID_PLAYER_ID;
			}
		}
		if(i < 25) BattlePassQuests[random(sizeof(BattlePassQuests))][QuestEnable] = true;

		if(i < sizeof(org_parkings)){
			CreateDynamic3DTextLabel("{BE433D}Фракционная парковка\n{FFFFFF}Посигнальте, чтобы поставить транспорт", 0xFFFFFFFF, org_parkings[i][pEnter][0], org_parkings[i][pEnter][1], org_parkings[i][pEnter][2] + 1.4, 7.0000);
			org_parkings_pickup[i] = CreateDynamicPickup(16954, 23, org_parkings[i][pEnter][0], org_parkings[i][pEnter][1], org_parkings[i][pEnter][2]-0.5, -1);
		}
		if(i < MAX_COTTON_OBJECT)
		{
			CottonInfo[i][cottonScore] = 10;

			CottonInfo[i][cottonStatus] = true;

			CottonInfo[i][cottonObject] = CreateDynamicObject(819, CottonInfo[i][cottonPosX], CottonInfo[i][cottonPosY], CottonInfo[i][cottonPosZ] - 0.5, 0.000000, 0.000000, 90.000000, -1, -1, -1, STREAMER_OBJECT_SD, 150.0);

			f(global_str, 80, "Хлопок (%d из 10)\n{73B461}Сбор урожая", CottonInfo[i][cottonScore]);
			CottonInfo[i][cottonLabel] = CreateDynamic3DTextLabel(global_str, -1, CottonInfo[i][cottonPosX], CottonInfo[i][cottonPosY], CottonInfo[i][cottonPosZ], 15.0, INVALID_VEHICLE_ID, INVALID_PLAYER_ID);
		}

		if(i < MAX_LINEN_OBJECT)
		{
			LinenInfo[i][linenScore] = 10;

			LinenInfo[i][linenStatus] = true;

			LinenInfo[i][linenObject] = CreateDynamicObject(865, LinenInfo[i][linenPosX], LinenInfo[i][linenPosY], LinenInfo[i][linenPosZ] - 0.5, 0.000000, 0.000000, 90.000000, -1, -1, -1, STREAMER_OBJECT_SD, 150.0);
			f(global_str, 70, "Лён (%d из 10)\n {73B461}Сбор урожая", LinenInfo[i][linenScore]);
			LinenInfo[i][linenLabel] = CreateDynamic3DTextLabel(global_str, -1, LinenInfo[i][linenPosX], LinenInfo[i][linenPosY], LinenInfo[i][linenPosZ], 15.0, INVALID_VEHICLE_ID, INVALID_PLAYER_ID);
		}

		if(i < sizeof startup)
		{
			startup[i][startLabel] = CreateDynamic3DTextLabel((str_f("{FF8600}%s\n{FFFFFF}Стартап #%i\n\nСтоимость: {FF8600}%i биткоинов{FFFFFF}\nДоход: {FF8600}%i биткоинов{FFFFFF} каждые {FF8600}3{FFFFFF} минуты\n\nВладелец: {FF8600}Нет", startup[i][startName], i, startup[i][startCost], startup[i][startBTC])), -1, startup[i][startPos][0], startup[i][startPos][1], startup[i][startPos][2], 15.0, INVALID_VEHICLE_ID, INVALID_PLAYER_ID);
			CreatePickup(15457, 23, startup[i][startPos][0], startup[i][startPos][1], startup[i][startPos][2], -1);
		}

		if(i < sizeof(MineInfo))
		{
			MineInfo[i][mineStatus] = true;

			MineInfo[i][mineObject] = CreateDynamicObject(854, MineInfo[i][minePosX], MineInfo[i][minePosY], MineInfo[i][minePosZ], -5.499997, 0.000000, -26.200012, -1, -1);
			switch(random(49))
			{
				case 0..15: MineInfo[i][minePoroda] = 4;
				case 16..25: MineInfo[i][minePoroda] = 3;
				case 26..35: MineInfo[i][minePoroda] = 2;
				case 36..45: MineInfo[i][minePoroda] = 1;
			}
			MineInfo[i][mineLabel] = CreateDynamic3DTextLabel("Месторождение ресурсов\n{73B461}Добыча ископаемого", -1, MineInfo[i][minePosX], MineInfo[i][minePosY], MineInfo[i][minePosZ], 15.0, INVALID_VEHICLE_ID, INVALID_PLAYER_ID);
		}

		if(i < MAX_CONTAINERS)
		{
			f(global_str, 550,"Контейнер:\n\nКласс: {E98E52}%s \n{FFFFFF}Начальная цена: {E98E52}%d Руб.\n\n{FFFFFF}Аукцион(открыт)\n\n- Последняя ставка: {E98E52}-\n{FFFFFF}- Последняя сумма: {E98E52}", ContainerInfo[i][cClass], ContainerInfo[i][cMinStavka]);

			Conteinertext[i] = CreateDynamic3DTextLabel(global_str,-1,ContainerInfo[i][cX],ContainerInfo[i][cY],ContainerInfo[i][cZ]+1.2,3.0);
			ContainerInfo[i][cPickup] = CreateDynamicPickup(1277,1,ContainerInfo[i][cX],ContainerInfo[i][cY],ContainerInfo[i][cZ],-1);

