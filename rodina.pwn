cmd:donate(playerid)
{
	HideInvent(playerid);
	switch(GetPlayerLauncher(playerid)) {
		case 1: {
		    hidePlayerHud(playerid);
			executeEvent(playerid, 0, "window.executeEvent('event.setActiveView', `[\"DonateShop\"]`);");
			executeEvent(playerid, 0, (str_f("window.executeEvent('event.donateShop.initializeMainInfo', `[{\"buttonEventName\": \"BATTLEPASS\", \"buttonEventStatus\": 1,\"buttonEventImage\": 0,\"countMoney\": %d,\"countDonate\": %d,\"getBoostPayment\": 4}]`);", PI[playerid][pMoney], PI[playerid][pVirMoney])));
			executeEvent(playerid, 0, "window.executeEvent('event.donateShop.updateSelectedCategory', `[0]`);");
			SetTimerEx("sendTimer", 1000, false, "ii", playerid, 66);
		}
		case 2: {
			cursorPlayer(playerid, GetPlayerLauncher(playerid) == 2 ? 42:1, true), dialog_player[playerid][D_Custom] = 1;
			eventMobile(playerid, {42, 2}, (str_f("{\"buttonEventName\": \"BATTLEPASS\", \"buttonEventStatus\": 1,\"buttonEventImage\": 0,\"countMoney\": %d,\"countDonate\": %d,\"getBoostPayment\": 4}", PI[playerid][pMoney], PI[playerid][pVirMoney])));
		}
	}
	/*if(GetPlayerLauncher(playerid) == 1)
