stock CheckNalog(playerid, count, showid = 0)
{
	new ir; global_str[0] = EOS;

	switch count do
	{
		case 0:
		{
			for new i = 1; i < OWNABLEBIZES;i ++ do
			{
				if BizData[i][bLevel] >= 190000 *then
				{
					f(global_str, sizeof(global_str), "%s%d. Бизнес\t\t{10F441}больше %d{FFFFFF} payday.", global_str, showid ? i:ir+1,floatround(float(250000-BizData[i][bLevel])/GLS[3], floatround_ceil)+1);
					ir++;
				}
				else if GetString(BizData[i][bOwner], "The State") *then
				{
					if i < 10 *then f(global_str,sizeof(global_str),"%s%d. %s [id: %d]\t\t[{10F441}Слетел{FFFFFF}]\n", global_str, ir+1,  BizData[i][bName], i);
					else f(global_str, sizeof(global_str),"%s%d. %s [id: %d]\t\t[{10F441}Слетел{FFFFFF}]\n", global_str, ir+1,  BizData[i][bName], i);
					ir++;
				}
				if ir == 50 *then
				{
					break;
				}
				
			}
			if !ir *then
				sendAlert(playerid, 1, "Информация", "На данный момент доступной информации нету.", 2500);
			else
			{
				sendAlert(playerid, 1, "Информация", "Для поиска дома используйте /findibiz (id бизнеса). Стоимость 1500руб.", 2500);
				sendAlert(playerid, 1, "Информация", "ID отображается только у слетевших бизнесов.", 2500);
				SPD(playerid, 0, DIALOG_STYLE_LIST, "", global_str, "Закрыть", "");
			}	
		}
		case 1:
		{
			for new i = 1; i < OWNABLEHOUSES; i ++ do
			{
			    if HouseInfo[i][hNalog] == 0 *then
			    {
					if !GetString(HouseInfo[i][hOwner], "The State") && HouseInfo[i][hNalog] >= 80000 *then
					{
						f(global_str, sizeof(global_str), "%s%d. Дом\t\t До слета: {10F441}больше %d{FFFFFF} payday.\n", global_str, ir+1, floatround(float(104000-HouseInfo[i][hNalog])/GLS[2], floatround_ceil)+1);
						ir++;
					}
					else if GetString(HouseInfo[i][hOwner], "The State") *then
					{
						f(global_str, sizeof(global_str), "%s%d. Дом [id: %d]:\t{FFFFFF}[{10F441}Слетел{FFFFFF}]\n", global_str, ir+1, i);
						ir++;
					}
					if ir == 50 *then
					{
						break;
					}
					
				}
			}
			if strlen(global_str) < 2 *then
				sendAlert(playerid, 1, "Информация", "На данный момент доступной информации нету.", 2500);
			else
			{
				SPD(playerid, 0, DIALOG_STYLE_LIST,  "", global_str, "Закрыть", "");
				sendAlert(playerid, 1, "Информация", "Для поиска дома используйте /findihouse (id дома). Стоимость 1500руб.", 2500);
				sendAlert(playerid, 1, "Информация", "ID отображается только у слетевших домов.", 2500);
			}
		}
	}
	return 0;
}

stock SpeedometrSetting(playerid, speed = false)
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if(VehicleState[vehicleid] == 8 or VehicleState[vehicleid] == 7)
		return false;

	switch speed do
	{
		case 0: 
		{
			SendPlayerJsonEvent(playerid);
			executeEvent(playerid, 0, "window.executeEvent('cef.hud.updateSpeedometerType', '[\"null\"]');");
		}
		case 1:
		{
			switch(GetPlayerLauncher(playerid))
 			{
				case 1:
				{
					SendPlayerJsonEvent(playerid);
					executeEvent(playerid, 0, (str_f("window.executeEvent('cef.hud.updateSpeedometerType', '[\"%s\"]');", PI[playerid][pCustomInterface][1] == 0 ? "old" : PI[playerid][pCustomInterface][1] == 1 ? "simple" : "advanced")));
					executeEvent(playerid, 0, (str_f("window.executeEvent('vehicle.mileage.update','[%d]');", IsAOwnableCar(vehicleid) ? CarInfo[GetVehicleID(vehicleid)][cMilage] : 0.0)));
					executeEvent(playerid, 0, (str_f("window.executeEvent('vehicle.fuel.update','[%d]');", floatround(Fuel[vehicleid]))));
				}
				case 2: 
				{
					sendPlayerCustom_packet(playerid, 4, 1);
					
					new BitStream:bs = BS_New();
					for(new i; i < 2; i++)
					{
						BS_WriteValue(bs, 
							PR_UINT8, 220, 
							PR_UINT8, i ? 7 : 5, 
							PR_FLOAT, i ? Fuel[vehicleid] : IsAOwnableCar(vehicleid) ? CarInfo[GetVehicleID(vehicleid)][cMilage] : 0.0), 
						PR_SendPacket(bs, playerid), BS_Reset(bs);
					}
					BS_Delete(bs);
				}
			}
		}
	}
	return true;
}

stock GetCarSalon (model)
{
	switch model do
	{
		case 479,542,526,547,405,467,545,549,546,527,492,555,552,578,601: return 1;//модели эконом класса
		case 550,567,426,410,401,560,522,482,411,434,404,534,533,602,541,516,551,420,600: return 2;//модели премиум класса
		case 585,494,451,506,579,1821,1822,1823,466,505,400,402,436,536,485,580,613,529,1806,1809,1814: return 3;//модели высокого класса
		case 407,416,427,431,544,556,596: return 4;//модели нелегального класса
		case 487,469,1815,497,1985: return 5;//модели воздушного класса
	}
	return -1;
}
