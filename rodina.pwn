	for new i; i < 2; i++ do { 
		global_str = "", f(global_str, sizeof(global_str), "Игрок <a href=..%s%s>%s</a> вошёл на сервер. IP: %s", !i ? "/pages/user?name=":"/player/search?query=", PN(playerid), PN(playerid), PlayerIp[playerid]);
		aml(global_str, i, PlayerIp[playerid]);
	}
	if(PI[playerid][pHouseKey] > OWNABLEHOUSES) PI[playerid][pHouseKey] = -1;

	if(_registerPlayer[playerid])
	{
		_registerPlayer[playerid] = false;
