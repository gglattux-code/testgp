stock GetItemStory(item_id)
{
    switch(item_id)
    {
		case 3: return 48;
		case 3204: return 45;
		case 3205: return 44;
		case 1208: return 42;
		case 3206: return 41;
		case 654..660,675: return 39;
		case 688,689,691,681,4188,682,683,684,685,686: return 36;
		case 964: return 20;
		case 4: return 37;
		case 25: return 21;
		case 26: return 22;
		case 3207: return 25;
		case 233: return 26;
		case 148..150,1024: return 27;
		case 3578: return 28;
        case 762: return 2;
        case 5126: return 12;
		case 7885: return 50;
        default:
        {
            if(IsAAks(item_id)) return 1;
            else if(IsASkinInv(item_id)) return 4;
			else if(IsRoullete(item_id)) return 23;
			else if(IsPhone(item_id)) return 29;
			else if(IsLicense(item_id)) return 30;
			else if(IsShop(item_id, 1)) return 32;
			else if(IsShop(item_id, 0)) return 33;
			else if(IsShop(item_id, 3)) return 35;
			else if(IsACarInv(ItemsInfo[item_id][itemModel])) return 40;
			else if(IsMoneta(item_id)) return 43;
			else if(IsTuning(item_id)) return 46;
			else if(ItemsInfo[item_id][itemTradeable] == true) return 49;
        }
    }
    
    return 0;
}


stock IsTuning(itemid) {
	if(TextFind(ItemsInfo[itemid][itemName], "Виз. тюнинг"))
		return true;

	return false;

}
stock IsMoneta(itemid) {
	if(TextFind(ItemsInfo[itemid][itemName], "монета") || TextFind(ItemsInfo[itemid][itemName], "Монета"))
		return true;

	return false;

}
stock IsASert(id)
{
    if(TextFind(ItemsInfo[id][itemName], "Сертификат")) return 1;
	return 0;
}

stock IsShop(itemid, type) {
	for new i; i < GetShopItemCount(type); i++ do
	{
		if(itemid == ShopData[type][shopItem][i])
			return true;
	}

	return false;
}

stock IsRoullete(itemid) {
	if(TextFind(ItemsInfo[itemid][itemName], "рулетка") || TextFind(ItemsInfo[itemid][itemName], "Рулетка"))
		return true;

	return false;

}

stock IsLicense(itemid) {
	if(TextFind(ItemsInfo[itemid][itemName], "Лицензия"))
		return true;

	return false;

}

stock IsPhone(itemid) {
	if(TextFind(ItemsInfo[itemid][itemName], "Мобильный телефон") || TextFind(ItemsInfo[itemid][itemName], "Vivo") || 
	TextFind(ItemsInfo[itemid][itemName], "Apple iPhone") || TextFind(ItemsInfo[itemid][itemName], "Asus ROG") || 
	TextFind(ItemsInfo[itemid][itemName], "Google Pixel") || TextFind(ItemsInfo[itemid][itemName], "Honor") || TextFind(ItemsInfo[itemid][itemName], "Huawei") 
	|| TextFind(ItemsInfo[itemid][itemName], "Xiaomi") || TextFind(ItemsInfo[itemid][itemName], "Motorola") || TextFind(ItemsInfo[itemid][itemName], "Nothing") 
	|| TextFind(ItemsInfo[itemid][itemName], "Oppo") || TextFind(ItemsInfo[itemid][itemName], "POCO") || TextFind(ItemsInfo[itemid][itemName], "Samsung") 
	|| TextFind(ItemsInfo[itemid][itemName], "Sony"))
		return true;

	return false;

}

