		cache_get_value_name_int(0, "DB_Day", PassInfo[playerid][psDateBirth][0]);
		cache_get_value_name_int(0, "DB_Month", PassInfo[playerid][psDateBirth][1]);
		cache_get_value_name_int(0, "DB_Year", PassInfo[playerid][psDateBirth][2]);
