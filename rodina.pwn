	if(IsPlayerInRangeOfPoint(playerid, 5.0, 506.1710,-69.5010,999.6721) || IsPlayerInRangeOfPoint(playerid, 5.0, 493.8653,-17.5930,1001.1519) || IsPlayerInRangeOfPoint(playerid, 5.0, -2652.9382,1410.2617,906.2734))
	{
