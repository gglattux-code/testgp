new QI[][QuestInfo] =
{
	//Диалог
    {"Начало {6DA5EF}[Сюжет]{FFFFFF}","{FFFFFF}Как и в любом мегаполисе у нас никуда без регистрации.\nОна необходима банально для покупки своей первой машины или дома.\n\nЯ так понимаю, ты сюда приехал не просто так и планы у тебя грандиозные, соответственно тебе нужно\nзарегистрироваться в нашем округе.\n\nНаграда за выполение:\n1000 BTC и 500 ехр",1, {-250.000000, 512.000000, 12.100000}},
    {"Первая работа {6DA5EF}[Сюжет]{FFFFFF}","{FFFFFF}Конечно, бесплатно жилье ты себе вряд ли найдешь, так что придется хорошенько поработать.\nВ нашем округе есть две классные работы для тех, кто недавно прибыл, такие как городская почта.\nЗарплата там хорошая, поэтому отправляйся туда и заработай свои первые бабки.\n\nНаграда за выполение:\n1000 BTC и 500 ехр",15, {819.492004, 1299.290039, 12.001600}},
    {"Водительское удостоверение {6DA5EF}[Сюжет]{FFFFFF}","{FFFFFF}С документами и первыми деньгами вопрос решен, что насчет водительских прав?\nНеподалеку есть хорошая автошкола, отправляйся туда и сдай экзамен на права.\nДумаю водить ты умеешь.\n\nНаграда за выполение:\n1000 BTC и 500 ехр",1, {414.033996, 1628.400024, 12.000000}},
	{"Большая работа {6DA5EF}[Сюжет]{FFFFFF}","{FFFFFF}Поздравляю! Теперь ты полностью укомплектован документами.\nНо твой капитал все еще очень маленький. Время для работы посеръезнее!\nОтправляйся к моему знакомому на ферму и заработай нормальные бабки.\n\nНаграда за выполение:\n1000 BTC и 500 ехр", 20, {-245.707901, 1762.843505, 13.749400}},
	{"Первая недвижимость {6DA5EF}[Сюжет]{FFFFFF}","{FFFFFF}Так то лучше. Теперь у тебя есть стартовый капитал для развития.\nНо ты все еще бездомный. Как тебе идея приобрести недвижимость?\nУ нас в округе огромный выбор домов и квартир на любой вкус.\nНайди то, что тебе по душе и купи себе свою первую крышу над головой.\n\nНаграда за выполение:\n1000 BTC и 500 ехр",1},
	{"Первая машина {6DA5EF}[Сюжет]{FFFFFF}","{FFFFFF}Другое дело! Теперь ты оффициальный житель нашего округа.\n Что на счет средства передвижения? В наши автосалоны недавно завезли крутые тачки.\nПредлагаю тебе отправиться в один из них и обзавестись новой тачкой.\n\nНаграда за выполение:\n1000 BTC и 500 ехр",1, {2518.805175, -960.785827, 5.019499}},
	{"Пора прощаться {6DA5EF}[Сюжет]{FFFFFF}","{FFFFFF}Ну вот и все, мой дорогой друг. Наши приключения закончились.\nЯ думаю, что у нас получилось сделать из тебя человека.\nДержи немного бабок для дальнейшего развития\n\nУдачного пути!\n\nНаграда за выполение:\n1000 BTC и 500 ехр",1},
	//CEF Квесты
	{"Пивозавр","Эй, новенький! Добро пожаловать на Родину.<br>Подойди ко мне, я постараюсь тебе помочь освоиться здесь!", 0, {0.0, 0.0, 0.0}, "Иду"},
    {"Начало","Привет, дружище, меня зовут Пивозавр. Добро пожаловать в наш округ.<br>Я помогу тебе освоиться и начать новую жизнь здесь.<br>Согласен?", 0, {0.0, 0.0, 0.0}, "Привет, с чего рекомендуешь начать?"},
    {"Начало","Как и в любом мегаполисе у нас никуда без регистрации.<br>Она необходима банально для покупки своей первой машины или дома.<br><br>Я так понимаю, ты сюда приехал не просто так и планы у тебя грандиозные, соответственно тебе нужно<br>зарегистрироваться в нашем округе.",0, {0.0, 0.0, 0.0} , "Конечно, как это сделать?"},
    {"Начало","Хорошо, раз ты согласен, рассказываю, что нужно делать.<br><br>Смотри, регистрацию у нас оформляют в мэрии.<br>Сейчас тебе нужно будет отправиться туда и оформить ее на информационной стойке.<br>Сам процесс довольно простой, так что разберешься на месте.<br><br>Окей?",1, {-250.000000, 512.000000, 12.100000}, "Окей, я поехал!"},
    {"Первая работа","Конечно, бесплатно жилье ты себе вряд ли найдешь, так что придется хорошенько поработать.<br>В нашем округе есть две классные работы для тех, кто недавно прибыл, это городская почта и оружейный завод.<br>Зарплата везде примерно одинаковая, так что выбирай, где ты хочешь поработать?",15, {819.492004, 1299.290039, 12.001600}, "Я хочу работать на почте!"},
    {"Водительское удостоверение","С документами и первыми деньгами вопрос решен, что насчет водительских прав?<br>Неподалеку есть хорошая автошкола, отправляйся туда и сдай экзамен на права.<br>Думаю водить ты умеешь.",1, {414.033996, 1628.400024, 12.000000}, "Я буду как Вин Дизель!"},
	{"Большая работа","Поздравляю! Теперь ты полностью укомплектован документами.<br>Но твой капитал все еще очень маленький. Время для работы посеръезнее!<br>Отправляйся к моему знакомому на ферму и заработай нормальные бабки.", 20, {-245.707901, 1762.843505, 13.749400}, "Без прблем!"},
	{"Первая недвижимость","Так то лучше. Теперь у тебя есть стартовый капитал для развития.<br>Но ты все еще бездомный. Как тебе идея приобрести недвижимость?<br>У нас в округе огромный выбор домов и квартир на любой вкус.<br>Найди то, что тебе по душе и купи себе свою первую крышу над головой.", 1, {0.0, 0.0, 0.0}, "Хорошая идея!"},
	{"Первая машина","Другое дело! Теперь ты оффициальный житель нашего округа.<br> Что на счет средства передвижения? В наши автосалоны недавно завезли крутые тачки.<br>Предлагаю тебе отправиться в один из них и обзавестись новой тачкой.", 1, {2518.805175, -960.785827, 5.019499}, "Машины я люблю!"},
	{"Пора прощаться","Ну вот и все, мой дорогой друг. Наши приключения закончились.<br>Я думаю, что у нас получилось сделать из тебя человека.<br>Держи немного бабок для дальнейшего развития<br><br>Удачного пути!", 1, {0.0, 0.0, 0.0}, "Спасибо!"},
	//Для /quest 19..25
	{"Начало","Хорошо, раз ты согласен, рассказываю, что нужно делать. Смотри, регистрацию у нас оформляют в мэрии. Сейчас тебе нужно будет отправиться туда и оформить ее на информационной стойке. Сам процесс довольно простой, так что разберешься на месте. Окей?", 1},
	{"Первая работа","Конечно, бесплатно жилье ты себе вряд ли найдешь, так что придется хорошенько поработать. В нашем округе есть две классные работы для тех, кто недавно прибыл, это городская почта и оружейный завод. Зарплата везде примерно одинаковая, так что выбирай, где ты хочешь поработать?", 2},
	{"Водительское удостоверение","С документами и первыми деньгами вопрос решен, что насчет водительских прав? Неподалеку есть хорошая автошкола, отправляйся туда и сдай экзамен на права. Думаю водить ты умеешь.", 5},
	{"Большая работа","Поздравляю! Теперь ты полностью укомплектован документами. Но твой капитал все еще очень маленький. Время для работы посеръезнее! Отправляйся к моему знакомому на ферму и заработай нормальные бабки.", 2},
	{"Первая недвижимость","Так то лучше. Теперь у тебя есть стартовый капитал для развития. Но ты все еще бездомный. Как тебе идея приобрести недвижимость? У нас в округе огромный выбор домов и квартир на любой вкус. Найди то, что тебе по душе и купи себе свою первую крышу над головой.", 3},
	{"Первая машина","Другое дело! Теперь ты оффициальный житель нашего округа. Что на счет средства передвижения? В наши автосалоны недавно завезли крутые тачки. Предлагаю тебе отправиться в один из них и обзавестись новой тачкой.", 8},
	{"Пора прощаться","Ну вот и все, мой дорогой друг. Наши приключения закончились. Я думаю, что у нас получилось сделать из тебя человека. Держи немного бабок для дальнейшего развития Удачного пути!", 1},

	{"Начало","Хорошо, раз ты согласен, рассказываю, что нужно делать. Смотри, регистрацию у нас оформляют в мэрии. Сейчас тебе нужно будет отправиться туда и оформить ее на информационной стойке. Сам процесс довольно простой, так что разберешься на месте. Окей?", 1},
	{"Первая работа","Конечно, бесплатно жилье ты себе вряд ли найдешь, так что придется хорошенько поработать. В нашем округе есть две классные работы для тех, кто недавно прибыл, это городская почта и оружейный завод. Зарплата везде примерно одинаковая, так что выбирай, где ты хочешь поработать?", 2},
	{"Водительское удостоверение","С документами и первыми деньгами вопрос решен, что насчет водительских прав? Неподалеку есть хорошая автошкола, отправляйся туда и сдай экзамен на права. Думаю водить ты умеешь.", 5},
	{"Большая работа","Поздравляю! Теперь ты полностью укомплектован документами. Но твой капитал все еще очень маленький. Время для работы посеръезнее! Отправляйся к моему знакомому на ферму и заработай нормальные бабки.", 2},
	{"Первая недвижимость","Так то лучше. Теперь у тебя есть стартовый капитал для развития. Но ты все еще бездомный. Как тебе идея приобрести недвижимость? У нас в округе огромный выбор домов и квартир на любой вкус. Найди то, что тебе по душе и купи себе свою первую крышу над головой.", 3},
	{"Первая машина","Другое дело! Теперь ты оффициальный житель нашего округа. Что на счет средства передвижения? В наши автосалоны недавно завезли крутые тачки. Предлагаю тебе отправиться в один из них и обзавестись новой тачкой.", 8},
	{"Пора прощаться","Ну вот и все, мой дорогой друг. Наши приключения закончились. Я думаю, что у нас получилось сделать из тебя человека. Держи немного бабок для дальнейшего развития Удачного пути!", 1},

	{"Пивозавр","Эй, новенький! Добро пожаловать на Родину. Подойди ко мне, я постараюсь тебе помочь освоиться здесь!", 0, {0.0, 0.0, 0.0}, "Иду"},
	{"Начало","Привет, дружище, меня зовут Пивозавр. Добро пожаловать в наш округ. Я помогу тебе освоиться и начать новую жизнь здесь. Согласен?", 0, {0.0, 0.0, 0.0}, "Привет, с чего рекомендуешь начать?"},
	{"Начало","Как и в любом мегаполисе у нас никуда без регистрации. Она необходима банально для покупки своей первой машины или дома. Я так понимаю, ты сюда приехал не просто так и планы у тебя грандиозные, соответственно тебе нужно зарегистрироваться в нашем округе.",0, {0.0, 0.0, 0.0} , "Конечно, как это сделать?"},
	{"Начало","Хорошо, раз ты согласен, рассказываю, что нужно делать. Смотри, регистрацию у нас оформляют в мэрии. Сейчас тебе нужно будет отправиться туда и оформить ее на информационной стойке. Сам процесс довольно простой, так что разберешься на месте. Окей?",1, {-250.000000, 512.000000, 12.100000}, "Окей, я поехал!"},
	{"Первая работа","Конечно, бесплатно жилье ты себе вряд ли найдешь, так что придется хорошенько поработать. В нашем округе есть две классные работы для тех, кто недавно прибыл, это городская почта и оружейный завод. Зарплата везде примерно одинаковая, так что выбирай, где ты хочешь поработать?",15, {819.492004, 1299.290039, 12.001600}, "Я хочу работать на почте!"},
	{"Водительское удостоверение","С документами и первыми деньгами вопрос решен, что насчет водительских прав? Неподалеку есть хорошая автошкола, отправляйся туда и сдай экзамен на права. Думаю водить ты умеешь.",1, {414.033996, 1628.400024, 12.000000}, "Я буду как Вин Дизель!"},
	{"Большая работа","Поздравляю! Теперь ты полностью укомплектован документами. Но твой капитал все еще очень маленький. Время для работы посеръезнее! Отправляйся к моему знакомому на ферму и заработай нормальные бабки.", 20, {-245.707901, 1762.843505, 13.749400}, "Без прблем!"},
	{"Первая недвижимость","Так то лучше. Теперь у тебя есть стартовый капитал для развития. Но ты все еще бездомный. Как тебе идея приобрести недвижимость? У нас в округе огромный выбор домов и квартир на любой вкус. Найди то, что тебе по душе и купи себе свою первую крышу над головой.", 1, {0.0, 0.0, 0.0}, "Хорошая идея!"},
	{"Первая машина","Другое дело! Теперь ты оффициальный житель нашего округа. Что на счет средства передвижения? В наши автосалоны недавно завезли крутые тачки. Предлагаю тебе отправиться в один из них и обзавестись новой тачкой.", 1, {2518.805175, -960.785827, 5.019499}, "Машины я люблю!"},
	{"Пора прощаться","Ну вот и все, мой дорогой друг. Наши приключения закончились. Я думаю, что у нас получилось сделать из тебя человека. Держи немного бабок для дальнейшего развития Удачного пути!", 1, {0.0, 0.0, 0.0}, "Спасибо!"}
};

