stock PlayerADDVIPSpawn(playerid)
{
	if(GetPlayerLauncher(playerid) == 1)
	{
		hidePlayerHud(playerid);
		executeEvent(playerid, 0, "window.executeEvent('event.setActiveView', '[\"SpawnSelection\"]');");

		new j=0;
        if PI[playerid][pLastPos][0] != 0.0 *then j++;
        j=j+1;
		for new i; i < OWNABLEHOUSES; i++ do  if GetString(HouseInfo[i][hOwner], PN(playerid)) *then j++;
		if(FP_Data[playerid][F_FAMILY_ID] > -1 && GetFamilyDataInt(FP_Data[playerid][F_FAMILY_ID], "kv_id") != -1) j++;
		if PI[playerid][pMember][0] != 0 *then j++;
		if PI[playerid][pVIP][0] > 7 && PI[playerid][pPremiumPos][0] > 0 *then j++;
		global_str = "";
	    new count = 0;
	    if(PI[playerid][pLastPos][0] != 0.0) {
			strcat(global_str, (str_f("{\"id\": %i, \"title\": \"Последнее место выхода\", \"image\": \"7\", \"favorite\": 0},", count)));
			GlobalMassive[playerid][0] = count;
		 	count++;
		}
	    else GlobalMassive[playerid][0] = -1;
	    strcat(global_str, (str_f("{\"id\": %i, \"title\": \"Вокзал\", \"image\": \"0\", \"favorite\": 0}%s", count, j == count+1 ? "":",")));
		GlobalMassive[playerid][1] = count;
		count++;
		for new i; i < OWNABLEHOUSES; i++ do {
		    if GetString(HouseInfo[i][hOwner], PN(playerid)) *then {
		    	strcat(global_str, (str_f("{\"id\": %i, \"title\": \"Дом №%d\", \"image\": \"6\", \"favorite\": 0}%s", count, HouseInfo[i][hID], j == count+1 ? "":",")));
				test1[playerid][test2[playerid]] = i;
				test3[playerid][test2[playerid]] = count;
				test2[playerid]++;
	 			GlobalMassive[playerid][2] = count;
			  	count++;
			}
		}

		if(FP_Data[playerid][F_FAMILY_ID] > -1 && GetFamilyDataInt(FP_Data[playerid][F_FAMILY_ID], "kv_id") != -1) {
			strcat(global_str, (str_f("{\"id\": %i, \"title\": \"Семейный дом / квартира\", \"image\": \"4\", \"favorite\": 0}%s", count, j == count+1 ? "":",")));
			GlobalMassive[playerid][3] = count;
			count++;
		}

		if PI[playerid][pMember][0] != 0 && PI[playerid][pMember][0] != -1 *then strcat(global_str, (str_f("{\"id\": %i, \"title\": \"Организация\", \"image\": \"6\", \"favorite\": 0}%s", count, j == count+1 ? "":","))), GlobalMassive[playerid][4] = count, count++;
		if PI[playerid][pVIP][0] > 7 && PI[playerid][pPremiumPos][0] > 0 *then {
			strcat(global_str, (str_f("{\"id\": %i, \"title\": \"Сохраненная точка\", \"image\": \"7\", \"favorite\": 0}", count)));
			GlobalMassive[playerid][5] = count;
		}

		if(count <= 1) 
			PlayerSpawn(playerid), HideCef(playerid, 0);

		else {
			executeEvent(playerid, 0, (str_f("window.executeEvent('event.spawn-selection.initializeSpawns', '[[%s]]');", global_str)));
			cursorPlayer(playerid, 0, true), dialog_player[playerid][D_Custom] = 1;
		}
	}
	else
	{
	    global_str = "";
	    
	    new count = 1;
	    
	    if PI[playerid][pLastPos][0] > 0 *then
		{
			strcat(global_str, (str_f("{B03131}[%i] {FFFFFF}Последнее место выхода\n", count)));
			GlobalMassive[playerid][0] = count-1;
		 	count++;
		}
	    else GlobalMassive[playerid][0] = -1;

	    strcat(global_str, (str_f("{B03131}[%i] {FFFFFF}Вокзал\n", count)));
		GlobalMassive[playerid][1] = count-1;
		count++;

		for new i; i < OWNABLEHOUSES; i++ do
		{
		    if GetString(HouseInfo[i][hOwner], PN(playerid)) *then
		    {
		    	strcat(global_str, (str_f("{B03131}[%i] {FFFFFF}Дом №%d\n", count, HouseInfo[i][hID])));
				test1[playerid][test2[playerid]] = i;
				test3[playerid][test2[playerid]] = count-1;
				test2[playerid]++;
	 			GlobalMassive[playerid][2] = count-1;
			  	count ++;
			}
		}
		
		if FP_Data[playerid][F_FAMILY_ID] > -1 *then
		{
		    if GetFamilyDataInt(FP_Data[playerid][F_FAMILY_ID], "kv_id") != -1 *then
		    {
				strcat(global_str, (str_f("{B03131}[%i] {FFFFFF}Семейный дом / квартира\n", count)));
				GlobalMassive[playerid][3] = count-1;
			 	count++;
			}
		}
		
		if PI[playerid][pMember] != 0 *then strcat(global_str, (str_f("{B03131}[%i] {FFFFFF}Организация\n", count))), GlobalMassive[playerid][4] = count-1, count++;
		
		if PI[playerid][pVIP] > 7 && PI[playerid][pPremiumPos][0] > 0 *then
		{
			strcat(global_str, (str_f("{B03131}[%i] {FFFFFF}Сохраненная точка", count)));
			GlobalMassive[playerid][5] = count-1;
		}
	    return SPD(playerid, 25528, DIALOG_STYLE_LIST, "Выбор места спавна", global_str, "Выбрать", "");
	}
	return 1;
}

public OnPlayerCommandReceived(playerid, cmd[], params[], flags)
{
	if(!pTemp[playerid][tAuthorized]) 
		return false;

	if(!CheckAdminCommand(playerid, cmd))
		return false;

	return true;
}

stock CheckAdm(playerid, level, CheckAutorizaction = 1, CheckAcceptAdmin = 1)
{
	if(PI[playerid][pAdmin] < level)
		return SCM(playerid, COLOR_OLDRED, "[Ошибка] {cccccc}У Вас нет доступа к этой команде."), false;	

	else if(!ADuty{playerid} && CheckAutorizaction)
		return SCM(playerid, COLOR_GREY, "[A] Вы не авторизованы. Используйте {33CCFF}/apanel"), false;

	else if(!AcceptAdm{playerid} && CheckAcceptAdmin)
		return SCM(playerid, COLOR_RED, "[Ошибка]{FFFFFF} Наблюдается попытка взлома!"), SendAdminsMessage(COLOR_OLDRED, (str_f("%s [%d] подозревается во зломе, проверьте его и авторизируйте /acceptadmin [6+ lvl]", PN(playerid), playerid))), false;

 	return true;
}

stock CheckAdminCommand(playerid, command[])
{
	for(new i; i < sizeof(AdminCommandList); i++) 
	{
		if !GetString(AdminCommandList[i][adminCommand], command) && !TextFind(AdminCommandList[i][adminCommandAlias], (str_f("|%s|", command))) *then
			continue;

		if !CheckAdm(playerid, AdminCommandList[i][adminLevel], AdminCommandList[i][adminCheckAuthorization]) *then
			return false;

		if AdminCommandList[i][adminAccess] && !CheckFD(playerid, AdminCommandList[i][adminAccess]) *then
			return false;

		if(AdminCommandList[i][adminAntiSlivTime])
		{
			if(Int_GetPlayerData(playerid, command) > Global_Time)
				return SCMF(playerid, COLOR_OLDRED, "[Ошибка]{cccccc} Воспользоваться данной командой вы сможете через {FFFFFF}%d{cccccc} секунд!", Int_GetPlayerData(playerid, command) - Global_Time), false;

			else 
				Int_SetPlayerData(playerid, command, Global_Time + AdminCommandList[i][adminAntiSlivTime]); 
		}
	}

	return true;
}

stock LoadAdminCommands()
{
	new id, Cache:result = mysql_query(mysql, "SELECT * FROM command ORDER BY id");
	
	for(new i; i < cache_num_rows(); i++)
	{
		cache_get_value_name_int(i, "id", id);
		cache_get_value_name_int(i, "level", AdminCommandList[id][adminLevel]);
		cache_get_value_name_int(i, "access", AdminCommandList[id][adminAccess]);
		cache_get_value_name_int(i, "timeout", AdminCommandList[id][adminAntiSlivTime]);
		cache_get_value_name_int(i, "authorization", AdminCommandList[id][adminCheckAuthorization]);
		cache_get_value_name_int(i, "accept", AdminCommandList[id][adminCheckAccept]);
	}

	return cache_delete(result);
}

cmd:setrazdacha(playerid, data[])
{
	if !CheckFD(playerid, 2) *then
	    return SCM(playerid, COLOR_OLDRED, NO_DOSTUP_TEXT);
	
	extract data -> new itemId, count; else
	    return SCM(playerid, COLOR_OLDRED, "Используйте: /setrazdacha [ид предмета] [количество] {FFFFFF}(ЧТОБЫ ОТКЛЮЧИТЬ РАЗДАЧУ ИСПОЛЬЗУЙТЕ ИД ПРЕДМЕТА КАК 0)");

	if(itemId < 0 or sizeof(ItemsInfo) < itemId)
		return SendErrorMessage(playerid);

	if(count < 1 or count > ItemsInfo[itemId][itemStack])
		return SCMF(playerid, COLOR_OLDRED, "[Ошибка]{FFFFFF} Для данного предмета количество для раздачи должно быть в диапозоне от 1 до %d шт.", ItemsInfo[itemId][itemStack] );

	SCMF(playerid, COLOR_VALIK, "[Информация]{FFFFFF} Вы поставили на раздачу %s ( %d шт.)", ItemsInfo[itemId][itemName], count);
	
	RazdachaData[razdacha_itemid] = itemId;
	RazdachaData[razdacha_count] = count;

	return true;
}

cmd:admincommands(playerid, data[])
{
	if !CheckFD(playerid, 1) *then
	    return SCM(playerid, COLOR_OLDRED, NO_DOSTUP_TEXT);

	extract data -> new level; else
	    return SCM(playerid, COLOR_OLDRED, "Используйте: /admincommands [lvl adm (1-8)]");

	if(level > 8 or level < 1)
		return SendErrorMessage(playerid);

	global_str = "{FFFFFF}Команда\t{FFFFFF}Доступна с уровня\t{FFFFFF}AntiSpam-Time (seconds)\t{FFFF00}Access (Дополнительные)";

	for(new i, num; i < sizeof(AdminCommandList); i++) 
	{	
		if(!(AdminCommandList[i][adminLevel] == level)) continue;

		spdList(playerid, num, i);
		strcat(global_str, (str_f("\n{FFFF00}%s\t{FFFFFF}%d\t{FFFFFF}%d\t%s", AdminCommandList[i][adminCommand], AdminCommandList[i][adminLevel], AdminCommandList[i][adminAntiSlivTime], Admin_Command_Type[AdminCommandList[i][adminAccess]])));
		num++;
	}

	return SPD(playerid, 9910, DIALOG_STYLE_TABLIST_HEADERS, "{FFFFFF} Admin Commands Editor", global_str, "»", "x");
}

stock IsARPPN(Name[])
{
	if(strlen(Name)>19) return 0;
	if(!strlen(Name)) return 0;
	new simb_, num; static RP_Name[2][24];
	for(new i = 0;i < strlen(Name);i ++)
	{
	    if(Name[i] == '_') {simb_ ++; num=i;}
	}
	if(simb_ != 1) return 0;
	strmid(RP_Name[0], Name, 0, num-1);
	strmid(RP_Name[1], Name, num+1, strlen(Name));
	if( !IsAGoodPN(RP_Name[0]) || !IsAGoodPN(RP_Name[1]) ) return 0;
	return 1;
}

stock IsAGoodPN(Name[])
{
	new NameChars;
	if(strlen(Name) < 2) return 0;
	if(Name[0] < 'A' || Name[0] > 'Z') return 0;
	for(new i = 1;i < strlen(Name);i ++)
	{
	    if(Name[i] < 'a' || Name[i] > 'z')
		{
		    if(Name[i] >= 'A' && Name[i] <= 'Z') NameChars ++;
		    else return 0;
		}
	    if(NameChars > 1) return 0;
	}
	return 1;
}

