		}
	}

	BS_WriteValue(bs,
		PR_UINT8, 220,
		PR_UINT8, 187, 
		PR_UINT16, vehicleid, 
		PR_BOOL, true);

	PR_SendPacket(bs, playerid), BS_Delete(bs);

	BS_WriteValue(bs,
		PR_UINT16, vehicleid,
		PR_UINT16, 0, 
		PR_UINT8, 0, 
		PR_UINT8, 1, 
		PR_UINT8, 29, 
		PR_UINT8, open ? 82 : 52);

	return PR_SendRPC(bs, playerid, 161), BS_Delete(bs);
}

stock UpdateDriftPointsDisplay(playerid)
{
    new string[10], string1[10], vehicleid = GetPlayerVehicleID(playerid);

	format(string, sizeof(string), "%d", driftPoints[playerid]);
	format(string1, sizeof(string1), "%s", FormatNumberWithLeadingZeros(driftPoints[playerid]));

	SetDynamicObjectMaterialText(DriftObjects[vehicleid][2], 0, string, 120, "Arial", 122, 1, 0xffcd5c5c, 0, 2);
	SetDynamicObjectMaterialText(DriftObjects[vehicleid][4], 0, string1, 120, "Arial", 122, 1, 0xaa000000, 0, 2);
}

stock FormatNumberWithLeadingZeros(number) {
    new formattedNumber[10];
    format(formattedNumber, sizeof(formattedNumber), "%09d", number);
    return formattedNumber;
}

stock UpdateDriftPointsTotal(playerid)
{
    new string[30], string1[30], vehicleid = GetPlayerVehicleID(playerid);

	format(string, sizeof(string), "TOTAL: %d", driftPointsTotal[playerid]);
	format(string1, sizeof(string1), "TOTAL: %d", driftPointsTotal[playerid]);

	SetDynamicObjectMaterialText(DriftObjects[vehicleid][5], 0, string, 120, "Arial", 60, 1, 0xffffffff, 0, 2);
	SetDynamicObjectMaterialText(DriftObjects[vehicleid][7], 0, string1, 120, "Arial", 60, 1, 0xffffffff, 0, 2);
}

stock UpdateDriftWear(playerid)
{
    new string[128], vehicleid = GetPlayerVehicleID(playerid);

	format(string, sizeof(string), "%.1f", tireWear[playerid]);

	SetDynamicObjectMaterialText(DriftObjects[vehicleid][9], 0, string, 120, "Arial", 80, 1, 0xffadff2f, 0, 1);
}


public: driftUpdate( playerid, vehicleid )
{
	if(driftPoints[playerid] > 0 && Global_Time-driftWaiting[playerid] >= 5)
	{
		if driftPoints[playerid] > driftPointsTotal[playerid] *then
		{
			driftPointsTotal[playerid] = driftPoints[playerid];
			UpdateDriftPointsTotal(playerid);
		}
		driftPoints[ playerid ] = 0, driftWaiting[ playerid ] = 0;
		UpdateDriftPointsDisplay(playerid);
	}

	new Float: velocity_x, Float: velocity_y, Float: velocity_z;
	GetVehicleVelocity( vehicleid, velocity_x, velocity_y, velocity_z );
	
	new Float: vehicle_speed = ( ( velocity_x * velocity_x + velocity_y * velocity_y + velocity_z * velocity_z ) * 195.0 );
	if( vehicle_speed < 15.0 ) {
		GetVehicleZAngle( vehicleid, saved_angle[ playerid ] );
		GetVehicleHealth( vehicleid, saved_health[ playerid ] );
	    return ;
	}
	
	new Float: vehicle_angle;
	GetVehicleZAngle( vehicleid, vehicle_angle );
	
	new Float: vehicle_health;
	GetVehicleHealth( vehicleid, vehicle_health );
	
	if( vehicle_health < saved_health[ playerid ] ) 
	{
		if driftPoints[playerid] > driftPointsTotal[playerid] *then
		{
			driftPointsTotal[playerid] = driftPoints[playerid];
			UpdateDriftPointsTotal(playerid);
		}
		saved_angle[ playerid ] = vehicle_angle;
		saved_health[ playerid ] = vehicle_health;
		if( driftPoints[ playerid ] > 0 ) driftPoints[ playerid ] = 0;
		if( driftWaiting[ playerid ] > 0 ) driftWaiting[ playerid ] = 0;
		return ;
	}
	
	new Float: calculate = floatabs( saved_angle[ playerid ] - vehicle_angle );
	
	if( 1.5 < calculate < 180.0 ){
	    driftPoints[ playerid ] += floatround( calculate );
	    UpdateDriftPointsDisplay(playerid);

        driftWaiting[playerid] = Global_Time;
		driftTime[playerid]++;
        if (driftTime[playerid] >= 40) { 
            tireWear[playerid] += 0.1; 
            driftTime[playerid] = 0; 
			UpdateDriftWear(playerid);
        }

	}
	
	saved_angle[ playerid ] = vehicle_angle;
	saved_health[ playerid ] = vehicle_health;
}

stock ConvertUTF8ToWindows1251(const string[])
{
    new string_convert[144];

    for(new i, buff_symb, buff_idx; i < strlen(string); i++)
    {
        switch(string[i])
        {
            case 'Р':
            {
                buff_symb = string[i+1];
                if(buff_symb == 101)  string_convert[buff_idx++] = 'Ё', i++;
                else if(144 <= buff_symb <= 191) string_convert[buff_idx++] = buff_symb+48, i++;
                else continue;
            }
            case 'С':
            {
                buff_symb = string[i+1];
                if(buff_symb == 145) string_convert[buff_idx++] = 'ё', i++;
                else if(128 <= buff_symb <= 143) string_convert[buff_idx++] = buff_symb+112, i++;
                else continue;
            }
            default: string_convert[buff_idx++] = string[i];
        }
    }
    return string_convert;
}

