		executeEvent(playerid, 0, (str_f("vue.call(`donate/updatePlayer`,{donate:%d});", PI[playerid][pVirMoney])));
		cursorPlayer(playerid, 0, true), dialog_player[playerid][D_Custom] = 1;
		executeEvent(playerid, 0, "vue.call(`donate/updateStaticItems`, {[-1]:{price:18000,itemId:1},[-2]:{price:2,itemId:1}});");
	}
	else
	{
