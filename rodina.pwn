	f(global_str, sizeof(global_str), "Стоимость: {97FC9A}%d %s.{FFFFFF}\nВы желаете купить данный товар?", ShowTypeOpen[playerid] > 3 ? BizData[BizEntered[playerid]][bItem][slot_id] : ShopInfo[ShowTypeOpen[playerid]][sPrice][slot_id], ShowTypeOpen[playerid] > 3 ? "руб" : "BTC");
	
	SPD(playerid, 24638, DIALOG_STYLE_MSGBOX, (str_f("{FFFFFF}Предмет: {FDCF28}%s{FFFFFF}", ItemsInfo[ShopInfo[ShowTypeOpen[playerid]][sItem][slot_id]][itemName])), global_str, "Да", "Нет");

}


stock playerFreeRoulette(playerid)
{	
	executeEvent(playerid, 0, "window.executeEvent('event.roulette.stopRoll', '[ null ]');");
	
	executeEvent(playerid, 0, "window.executeEvent('event.setActiveView', `[\"Roulette\"]`);");
	
	hidePlayerHud(playerid);
	
	executeEvent(playerid, 0, (str_f("window.executeEvent('event.roulette.initializeMainInfo', `[{\"countMoney\":0,\"countDonate\":%d}]`);", PI[playerid][pVirMoney])));
	executeEvent(playerid, 0, (str_f("window.executeEvent('event.roulette.initializeRouletteBoxes', `[[{\"total\":%d,\"price\":0, \"discount\":0 },{\"total\":%d,\"price\":0, \"discount\":0, \"description\": \"\" }]]`);", GetCount(playerid, 7352), GetCount(playerid, 7352))));
	
	for(new i, roulette_prize[4] = {2000, 4000, 8000, 20000}, rarity_status[4][12] = {"aqua", "pink", "purple", "red"}; i < 4; i++)
	{
		global_str[0] = EOS;
		f(global_str, sizeof(global_str), "{\"id\":%d,\"title\":\"%d шт AZ\",\"rarity\":\"%s\",\"price\":1,\"image\":233}", i, roulette_prize[i], rarity_status[i]);
		executeEvent(playerid, 0, (str_f("window.executeEvent('event.roulette.initializeRoulettePrizePool', `[[ %s]]`);", global_str)));
	}
	
	executeEvent(playerid, 0, "window.executeEvent('event.roulette.prizePoolComplite', '[ null ]');");
	cursorPlayer(playerid, 0, true);
	
	return true;
}


stock startProgressBar(playerid, type_id)
{
	PI[playerid][pProgressBar][0] = true;
	PI[playerid][pProgressBar][1] = 0;
	PI[playerid][pProgressBar][2] = type_id;

	switch(GetPlayerLauncher(playerid))
	{
		case 1:
		{
			executeEvent(playerid, 0, "window.executeEvent('cef.modals.showModal', `[\"progressBar\"]`);");
			executeEvent(playerid, 0, "window.executeEvent('event.progressBar.updateType', `[{\"click\":1}]`);");
			executeEvent(playerid, 0, "window.executeEvent('event.progressBar.canCancel', `[{\"canCancel\":1}]`);");
			executeEvent(playerid, 0, "window.executeEvent('event.progressBar.updateProgress', `[{\"progress\":0}]`);");
			executeEvent(playerid, 0, "window.executeEvent('event.progressBar.updateText', `[{\"text\":\"Используйте левую\nклавишу мыши\"}]`);");
				
		}
		case 2:
		{
			eventMobile(playerid, {25, 0}, "{\"progress\":0,\"text\":\"Для взаимодействия быстро нажимайте на палец\"}");
			cursorPlayer(playerid, 25, true);	
		}
	}


	if(GetPlayerLauncher(playerid) != 2)
		PI[playerid][pProgressBar][3] = SetTimerEx("progressBarSend", 2000, true, "d", playerid);


	return true;

}

public: progressBarSend(playerid)
{

	PI[playerid][pProgressBar][1] = PI[playerid][pProgressBar][1]-5;

	if(PI[playerid][pProgressBar][1] < 0)
		PI[playerid][pProgressBar][1] = 0;

	if(GetPlayerLauncher(playerid) != 2)
		executeEvent(playerid, 0, (str_f("window.executeEvent('event.progressBar.updateProgress', `[{\"progress\":%d}]`);", PI[playerid][pProgressBar][1])));
	
	else 
		eventMobile(playerid, {25, 0}, (str_f("{\"progress\":%d,\"text\":\"Для взаимодействия быстро нажимайте на палец\"}", PI[playerid][pProgressBar][1])));



	if(!PI[playerid][pProgressBar][1])
	{
		for(new i; i < 3; i++)
			PI[playerid][pProgressBar][i] = 0;
		
		if(GetPlayerLauncher(playerid) != 2)
			executeEvent(playerid, 0, "window.executeEvent('cef.modals.closeModal', `[\"progressBar\"]`);");
		
		else
			cursorPlayer(playerid, 25, false); 


		TogglePlayerControllable(playerid, Controllable{playerid} = true);

		if(GetPlayerLauncher(playerid) != 2)
			KillTimer(PI[playerid][pProgressBar][3]);
		
		ClearAnimations(playerid);
	}
	return true;
	
}

stock progressBarEnd(playerid)
{
	new id_action = pTemp[playerid][tActId];
	switch(PI[playerid][pProgressBar][2])
	{
		// Хлопок
		case 0:
		{
			if(!CottonInfo[id_action][cottonStatus])
				return PI[playerid][pProgressBar][1] = 0, progressBarSend(playerid);
			
			CottonInfo[id_action][cottonScore] --;
			CallTimeOutFunction("ProgressFerma", 0, false, "i", playerid);
			
			UpdateDynamic3DTextLabelText(CottonInfo[id_action][cottonLabel], -1, (str_f("Хлопок (%d из 10)\n{73B461}Для сбора урожая", CottonInfo[id_action][cottonScore])));
			if(!CottonInfo[id_action][cottonScore])
			{
				CottonInfo[id_action][cottonStatus] = false;
				CottonInfo[id_action][cottonSecund] = 180;
				DestroyDynamic3DTextLabel(CottonInfo[id_action][cottonLabel]);
				DestroyDynamicObject(CottonInfo[id_action][cottonObject]);
				return 1;
			}
		}
		// Лён
		case 1:
		{
			if(LinenInfo[id_action][linenStatus] == false)
				return PI[playerid][pProgressBar][1] = 0, progressBarSend(playerid);

			LinenInfo[id_action][linenScore] --;

			CallTimeOutFunction("ProgressFerma", 0, false, "i", playerid);
				
	        UpdateDynamic3DTextLabelText(LinenInfo[id_action][linenLabel], -1, (str_f("Лён (%d из 10)\n{73B461}Для сбора урожая", LinenInfo[id_action][linenScore])));

	        if(!LinenInfo[id_action][linenScore])
	        {
				LinenInfo[id_action][linenStatus] = false;
		        LinenInfo[id_action][linenSecund] = 180;
		        DestroyDynamic3DTextLabel(LinenInfo[id_action][linenLabel]);
		        DestroyDynamicObject(LinenInfo[id_action][linenObject]);
		        return 1;
			}
		}
		// Шахта
		case 2: 
		{
			if(MineInfo[id_action][mineStatus] == false)
				return 1;
			
			ProgressWaxta(playerid, id_action);
		}
	}
	for(new i; i < 3; i++)
		PI[playerid][pProgressBar][i] = 0;
	
	ClearAnimations(playerid);
	
	if(GetPlayerLauncher(playerid) != 2)
		executeEvent(playerid, 0, "window.executeEvent('cef.modals.closeModal', `[\"progressBar\"]`);"),
		KillTimer(PI[playerid][pProgressBar][3]);

	else
		cursorPlayer(playerid, 25, false);

	return true;

} 
stock sendInventoryTradeItems(playerid, targetid)
{
  global_str = "";
  for(new i; i < 20; i++) 
  {
    new type = 0, sendText[30];
    
    
	f(global_str, sizeof(global_str), "%s{\"slot\":%i%s}%s", global_str, i > 9 ? i-10:i, TradeInfo[i > 9 ? targetid : playerid][tradeItem][i > 9 ? i-10:i] == -1 ? "" : (str_f(",\"item\":%i,\"amount\":%i,\"text\":\"%s\",\"available\":1,\"enchant\":%i,\"time\":0,\"background\":%d", Inventory[i > 9 ? targetid : playerid][0][TradeInfo[i > 9 ? targetid : playerid][tradeItem][i > 9 ? i-10:i]], Inventory[i > 9 ? targetid : playerid][1][TradeInfo[i > 9 ? targetid : playerid][tradeItem][i > 9 ? i-10:i]], !type ? "":sendText, Inventory[i > 9 ? targetid : playerid][2][TradeInfo[i > 9 ? targetid : playerid][tradeItem][i > 9 ? i-10:i]], ItemsInfo[Inventory[i > 9 ? targetid : playerid][0][TradeInfo[i > 9 ? targetid : playerid][tradeItem][i > 9 ? i-10:i]]][itemColor])), (i == 9 || i == 19) ? ("") : (","));  
   
    if(i == 9 || i == 19) 
	{
      if(GetPlayerLauncher(playerid) == 1) executeEvent(playerid, 0, (str_f("window.executeEvent('event.inventory.playerInventory', `[{\"action\":2,\"data\":{\"type\":%i,\"items\":[%s]}}]`);", i == 9 ? 7:8, global_str)));
      else eventMobile(playerid, {57, 2}, (str_f("{\"type\":%i,\"items\":[%s]}", i == 9 ? 7:8, global_str)));
      global_str = "";
    }
  }
  switch(GetPlayerLauncher(playerid))
  {
    case 1:
      hidePlayerHud(playerid),
	  executeEvent(playerid, 0, (str_f("window.executeEvent('event.inventory.playerInventory', `[{\"action\":6,\"data\":{\"self\":{\"value\":%i,\"type\":%i},\"target\":{\"value\":%i,\"type\":%i}}}]`);", GetDataTrade(playerid, tradeSEND),GetDataTrade(playerid, tradeSendId),GetDataTrade(targetid, tradeSEND),GetDataTrade(targetid, tradeSendId)))),
      executeEvent(playerid, 0, "window.executeEvent('event.inventory.setTradeVisible', `[true]`);");

    case 2: eventMobile(playerid, {57, 6}, (str_f("{\"self\":{\"value\":%i,\"type\":%i},\"target\":{\"value\":%i,\"type\":%i}}", GetDataTrade(playerid, tradeSEND),GetDataTrade(playerid, tradeSendId),GetDataTrade(targetid, tradeSEND),GetDataTrade(targetid, tradeSendId))));
  }
  
  cursorPlayer(playerid, GetPlayerLauncher(playerid) == 1 ? 1:57, true), dialog_player[playerid][D_Custom] = 1;
  return true;
}



stock sendInventoryTrade(playerid, i, type)
{
	SCMF(playerid, -1, "sendInventoryTrade [%d | %d]", i, type);
	
	switch(type)
	{
		case 0:
		{
			if !IsPlayerOnline(GetDataTrade(playerid, tradePlayer)) or GetDataTrade(GetDataTrade(playerid, tradePlayer), tradeAccept) or GetDataTrade(playerid, tradeAccept) *then 
			return false;

			new slot = TradeInfo[playerid][tradeItem][i];

			if(slot == -1) 
				return false;

			InventSlotUse[playerid][slot] = false;

			TradeInfo[playerid][tradeItem][i] = TradeInfo[playerid][tradeItemCount][i] = -1;
			
			for new k; k < 2; k++ do
			{
				if k *then
					playerid = GetDataTrade(playerid, tradePlayer);

				sendInventoryTradeUpdate(playerid, i, GetDataTrade(playerid, tradePlayer), k+1);
			}

			return true;
		}
		
		case 1:
		{
			new j =  i;

			if(InventSlotUse[playerid][j] || !Inventory[playerid][0][j] || !Inventory[playerid][1][j]) return false;
			else if(ArendaInfo_INT[playerid][0][j] || !ItemsInfo[Inventory[playerid][0][j]][itemTradeable]) return SCM(playerid,COLOR_RED,"[Ошибка] {ffffff}Данный предмет нельзя передать!");
			else if(!IsPlayerOnline(GetDataTrade(playerid, tradePlayer)) or GetDataTrade(GetDataTrade(playerid, tradePlayer), tradeAccept) or GetDataTrade(playerid, tradeAccept)) return false;

			if(Inventory[playerid][1][j] == 1) 
			{
				for new idx; idx < 10; idx ++ do 
				{
					if(TradeInfo[playerid][tradeItem][idx] == -1) 
					{
						TradeInfo[playerid][tradeItem][idx] = j;
						TradeInfo[playerid][tradeItemCount][idx] = 1;
						InventSlotUse[playerid][j] = true;
						InventSlotUpdate(playerid, i, j);
											
						for new k; k < 2; k++ do
						{
							if k *then
								playerid = GetDataTrade(playerid, tradePlayer);

							sendInventoryTradeUpdate(playerid, idx, GetDataTrade(playerid, tradePlayer), k+1);
						}
						break;
					}
				}
			}
			else PickInvent[playerid] = j, PickInventSlot[playerid] = i, SPD(playerid, 8249, DIALOG_STYLE_INPUT, "Торговля", "{FFFFFF}Введите количество, которое хотите передать", "Выбрать", "Отмена");
		}
	}
	return true;	
}
stock sendInventoryTradeUpdate(playerid, i, targetid, type)
{
  new sendType = 0, sendText[30];
  
  if(TradeInfo[type == 2 ? targetid : playerid][tradeItem][i] != -1) 
  	sendType = 0;
  
  global_str = "", f(global_str, sizeof(global_str), "{\"slot\":%i%s}", i, TradeInfo[type == 2 ? targetid : playerid][tradeItem][i] == -1 ? "" : (str_f(",\"item\":%i,\"amount\":%i,\"text\":\"%s\",\"available\":1,\"enchant\":%i,\"time\":0,\"background\":%d", Inventory[type == 2 ? targetid : playerid][0][TradeInfo[type == 2 ? targetid : playerid][tradeItem][i]], Inventory[type == 2 ? targetid : playerid][1][TradeInfo[type == 2 ? targetid : playerid][tradeItem][i]], !sendType ? "":sendText, Inventory[type == 2 ? targetid : playerid][2][TradeInfo[type == 2 ? targetid : playerid][tradeItem][i]], ItemsInfo[Inventory[type == 2 ? targetid : playerid][0][TradeInfo[type == 2 ? targetid : playerid][tradeItem][i]]][itemColor])));
  switch(GetPlayerLauncher(playerid))
	{
    case 1: executeEvent(playerid, 0, (str_f("window.executeEvent('event.inventory.playerInventory', `[{\"action\":2,\"data\":{\"type\":%i,\"items\":[%s]}}]`);", type == 2 ? 8:7, global_str)));
    case 2: eventMobile(playerid, {57, 2}, (str_f("{\"type\":%i,\"items\":[%s]}", type == 2 ? 8:7, global_str)));
  }
  return true;
}

