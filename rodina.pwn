	SPD(playerid, 4460, DIALOG_STYLE_LIST, global_str, "Настройка\nСтатистика\nЗапустить/отключить", "Выбрать", "Закрыть");
	return 1;
}
stock GetTickDiff(newtick, oldtick)
{
	if(ServerSetting[1] == false) return false;
	if(oldtick >= 0 && newtick < 0 || oldtick > newtick) return ((cellmax - oldtick + 1) - (cellmin - newtick));
	return (newtick - oldtick);
}
stock DeleteBot()
{
	new id = Iter_Random(IsPlayerBot);
	if(Iter_Contains(Player, id) == 1) Kick(id);
}
