cmd:anim(playerid, params[])
{
    new id;

    if(sscanf(params, "d", id))
        return SCM(playerid, COLOR_OLDRED, "/anim (1-44)");

    if(id < 1 || id > 44)
        return SCM(playerid, COLOR_RED, "(ERROR) 1-44");

    ApplyAnimation(playerid, gIdleLib[id - 1], gIdleAnim[id - 1], 4.1, true, 1, 1, 1, 0, 1);
    return 1;
}
