stock LoadPlayerAttention()
{
	for(new i;i < sizeof(PochtaPos);i ++)
		PochtaZone[i] = CreateDynamicSphere(PochtaPos[i][hPos_X], PochtaPos[i][hPos_Y], PochtaPos[i][hPos_Z], 3.0 -1, -1, -1);

	AutoSchoolZone = CreateDynamicSphere(-71.5413, 2.8989, 2302.0000, 3.0, 0, 40, -1);
	
	for(new i; i < sizeof(DynamicInfo); i++)
		DynamicInfoZone[i] = CreateDynamicSphere(DynamicInfo[i][DynamicPos][0], DynamicInfo[i][DynamicPos][1], DynamicInfo[i][DynamicPos][2], 3.0, -1, -1);
	
	for(new i; i < sizeof(LinenInfo); i++)
		DynamicLen[i] = CreateDynamicSphere(LinenInfo[i][linenPosX], LinenInfo[i][linenPosY], LinenInfo[i][linenPosZ], 3.0, -1, -1);

	for(new i; i < sizeof(CottonInfo); i++)
		DynamicCotton[i] = CreateDynamicSphere(CottonInfo[i][cottonPosX], CottonInfo[i][cottonPosY], CottonInfo[i][cottonPosZ], 3.0, -1, -1);

	for(new i; i < sizeof(MineInfo); i++)
		DynamicMine[i] = CreateDynamicSphere(MineInfo[i][minePosX], MineInfo[i][minePosY], MineInfo[i][minePosZ], 3.0, -1, -1);

	return 1;
}

stock NextStapQI(playerid,id)
{
	switch(id)
	{
		case 0:
		{
	        if IsValidPassport(playerid) *then
	        	SPD(playerid, 0, 0, "", "{FFFFFF}У вас уже есть регистрация! Задание было выполнено, получите награду.", "Принять", ""), QuestProgress[playerid][id] = 1;


			else if !QuestProgress[playerid][id] *then
				SCM(playerid,COLOR_GREEN, "[Подсказка] {FFFFFF}На миникарте установлена метка на местоположение мэрии, направляйтесь туда"), SCM(playerid,-1, "чтобы получить регистрацию.");
		}
		case 1:
		{
			if !QuestProgress[playerid][id] *then
				SCM(playerid, COLOR_GREEN, "[Подсказка] {FFFFFF}На миникарте установлена метка на местоположение почтового отделения, направляйтесь туда"), SCM(playerid, -1, "и перенесите 15 коробок с почтой. Необходимо устроиться почтальоном");
		}
		case 2:
		{
	        if GetPlayerLicense(playerid, 0) *then
	        	SPD(playerid, 0, 0,"", "{FFFFFF}У вас уже есть вод. удостоверение! Задание было выполнено, получите награду.", "Принять", ""), QuestProgress[playerid][id] = 1;

            else if !QuestProgress[playerid][id] *then
	        	SCM(playerid, COLOR_GREEN, "[Подсказка] {FFFFFF}На миникарте установлена метка на местоположение автошколы, направляйтесь туда,"), SCM(playerid, -1, "сдайте теорию, практику и получите вод. удостоверение.");
		}
		case 3:
		{
			if !QuestProgress[playerid][id] *then
				SCM(playerid, COLOR_GREEN, "[Подсказка] {FFFFFF}На миникарте установлена метка на местоположение фермы, направляйтесь туда"), SCM(playerid, -1, "и соберите 20 органических ресурсов.");
		}
		case 4:
		{
			if !QuestProgress[playerid][id] *then
				SCM(playerid, COLOR_GREEN, "[Подсказка] {FFFFFF}Для выполнения задания вам нужно приобрести любую жилую недвижимость в округе.");
		}
		case 5:
		{
			if !QuestProgress[playerid][id] *then
				SCM(playerid, COLOR_GREEN, "[Подсказка] {FFFFFF}На миникарте установлена метка на местоположение автосалона, направляйтесь туда"), SCM(playerid, -1, "и приобретите любой автомобиль.");
		}
	}

	if(QuestProgress[playerid][id] == QI[id][LastProgress])
	{
		SCM(playerid, COLOR_GREEN, "[Подсказка] {FFFFFF}На миникарте установлена метка на место сдачи квеста.");
		SCM(playerid, -1, "Отправляйтесь туда чтобы получить награду за выполненое задание.");
		EnableGPSForPlayer(playerid,813.5323, 1534.7665, 13.2002);
	}
	else if(id != 4) EnableGPSForPlayer(playerid, QI[id][Pos_Quest][0], QI[id][Pos_Quest][1], QI[id][Pos_Quest][2]);


	return SQL("UPDATE questsprogress SET `progress` = %d WHERE `idquest` = '%d' AND `player_id` = '%d'; ", QuestProgress[playerid][id], id, PI[playerid][pID] );
}

stock DialogNPCQuest(playerid, id, open = false)
{	//31
	switch(GetPlayerLauncher(playerid))
	{
		case 1:
		{
			if open *then 
				executeEvent(playerid, 0, "window.executeEvent('event.setActiveView', '[ null ]');");

			hidePlayerHud(playerid);
			
			executeEvent(playerid, 0, "window.executeEvent('event.setActiveView', `[\"NpcDialog\"]`);");

			executeEvent(playerid, 0, (str_f("window.executeEvent('event.npcDialog.initializeDialog', `\
				[\
					{\"id\":%d,\"title\":\"%s\",\"npcName\":\"Пивозавр\",\"text\":\"%s\",\
					\"backgroundColor\":\"rgba(19, 21, 22, 0.65)\",\"hoverColor\":\"rgba(19, 21, 22, 0.55)\",\"keyboard\": [[ {\"id\":0,\"icon\":\"&#128526;\",\
					\"text\":\"%s\"} ]] }\
				]`);", id, QI[id+7][QuestName], QI[id+7][QuestText], QI[id+7][button_1])));

			cursorPlayer(playerid, 0, true), dialog_player[playerid][D_Custom] = 1;
		}
		case 2:
		{
			cursorPlayer(playerid, 15, true);

			eventMobile(playerid, {15, 0}, (str_f("{\"questName\":\"%s\",\"npcName\":\"Пивозавр\",\"npcText\":\"%s\",\"answers\":[{\"emoji\":\"\",\"text\":\"%s\"}]}", QI[id+31][QuestName], QI[id+31][QuestText], QI[id+31][button_1])));
		}
	}
	return true;

}

public: LoadQuestMysql(playerid)
{
	new maxt = cache_num_rows();
	for(new i; i< maxt; i++)
	{
		new idquest;
		cache_get_value_name_int(i, "idquest", idquest);
		cache_get_value_name_int(i, "progress", QuestProgress[playerid][idquest]);
		cache_get_value_name_int(i, "accept", AcceptQuest[playerid][idquest]);
	}
	return 1;
}

public: QuestRegisterTimer(playerid)
{
	new Float:xx, Float:yy, Float:zz;
	GetPlayerCameraPos(playerid, xx, yy, zz);

	TogglePlayerControllable(playerid,0);

	InterpolateCameraPos(playerid, xx, yy, zz, 817.9406, 1535.6702, 12.7002, 2000, CAMERA_MOVE);
	InterpolateCameraLookAt(playerid, 813.5323, 1534.7665, 17.0002, 813.5323, 1534.7665, 12.0002, 2000, CAMERA_MOVE);

	LoginQuest[playerid][0] = 2;

	return DialogNPCQuest(playerid, 0);
}

CMD:quest(playerid)
{
	global_str = "";
	new num;

	if(GetPlayerLauncher(playerid) == 1)
	{
		hidePlayerHud(playerid);
		executeEvent(playerid, 0, "window.executeEvent('event.setActiveView', `[\"Quests\"]`);");

		for(new i;i<7;i++)
		{
			if(AcceptQuest[playerid][i]!=0 && QuestProgress[playerid][i]!=100)
			{
				QuestShow[playerid][num]=i;
				num++;
			}
		} //19..25

		for new i;i < 7; i++ do
		{
			if(AcceptQuest[playerid][i] != 0)
			{
				global_str = "";

				format(global_str, sizeof(global_str),"{\"id\":%d,\"storyId\":0,\"title\":\"%s\",\"hasReward\":%d,\"progress\":%d,\"maxProgress\":%d,\"textProgress\":\"%s\",\"image\": \"0%d.png\",\"icon\":-1,\"rewards\":[{\"title\":\"BTC (1000 ед.)\",\"icon\":\"money.png\"},{\"title\":\"Очки опыта (500 ед.)\",\"icon\":\"exp.png\"}]}", i, QI[i+17][QuestName], (QuestProgress[playerid][i]==QI[i][LastProgress] || QuestProgress[playerid][i]==100) ? 1:0, QuestProgress[playerid][i]==100 ? QI[i][LastProgress]:QuestProgress[playerid][i], QI[i][LastProgress], QI[i+17][QuestText], QI[i+17][LastProgress]);
				
				executeEvent(playerid, 0, (str_f("window.executeEvent('event.quests.push', '[[%s]]');", global_str)));
			}
		}
	}
	else
	{
		for new i;i < MAX_QUESTS; i++ do
		{
			if AcceptQuest[playerid][i] != 0 && QuestProgress[playerid][i] != 100 *then
			{
				if(QuestProgress[playerid][i]<QI[i][LastProgress])
					f(global_str, sizeof(global_str),"%s\n{FFFFFF}%s | {DA9815}Прогресс: %d/%d", global_str, QI[i][QuestName], QuestProgress[playerid][i],QI[i][LastProgress]);
				else if(QuestProgress[playerid][i] == 100) f(global_str, sizeof(global_str), "%s\n{FFFFFF}%s | {E81818}[Выполнен]", global_str, QI[i][QuestName]);
				else f(global_str, sizeof(global_str), "%s\n{FFFFFF}%s | {DA9815}Прогресс: {DA9E30}[Можно завершить]", global_str, QI[i][QuestName]);
				QuestShow[playerid][num]=i;
				num++;
			}
		}
	}

	if(GetPlayerLauncher(playerid) == 1) cursorPlayer(playerid, 0, true), dialog_player[playerid][D_Custom] = 1, pTemp[playerid][pBrowserOpen][5] = true;
	else
	{
		if(strlen(global_str) > 0)
			SPD(playerid, 7650, 2, "", global_str, "Info", "Отмена");
		else
			SPD(playerid, 0, 0, "", "{FFFFFF}У вас нет принятых квестов!", "Принять", "");
	}
	return true;
}


