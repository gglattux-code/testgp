stock ShowDrift(playerid, open, vehicleid = 0)
{
	new BitStream:bs = BS_New();

	switch(open)
	{
		case 0:
		{
			new DriftRemove[] = {19476, 19478, 19476, 19478, 19476, 19476, 19476, 19476, 19476, 19476, 19476, 18728, 18728, 18728, 18728};

			for new i; i < sizeof(DriftRemove); i++ do
				DestroyDynamicObjectModel(vehicleid, DriftObjects[vehicleid][i], DriftRemove[i]);

			driftPoints[playerid] = driftPointsTotal[playerid] = driftWaiting[playerid] = driftTime[playerid] = PlayerDrift[playerid] = 0;
			tireWear[playerid] = 0.0;

			KillTimer(d_timer[playerid]);

			BS_WriteValue(bs,
				PR_UINT8, 220,
				PR_UINT8, 187, 
				PR_UINT16, vehicleid, 
				PR_BOOL, false);

			PR_SendPacket(bs, playerid), BS_Delete(bs);
		}
		case 1:
		{
			DriftObjects[vehicleid][0] = CreateDynamicObject(19476, 0.000000, 0.000000, -1000.000000, 0.000000, 0.000000, 0.000000, 0, 0, playerid, STREAMER_OBJECT_SD, 50.0); // 1
			SetDynamicObjectMaterialText(DriftObjects[vehicleid][0], 0, "&", 120, "Webdings", 100, 0, 0xFFCD5C5C, 0, 1);
			AttachDynamicObjectToVehicle(DriftObjects[vehicleid][0], vehicleid, 1.247000, -2.455000, 0.315000, 0.000000, 0.000000, 90.000000);

			DriftObjects[vehicleid][1] = CreateDynamicObject(19478, 0.000000, 0.000000, -1000.000000, 0.000000, 0.000000, 0.000000, 0, 0, playerid, STREAMER_OBJECT_SD, 50.0); // 0
			SetDynamicObjectMaterialText(DriftObjects[vehicleid][1], 0, "", 169, " cj_binc_s", 105, 103, 0x49420c6e, 1885291342, 115);
			AttachDynamicObjectToVehicle(DriftObjects[vehicleid][1], vehicleid, 1.250000, -2.450000, 0.320000, 0.000000, 0.000000, -90.000000);

			DriftObjects[vehicleid][2] = CreateDynamicObject(19476, 0.000000, 0.000000, -1000.000000, 0.000000, 0.000000, 0.000000, 0, 0, playerid, STREAMER_OBJECT_SD, 50.0); // 0
