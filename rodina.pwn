new ItemStory[][itemsStory_data] = 
{
    /* 0 */ {0, 0xffff00, "\n{ffffff}Можно получить в течении игры на сервере{FFFFFF}.\nНельзя продать, выкинуть, {FDCF28}обменять{FFFFFF}."},
    /* 1 */ {3, 0xFDCF28, "{ffffff}Аксессуар доступен только играя с лаунчера RODINA GAMES или RODINA MOBILE!\n"},
    /* 2 */ {0, 0xFDCF28, "\n{ffffff}Номерной знак: {FFFF00}%s{ffffff}\nСтрана: {FFFF00}%s{ffffff}\nРегион: {FFFF00}%s{ffffff}\n\nИспользуется для установки номерного знака на личный транспорт.\nМожно получить в {ff6666}полицейском участке Los Santos{ffffff}.\n\nПодробнее о номерах: {FF6666}/help — Ограничение за езду без номеров{ffffff}.\n\nМожно использовать, передавать и продавать.\n"},
    /* 3 */ {0, 0xFF332C, "{ffffff}Данный предмет используется для замены характеристик аксессуаров.\n\n"},
    /* 4 */ {-1, 0xFDCF28, "{FFFFFF}\nМожно приобрести в магазине одежды,\nцентральном рынке, или с {FDCF28}gold{FFFFFF} рулетки.\n\nИспользуется для изменения внешнего вида персонажа.\nМожно использовать, передавать и продавать."},
    /* 5 */ {1, 0xFF332C, "\n\nМощное технологическое устройство из будущего.\n{ffffff}- Защищает хозяина и делает {FDCF28}неуязвимым {ffffff}на 3 секунды во время перезарядки оружия.\n- Энергетический выброс может вызвать {FDCF28}опьянение {ffffff}с шансом 2 на 3 секунды\nпри попадание по противнику.\n\n{afafaf}\"Исключительная защита в сочетании с изящностью и эффективностью\" - Странник.\n\n{ffffff}Можно получить путем крафта из осколков энергетического щита.\n\nРазрешено передавать, продавать и выкидывать.\n"},
    /* 6 */ {0, 0xffffff, "Используется для модификаций вашего транспорта,\nспособен превратить характеристики вашего ржавого\nкорыта в настоящего жеребца, что не уступит по скорости\nпремиальным маркам спортивных автомобилей.\nМожно передавать и продавать."},
    /* 7 */ {-1, 0xFDCF28, "\n{ffffff}Используется для установки возле своего дома или бизнеса.\n\nМожно приобрести на центральном рынке у игроков\nили получить в качестве приза за открытие уровней боевого\nпропуска сезона {90EE90}Хроники гетто{FFFFFF}.\n\nРазрешено передавать, продавать и выкидывать."},
    /* 8 */ {3, 0xFDCF28, "\n{ffffff}Используется для улучшения внешнего вида\nвашего персонажа, для этого нужно надеть\nаксессуар через инвентарь.\n\nМожно приобрести на центральном рынке у игроков или получить в качестве\nприза за открытие уровней боевого пропуска сезона {90EE90}Хроники гетто{FFFFFF}.\n\nРазрешено передавать, продавать и выкидывать."},
    /* 9 */ {-1, 0xFF332C, "{ffffff}Используется для улучшения внешнего вида\nвашего персонажа, для этого нужно надеть\nаксессуар через инвентарь.\n\n{FFA07A}Имеет уникальные свойства, если надет:{FFFFFF}\n{FFA07A} -{FFFFFF} Автоматическое открытие сундуков с рулетками и тайников в инвентаре;\n{FFA07A} -{FFFFFF} Повышенная зарплата во всех гетто фракциях на 17 процентов.\n\nМожно приобрести на центральном рынке у игроков\nили получить в качестве приза за открытие уровней боевого\nпропуска сезона {90EE90}Хроники гетто{FFFFFF}.\n\nРазрешено передавать, продавать и выкидывать."},
    /* 10 */ {0, 0xFF332C, "{ffffff}Данный предмет используется для замены встроенных {ffff00}желтых характеристик аксессуаров.\n\n"},
    /* 11 */ {1, 0xFF332C, "{FFFFFF}Используется для улучшения внешнего вида вашего персонажа.\nАксессуар можно использовать для установки {FDCF28}личной переносной лавки{FFFFFF}, почти в любом месте.\nНажмите Использовать на предмете в инвентаре.\n\n{cccccc}\"Дерево для неё уговаривали 3 недели...\"{ffffff}\n\n{FFA07A}Имеет уникальные свойства, если надет:{FFFFFF}\n{ffffff} - Максимальная стоимость продажи повышена до 1.5 млрд.\n{ffffff} - Повышенный на 12 процентов депозит.\n{ffffff} - На 2 процента снижены ресурсы в крафте.\n{ffffff} - Аксессуар не ломается.\n\n{FDCF28} -{cccccc} Комиссия при совершении сделки через данный переносной ларек {FDCF28}на 1 меньше.\n\n{FFFFFF}Можно получить: \n- Скрафтить на верстаке.\n- Приобрести на центральном рынке у игроков.\n\nРазрешено передавать, продавать и выкидывать."},
    /* 12 */ {1, 0xFF332C, "{FFFFFF}\n{FF332C}Активный аксессуар. \n{ffffff}При использовании вы получаете {FDCF28}портальную пушку{ffffff},\nс помощью которой вы и другие игроки смогут телепортироваться между\nдвумя установленными точками.\nТочки пропадают после смерти, респавна или выхода из игры.\n\n{E0D3DB}На корпусе выгравирована надпись: \"Морти, верни на место, когда закончишь. Рик C137.\"\n\n{FFFFFF}Использовать можно раз в 30 минут. Максимальное расстояние между входом/выходом 300.0 м.\nВремя жизни порталов 2 минуты.\n\n{ffffff}Можно получить путем крафта из осколков портальной пушки.\nМожно использовать, передавать, продавать и выкидывать."},
    /* 13 */ {1, 0xFF332C, "{FFFFFF}\nИспользуется для улучшения внешнего вида вашего персонажа.\nАксессуар отображается только при использовании брони {C0C0C0}(/armour).\n\n{cccccc}В кармане лежит смятая записка: 'Не забыть - Доставить 1000 списанных бронежилетов Юрию до завтра.'{ffffff}\n\n{FFA07A}Уникальное свойство аксессуара:{FFFFFF} \n{FDCF28} -{FFFFFF} Каждые 30 минут Вы сможете получать на руки 90 патрон оружия {FDCF28}'АК-47 Камуфляжный'{FFFFFF}. \n{C0C0C0}  (Нажмите использовать на предмете в инвентаре).\n{FDCF28} -{FFFFFF} При надетом аксессуаре снижает урон, получаемый от {FDCF28}УЗИ и Снайперской винтовки{FFFFFF}.\n\nВ качестве дополнительных свойств аксессуар дает {FDCF28}эффект восстановления здоровья{FFFFFF} каждые 5 секунд,\nпонижает КД на переодевание до 30 сек., а также автоматически {FDCF28}надевает новый бронежилет{FFFFFF}\nкаждые 30 сек. если у Вас меньше 50 процентов брони.\n\nМожно получить при объединении 10-и {FDCF28}'Осколоков Бронежилета Генерала'{FFFFFF} и 4-х {FDCF28}'Алмазного камня'{FFFFFF}\nчерез инвентарь с шансом в 1 процент или купить на центральном рынке у торговцев.\n\nРазрешено передавать, продавать и выкидывать."},
    /* 14 */ {0, 0xFDCF28, "{FFFFFF}Можно приобрести на {FDCF28}Центральном{FFFFFF} рынке,\nоткрывая \"Ларец рыболова\" или продавая нефтебочки в городе Вайс Сити.\n\n{ff6666}Увеличенный магазин на оружие доступен только играя с лаунчера RODINA GAMES!"},
    /* 15 */ {0, 0xFDCF28, "{FFFFFF}Можно приобрести на {FDCF28}Центральном{FFFFFF} рынке,\nоткрывая любые ларцы или продавая нефтебочки в городе Вайс Сити.\n\nДанный предмет используется для визуального изменения прицела.\n{ff6666}Обновленный прицел на оружие доступен только играя с лаунчера RODINA GAMES!"},
    /* 16 */ {-1, 0xFF332C, "{ffffff}\nАксессуар используется для изменения внешнего вида вашего персонажа,\nа также имеет уникальное свойство: надев данный аксессуар на вашего\nперсонажа каждый {FFA500}часовой (:00) PayDay {FFFFFF}вы будете получать {FAAC58}+2 AZ-Coins\nи с шансом в 50 процентов {FAAC58}+1 Bitcoin{FFFFFF}\n\nМожно получить путем крафта на верстаке или купить у игроков на центральном рынке.\n\nРазрешено передавать, продавать и выкидывать."},
    /* 17 */ {1, 0xFF332C, "{ffffff}\n{FA8072}Лимитированная коллекция{ffffff}\n\nИспользуется для улучшения внешнего вида Вашего персонажа.\nАксессуар можно использовать для установки {FDCF28}личной переносной лавки{FFFFFF}, почти в любом месте.\nНажмите Использовать на предмете в инвентаре.\n\n{FFA07A}Имеет уникальные свойства, если надет:{FFFFFF}\n\n{ffffff} - Максимальная стоимость продажи повышена до 1.5 млрд.\n{ffffff} - Повышеный на 12 процентов депозит.\n{ffffff} - На 2 процента снижены ресурсы в крафте.\n{ffffff} - Аксессуар не ломается.\n\n{FDCF28} -{FA8072} Комиссия при продаже через данный переносной ларек составляет {FDCF28}0 процентов.\n\n{FFFFFF}Можно получить: \n- Приобрести в донат меню, если имеется в наличии.\n- Приобрести на центральном рынке у игроков.\n\nРазрешено передавать, продавать и выкидывать."},
    /* 18 */ {4, 0xFFD700, "{FFFFFF}\n{FA8072}Пасхально-рабочая коллекция{FFFFFF}\n\nМожно получить при объединении {FA8072}5-и осколков{FFFFFF} аксессуара\nчерез инвентарь, либо купить у игроков на центральном рынке.\n\nИспользуется для улучшения внешнего вида\nвашего персонажа, для этого нужно надеть\nаксессуар через инвентарь.\n\n{FFFFFF}Можно надевать, продавать, передавать и выкидывать."},
    /* 19 */ {0, 0xFF332C, "{ffffff}\nПосле использования сертификата вы получите уникальную возможность\nиметь личного охранника, за которым вам будет нужно следить:\nкормить, лечить, прокачивать. Взамен у вас появится новый \nдруг/соратник, который несмотря ни на что встанет на вашу защиту!\n\n{ffffff}— У охранников {AAAAAA}стандартного {ffffff}и {82FA58}необычного {ffffff}качества: {ff6666}1 слот {ffffff}под нераспознанные характеристики;\n— У охранников {25CAFF}редкого {ffffff}качества: {ff6666}2 слота {ffffff}под нераспознанные характеристики;\n— У охранников {D239CC}уникального {ffffff}качества: {ff6666}3 слота {ffffff}под нераспознанные характеристики.\n\n"},
	/* 20 */ {0, 0xFF332C, "{FFFFFF}\nПолучается за выполнение ежедневных заданий для семей.\nИспользуется для обмена на ценные товары у ЖК Ультра и Аксиома({FDCF28}/GPS{FFFFFF})\nМожно приобрести на центральном рынке."},
	/* 21 */ {0, 0xFF332C, "{FFFFFF}\nПредмет который необходим для игры в {FDCF28}кости{FFFFFF}, {FDCF28}дурака{FFFFFF} и\nв {FDCF28}игровые автоматы{FFFFFF}.\nМожно купить в кассе казино {FDCF28}4{FFFFFF} Дракона."},
	/* 22 */ {0, 0xFF332C, "{FFFFFF}\nВыдается при регистрации на сервере. Нельзя продать, выкинуть, {FDCF28}обменять{FFFFFF}.\nМожно открывать каждые 2 часа игры в онлайне. При открытии вы можете получить\nзолотую или серебряную или бронзовую рулетки, которые можно крутить прямо в игре."},
	/* 23 */ {0, 0xFF332C, "{FFFFFF}\nМожно купить на центральном рынке.\nИспользуется для получения {FDCF28}рандомного{FFFFFF} товара\nиз списка доступного в этой рулетке."},
	/* 24 */ {0, 0xFF332C, "{FFFFFF}\nМожно получить с игрового магазина или в награду за достижение 'Отыграть 360 часов'.\n\n{FDCF28}Можно открывать каждые 2 часа игры в онлайне для получения награды.{FFFFFF}\nПри открытии вы можете получить одну из наград:\n{FDCF28}- {FFFFFF}Платиновую рулетку.\n{FDCF28}- {FFFFFF}Золотую рулетку.\n{FDCF28}- {FFFFFF}Серебряную рулетку.\n{FDCF28}- {FFFFFF}Бронзовую рулетку.\n\n{FF6666}Внимание! {FFFFFF}Открывать для получения наград можно не более чем один сундук в инвентаре!\nНельзя выкидывать, продавать и передавать."},
	/* 25 */ {0, 0xFF332C, "{FFFFFF}\nБиткоин - один из видов виртуальной валюты,\nеще его называют 'криптовалютой''.\nЕго можно майнить у себя в подвале дома,\nможно продавать и покупать в банке,\nможно передавать другим через трейд\nрасплачиваясь за какой-то товар.\n\nЧтобы майнить(создавать новые биткоины),\nнеобходимо построить домашний подвал с вентиляцией.\nЗатем купить видеокарты в магазине видеокарт (/gps),\nи установить их в подвале в специальные стойки.\nУ видеокарт есть состояние системы охлаждения,\nне забывайте подливать охлаждающей жидкости,\nиначе она перестанет работать.\n\n{ffffff}Может хранится только в инвентаре (как виртуальная валюта)\nНельзя выкидывать, продавать на центральном рынке,\nкласть в багажник, шкаф дома и т.д."},
	/* 26 */ {0, 0xFF332C, "{FFFFFF}\nМожно получить с {FDCF28}рулетки{FFFFFF}\nПредмет нельзя передать, выкинуть.\nПри использовании даёт +1 AZ Coins."},
	/* 27 */ {0, 0xFF332C, "{FFFFFF}\nМожно получить с {FDCF28}рулетки{FFFFFF}.\nПри использовании даёт +1 EXP."},
	/* 28 */ {0, 0xFF332C, "{FFFFFF}\nМожно приобрести в игровом магазине или\nна центральном рынке. Используется для улучшения ваших \nаксессуаров в мастерской одежды ({FF332C}/GPS - Ближайшая мастерская одежды{FFFFFF})."},
	/* 29 */ {0, 0xFF332C, "{FFFFFF}\nМожно купить в магазине за '{FDCF28}AZCOIN's{FFFFFF}',\nу ЖК за  '{FDCF28}Семейные талоны{FFFFFF}'\nили на центральном рынке.\n\n- Имеет набор стандартных функций телефона.\n- Быстрый доступ: {FDCF28}/phone"},
	/* 30 */ {0, 0xFF332C, "{FFFFFF}\nМожно получить в Центре лицензирования города SF или\nв игровом магазине.\nИмеет срок годности. Нельзя выкинуть\nили передать другому игроку.\nМожно сложить в кошелек (Бумажник)."},
	/* 31 */ {0, 0xFF332C, "{FFFFFF}\nПолучается каждый PAYDAY если вы используете\nлаунчер {FDCF28}RODINA GAMES{FFFFFF}. Скачать можно на\nсайте проекта: {FDCF28}rodina-rp.com{FFFFFF}\nИспользуется для обмена на ценные товары у\nторговца ЭДВАРД у площади Центрального банка."},
	/* 32 */ {0, 0xFF332C, "{FFFFFF}\nМожно купить в любом магазине {FDCF28}24/7{FFFFFF}\nили на центральном рынке.\nМожно продать, выкинуть, {FDCF28}обменять{FFFFFF}."},
	/* 33 */ {0, 0xFF332C, "{FFFFFF}\nМожно приобрести в магазине АЗС\nили на Центральном Рынке.\nМожно продать, выкинуть, {FDCF28}обменять{FFFFFF}.\n({FF332C}/GPS - Ближайшая заправка{FFFFFF})"},
	/* 34 */ {0, 0xFF332C, "{FFFFFF}\nИспользуется для вечеринок, а\nтак-же для восстановления здоровья.\nВ течение 10 минут даёт эффект бесконечного бега, также у Вас не будет уменьшаться сытость.\nКаждую минуту Вы будете восстанавливать +1 HP.\nМожно приобрести в одном из баров\nштата или на центральном рынке."},
	/* 35 */ {0, 0xFF332C, "{FFFFFF}\nМожно приобрести в {FDCF28}Вкусно и точка{FFFFFF} или на {FDCF28}Центральном{FFFFFF} рынке.\nИспользуется для уталения чувства {FDCF28}голода{FFFFFF}.\nВосстанавливает {FDCF28}10{FFFFFF} голода.\n\n{ffffff}Можно использовать на личном охраннике."},
	/* 36 */ {0, 0xFF332C, "{FFFFFF}\nОружие, приобретаемое в любой {FDCF28}амуниции{FFFFFF}.\n{FDCF28}бандитских группировках{FFFFFF} или на {FDCF28}центральном рынке{FFFFFF}.\nМожно использовать.\n\n{ffffff}Можно использовать на личном охраннике."},
	/* 37 */ {0, 0xFF332C, "{FFFFFF}\nМожно приобрести в магазине {FDCF28}Пятёрочка{FFFFFF}\nили на центральном рынке.\nПостепенно восстанавливает {FDCF28}50{FFFFFF}\nпроцентов здоровья. Можно использовать. \nБыстрый доступ: {FDCF28}/usemed\n\n{FDCF28}Данный предмет имеется свойство портиться\n\n{ffffff}Можно использовать на личном охраннике."},
	/* 38 */ {0, 0xFF332C, "{FFFFFF}\nМожно получить при крафте в подвале дома\nили на центральном рынке.\n\nПри объединении {FA8072}5-и осколков{FFFFFF} через инвентарь вы сможете гарантированно\nполучить {FFD700}легендарный предмет."},
	/* 39 */ {0, 0xFF332C, "{FFFFFF}\nМожно приобрести на {FDCF28}Центральном{FFFFFF} рынке или добыть.{FFFFFF})\nИспользуется для изготовления (крафта) {FDCF28}редких товаров{FFFFFF} в\nподвале дома или улучшения {FDCF28}гаража{FFFFFF}."},
	/* 40 */ {0, 0xFF332C, "{FFFFFF}\nМожно получить с {FDCF28}Silver{FFFFFF} и {FDCF28}Gold{FFFFFF} рулеток.\nИспользуется для получения автомобиля.\nНеобходимо находиться на автобазаре ({FDCF28}/GPS{FFFFFF})."},
	/* 41 */ {0, 0xFF332C, "{FFFFFF}\nИспользуется для майнинга криптовалюты,\nв домашнем подвале с вентиляцией.\nЧтобы установить видеокарту, используйте\nеё через инвентарь в домашнем подвале\nс вентиляцией у специальной стойки.\n\nКаждая видеокарта имеет уровень производительности,\nвсего их 10 уровней. Чем выше уровень,\nтем больше биткоинов майнит видеокарта.\n\nМожно купить в магазине видеокарт (/gps)\nили на центральном рынке.\n\nМожно передавать, выкидывать и продавать."},
	/* 42 */ {0, 0xFF332C, "{FFFFFF}\nВыдаётся при выкапывании кладов, так же можно\nкупить на центральном рынке у игроков.\n\nПозволяет узнать, есть ли сейчас клады на сервере, а так же, узнать его местоположение с точностью 20\n\nМожно использовать, передавать, продавать и выкидывать."},
	/* 43 */ {0, 0xFF332C, "{FFFFFF}\nИспользуется для обмена на предметы\nв специальных местах или лавках.{ffffff}\nМожно получить {FF332C}участвуя в мероприятиях\nили купить на центральном рынке.{ffffff}\nМожно передавать и продавать."},
	/* 44 */ {0, 0xFF332C, "{FFFFFF}\nИспользуется для 50 восстановления\nсистемы охлаждения видеокарты.\nЕсли состояние охлаждения видеокарты\nопускается до 0, то работа видеокарты\nостанавливается до её восстановления.\nЧтобы восстановить, нужно залить\nэту жидкость в видеокарту.\n\nМожно скрафтить в домашнем подвале\nили купить на центральном рынке.\n\nМожно передавать, выкидывать и продавать."},
	/* 45 */ {0, 0xFF332C, "{FFFFFF}\nИспользуется для улучшения\nпроизводительности видеокарт.\nЧем выше уровень прозводительности,\nтем больше биткоинов майнит видеокарта.\n\nМожно скрафтить в домашнем подвале\nили купить на центральном рынке.\n\nМожно передавать, выкидывать и продавать."},
	/* 46 */ {0, 0xFF332C, "{FFFFFF}\nМожно приобрести в магазине запчастей, у коллекционеров,\nсобрать в подвале вашего дома или на центральном рынке.\nИспользуется для установки на ваш автомобиль как аксессуар."},
	/* 47 */ {0, 0xFF332C, "{FFFFFF}\nИспользуется для визуальной модификаций вашего\nтранспорта, способен превратить ваше ржавое корыто\nв настоящую порхающую бабочку, что обязательно привлечет\nвнимание прохожих своим уникальным стилем и красотой.\nМожно передавать и продавать."},
	/* 48 */ {0, 0xFF332C, "{FFFFFF}\nМожно получить на мероприятии: '{FDCF28}Собиратели{FFFFFF}',\nа так-же на центральном рынке.\nИспользуется для обмена на \nрандомные товары ({FDCF28}/GPS - Эдвард.{FFFFFF})"},
	/* 49 */ {0, 0xffff00, "{ffffff}\nМожно получить в течении игры на сервере{FFFFFF}\nили купить на центральном рынке.\nМожно продать, выкинуть, {FDCF28}обменять{FFFFFF}."},
	/* 50 */ {1, 0xFF332C, "{ffffff}\n Можно получить с помощью {FDCF28}крафта{FFFFFF}\nили купить у игроков на центральном рынке.\n\nИспользуется на ферме льна и хлопка. (Телефон - GPS - Ресурсы - Ферма)\n\nПри работе на ферме количество кликов в прогресс баре будет уменьшено на {FDCF28}3{FFFFFF},\nа количество добываемых ресурсов увеличивается на {FDCF28}3"}

};

