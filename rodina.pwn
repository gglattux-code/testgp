					AddItem(playerid, HouseInfo[houseid][hItem][id], count, HouseInfo[houseid][hItemColor][id], HouseInfo[houseid][hItemIdentificator][id], HouseInfo[houseid][hItemLevel][id], HouseInfo[houseid][hItemProc][id]);
	
