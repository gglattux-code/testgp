cmd:blackplayers(playerid, params[])
{
    if(IsAtFrakcia(playerid) && PI[playerid][pMember][1])
	{
	    new s;
	    global_str = "";
		foreach(new i: Player)
		{
		    if(PI[i][pBL] != 0)
		    {
                f(global_str, 512, "%s{FFFFFF}%s[%i]{FFFFFF}\n", global_str, PN(i), i);
