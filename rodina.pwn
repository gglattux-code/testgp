stock createBrowser(playerid, browserid, const url[], const key[])
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs, 
		PR_UINT8, 220,
		PR_UINT8, 10, 
		PR_UINT32, pTemp[playerid][cefResolution][0],
		PR_UINT32, pTemp[playerid][cefResolution][1],
		PR_UINT32, 0,
		PR_UINT32, 0,
		PR_UINT16, strlen(url),
		PR_UINT8, 0,
		PR_STRING, url, 
		PR_UINT16, strlen(key),
		PR_UINT8, 0,
		PR_STRING, key, 
		PR_UINT32, browserid 
	);


	return PR_SendPacket(bs, playerid), BS_Delete(bs);
}
stock destroyBrowser(playerid, browserid)
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs, 
		PR_UINT8, 220,
		PR_UINT8, 14,
		PR_UINT32, browserid);

	return PR_SendPacket(bs, playerid), BS_Delete(bs);
}



new glass;
IPacket:220(playerid, BitStream:bs)
{
	new custom, value[4], text[300], bool:toggle;
	BS_ReadValue(bs, PR_IGNORE_BITS, 8, PR_UINT8, custom);

	switch custom do
	{
		case 0:
		{
			BS_ReadValue(bs, PR_UINT8, value[0], PR_IGNORE_BITS, 32);

			switch(value[0]){
				case 73: callcmd::invent(playerid);
				case 80: callcmd::menu(playerid);
				case 66: ShowPlayerBattlePass(playerid);
				case 70: {
					if(pTemp[playerid][tZoneStats]) {
						if(IsPlayerInRangeOfPoint(playerid, 2.0, Treasure_Pos[pTemp[playerid][tCladId]][treasurePos][0], Treasure_Pos[pTemp[playerid][tCladId]][treasurePos][1], Treasure_Pos[pTemp[playerid][tCladId]][treasurePos][2]) && Treasure_Pos[pTemp[playerid][tCladId]][treasureSet]) TreasureFunction(playerid, 3);
						else sendAlert(playerid, 2, "Ошибка", "Здесь нечего копать", 6000);
					}
				}
				case 82:
				{
					if(IsPlayerInAnyVehicle(playerid))
					{
						new carid = GetPlayerVehicleID(playerid), number = GetVehicleID(carid);
						executeEvent(playerid, 0, "window.executeEvent('event.setActiveView', '[\"InteractionMenu\"]');");
						hidePlayerHud(playerid);
						executeEvent(playerid, 0, (str_f("window.executeEvent('event.radialMenu.items', '[[{ \"id\": 0, \"title\": \"%s двигатель\", \"icon\": \"engine_%s\" },{ \"id\": 2, \"title\": \"%s капот\", \"icon\": \"bonnet_%s\" },{ \"id\": 7, \"title\": \"%s стёкла\", \"icon\": \"window_%s\" },{ \"id\": 10, \"title\": \"%s фары\", \"icon\": \"lights\" },{ \"id\": 5, \"title\": \"%s двери\", \"icon\": \"door_%s\" },{ \"id\": 13, \"title\": \"Открыть багажник\", \"icon\": \"close_bag\" }]]');", !GetEngineStatus(carid) ? "Запустить":"Заглушить", !GetEngineStatus(carid) ? "on":"off", bonnet ? "Открыть":"Закрыть", bonnet ? "open":"close", !glass ? "Открыть":"Закрыть", !glass ? "open":"close", !GetLightsStatus(carid) ? "Включить":"Выключить", !CarInfo[number][cLock] ? "Закрыть":"Открыть", !CarInfo[number][cLock] ? "close":"open")));
						cursorPlayer(playerid, 0, true), dialog_player[playerid][D_Custom] = 1;
					}
				}
				case 1:
				{
					if(!PI[playerid][pProgressBar][0])
						return false;

					PI[playerid][pProgressBar][1] += 5;
					if(PI[playerid][pProgressBar][1] > 100)
						PI[playerid][pProgressBar][1] = 100, progressBarEnd(playerid);
						
					executeEvent(playerid, 0, (str_f("window.executeEvent('event.progressBar.updateProgress', `[{\"progress\":%d}]`);", PI[playerid][pProgressBar][1])));
				}
				case 32:
				{
					if(!PI[playerid][pProgressBar][0])
						return false;
					
					return PI[playerid][pProgressBar][1] = 0, progressBarSend(playerid);
				}
			}
			if(playerCasino[playerid][casinoBet]) 
            {
				switch(value[0]) 
                {
					case 162: 
                    {
						playerCasino[playerid][casinoInfo] = !playerCasino[playerid][casinoInfo];
						executeEvent(playerid, 0, (str_f("window.executeEvent('cef.slotsMachine.toggleRulesOpenedStatus', `[%s]`);", playerCasino[playerid][casinoInfo] ? "true":"false")));
					}
					case 160: 
                    {
						if(playerCasino[playerid][casinoStart] || playerCasino[playerid][casinoBet] > GetCount(playerid, 530)) return false;
						playerCasino[playerid][casinoAutoSpin] = !playerCasino[playerid][casinoAutoSpin];
						executeEvent(playerid, 0, (str_f("window.executeEvent('cef.slotsMachine.toggleAutospin', `[%s]`);", playerCasino[playerid][casinoAutoSpin] ? "true":"false")));
						if(playerCasino[playerid][casinoAutoSpin]) sendSpinCasino(playerid);
					}
					case 38,40: 
                    {
						if(playerCasino[playerid][casinoStart] || playerCasino[playerid][casinoFree] || (value[0] == 38 && playerCasino[playerid][casinoBet] > 50000) || (value[0] == 40 && playerCasino[playerid][casinoBet] < 300)) return false;
						playerCasino[playerid][casinoBet] = value[0] == 38 ? playerCasino[playerid][casinoBet]*2:playerCasino[playerid][casinoBet]/2;
						executeEvent(playerid, 0, (str_f("window.executeEvent('cef.slotsMachine.setBetInfo', `[%d,0]`);", playerCasino[playerid][casinoBet])));
					}
					case 32: 
                    {
						if(playerCasino[playerid][casinoStart] || playerCasino[playerid][casinoBet] > GetCount(playerid, 530)) return false;
						if(playerCasino[playerid][casinoFree] > 0) playerCasino[playerid][casinoFree]--, executeEvent(playerid, 0, (str_f("window.executeEvent('cef.slotsMachine.setBetInfo', `[1000,%d]`);", playerCasino[playerid][casinoFree]))); 
						else DeleteItem(playerid, 530, playerCasino[playerid][casinoBet]);
						executeEvent(playerid, 0, "window.executeEvent('cef.slotsMachine.setCanBet', `[false]`);");
						executeEvent(playerid, 0, "window.executeEvent('cef.slotsMachine.startGame', '[ null ]');");
						executeEvent(playerid, 0, (str_f("window.executeEvent('cef.player.updateChipsWallet', `[%d]`);", GetCount(playerid, 530))));
						sendSlotCasino(playerid, playerCasino[playerid][casinoTable]);
					}
					case 86: 
                    {
						playerCasino[playerid][casinoCamera] = playerCasino[playerid][casinoCamera] == 2 ? 1:2;
						executeEvent(playerid, 0, (str_f("window.executeEvent('cef.slotsMachine.setCameraMode', `[\"%s\"]`);", playerCasino[playerid][casinoCamera] == 2 ? "FirstPerson":"ThirdPerson")));
						sendPlayerCamera(playerid, playerCasino[playerid][casinoTable], playerCasino[playerid][casinoCamera]);
					}
					case 13: 
                    {
						cursorPlayer(playerid, 0, false);
						ClearAnimationsEx(playerid);
						SetCameraBehindPlayer(playerid);
						UpdateCasinoStol(playerCasino[playerid][casinoTable], 0);
						InfObjectStulCasik[playerCasino[playerid][casinoTable]][taked] = false;
						playerCasino[playerid][casinoTable] = playerCasino[playerid][casinoCamera] = playerCasino[playerid][casinoAutoSpin] = playerCasino[playerid][casinoBet] = playerCasino[playerid][casinoFree] = playerCasino[playerid][casinoInfo] = playerCasino[playerid][casinoStart] = 0;
					}
				}
			}
		}

		case 1:
		{
			BS_ReadBool(bs, toggle);
			setPlayerCustomIcon(playerid, 0, toggle);
		}

		case 18, 63:
		{
			if(GetPlayerLauncher(playerid) == 2) {
				BS_ReadValue(bs, PR_UINT8, value[0], PR_UINT32, value[1], PR_UINT32, value[2]);
				text = "", BS_ReadValue(bs, PR_UINT16, value[3], PR_STRING, text, value[3]);
			}
			else BS_ReadValue(bs, PR_UINT16, value[3], PR_STRING, text, value[3]);
		
			ShowCefPublic(playerid, text, Int_PackMassive(0, value));
		}

		case 50: 
		{
			BS_ReadValue(bs, PR_UINT32, pTemp[playerid][cefResolution][0], PR_UINT32, pTemp[playerid][cefResolution][1]);		
			
			//createBrowser(playerid, 1, "file:///frontend/svelte_js/index.html", "or7lq8Q8heur");

		}
case RD_ITEMSYNC_ACTION_ID:
{
    return RD_ItemSync_HandlePacket(playerid, bs);
}

		case 24:
		{
			BS_ReadValue(bs, 
				PR_UINT32, value[0], 
				PR_BOOL, toggle);

			pTemp[playerid][cefFocus] = toggle;

			if(!pTemp[playerid][cefFocus])
				HideCef(playerid, value[0]);
		}
	}

	return true;
}


IRPC:116(playerid, BitStream:bs)
{
	new response, index, modelid, boneid, Float:fOffsetX, Float:fOffsetY, Float:fOffsetZ, Float:fRotX, Float:fRotY, Float:fRotZ, Float:fScaleX, Float:fScaleY, Float:fScaleZ;

	BS_ReadValue(bs,
		PR_UINT32, response,
		PR_UINT32, index,
		PR_UINT32, modelid,
		PR_UINT32, boneid,
		PR_FLOAT, fOffsetX,
		PR_FLOAT, fOffsetY,
		PR_FLOAT, fOffsetZ,
		PR_FLOAT, fRotX,
		PR_FLOAT, fRotY,
		PR_FLOAT, fRotZ,
		PR_FLOAT, fScaleX,
		PR_FLOAT, fScaleY,
		PR_FLOAT, fScaleZ);

	return OnPlayerEditAttachedObject(playerid, response, index, modelid, boneid, fOffsetX, fOffsetY, fOffsetZ, fRotX, fRotY, fRotZ, fScaleX, fScaleY, fScaleZ);
}

stock sendPlayerCustom_packet(playerid, ...)
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs, 
		PR_UINT8, 220);

	for(new i = 1; i < numargs(); i++) 
		BS_WriteValue(bs, 
			PR_UINT8, getarg(i));

	return PR_SendPacket(bs, playerid), BS_Delete(bs);
}

stock sendPlayerCustom_rpc(playerid, ...)
{
	new BitStream:bs = BS_New();

	for(new i = 1; i < numargs(); i++) 
		BS_WriteValue(bs, PR_UINT8, getarg(i));

	return PR_SendRPC(bs, playerid, 252);
}

stock hidePlayerHud(playerid)
{
	if(GetPlayerLauncher(playerid) == 1)
		executeEvent(playerid, 0, "window.executeEvent('cef.hud.updateVisibleComponents', JSON.stringify([[]]));");
}

stock showPlayerHud(playerid)
{
	switch GetPlayerLauncher(playerid) do
	{
		case 1:
		{
			if(PI[playerid][pCustomInterface][2])
			{
				switch PI[playerid][pCustomInterface][2] do
				{
					case 1: 
					{ 
						executeEvent(playerid, 0, "window.executeEvent('event.auth.updateVideoBackgroundVisible', `[false]`);");
						sendPlayerCustom_packet(playerid, 9, 2);
						sendPlayerCustom_packet(playerid, 8, 2);
						SendPlayerJsonEvent(playerid);
						executeEvent(playerid, 0, (str_f("window.executeEvent('cef.hud.updateServerInformation', '[{\"title\":\"%s\",\"maxPlayersCount\":%d,\"playerId\":%d,\"multiplier\":%d,\"logoType\":\"autumn\"}]');", Setting_Server[7], GetMaxPlayers(), playerid, XDonate)));
					}
				}
				if(GetPlayerState(playerid) == 2)
					SpeedometrSetting(playerid), SpeedometrSetting(playerid, GetPlayerState(playerid) == 2 ? 1 : 0);
			}

			return true;
		}
		case 2:
		{
			UpdateBrowser(playerid, 8, 3);
			eventMobile(playerid, {8, 1}, "2");
			eventMobile(playerid, {8, 3}, "Получить рулетку");
			eventMobile(playerid, {8, 51}, "");
			eventMobile(playerid, {8, 61}, "{\"token\":\"f8b68b35ea34c1c5ea9047fe75b8d97b\",\"server\":7}");
		}
	}

	return true;
}

stock playerUpdateInterface(playerid, interface_type)
{
/* 0 - dialogs (cef / default), 1 - speed, 2 - hud, 3 - radars, 4 - inventory type [trilogy], 5 - chat type, 6 - dialog save, 7 - dialog type (0,1,2), 8 - hotkey interface*/
	switch interface_type do
	{
		case 1: SpeedometrSetting(playerid, GetPlayerState(playerid) == 2 ? 1 : 0);
		case 2: showPlayerHud(playerid);
		case 3: sendPlayerCustom_packet(playerid, 9, PI[playerid][pCustomInterface][3]);
		case 5: sendPlayerCustom_packet(playerid, 33, PI[playerid][pCustomInterface][6]);
		case 6: sendPlayerCustom_packet(playerid, 39, PI[playerid][pCustomInterface][7]);
		case 8: 
		{
			if(serverInterfaceSettings[0])
				return false;

			sendPlayerCustom_packet(playerid, 53, PI[playerid][pCustomInterface][5]);
		}
		case 9: sendPlayerCustom_packet(playerid, 71, !SettingData[playerid][sdDiscordPosition] ? 0 : 128);
	}

	return true;
}

stock UpdateBrowser(playerid, arg0, arg1, arg2=-1, arg3=-1, arg4=-1, arg5=-1)
{
	new BitStream:bs = BS_New();
	BS_WriteValue(bs, PR_UINT8, 220);
	BS_WriteValue(bs, PR_UINT8, arg0);
	BS_WriteValue(bs, PR_UINT8, arg1);
	if(arg2 != -1) BS_WriteValue(bs, PR_UINT8, arg2);
	if(arg3 != -1) BS_WriteValue(bs, PR_UINT8, arg3);
	if(arg4 != -1) BS_WriteValue(bs, PR_UINT8, arg4);
	if(arg5 != -1) BS_WriteValue(bs, PR_UINT8, arg5);
	PR_SendPacket(bs, playerid);
	return 1;
}

stock HideCef(playerid, browserid)
{
	new interface_id = ActionPlayerDataCef[playerid][actionViewShowedId];

    if(interface_id == E_ACTION_TUNING_STATION && IsPlayerInAnyVehicle(playerid)) {
        TuningStationPlayerExit(playerid);
		ClearPlayerActionCefData(playerid);
	}

	if(g_player_dice_data[playerid][E_PLAYER_DICE_TABLE] != INVALID_DATA_ID)
	{
		new table_id = g_player_dice_data[playerid][E_PLAYER_DICE_TABLE];

		if(g_dice_points[table_id][E_GAME_STARTED] && g_player_dice_data[playerid][E_PLAYER_DICE_STATUS])
			sendAlert(playerid, 2, "Кости", "Вы не можете закрыть интерфейс во время игры", 3500), cursorPlayer(playerid, 0, true);

		else
		{
			executeEvent(playerid, 0, "window.executeEvent('event.setActiveView', '[ null ]');");
			SPD(playerid, 26522, DIALOG_STYLE_MSGBOX, "{FF6666}Кости", "{FF6666}-{ffffff} Вы действительно хотите покинуть стол для игры в кости?", "Закрыть", "Отмена");
		}
	}

	//executeEvent(playerid, 0, "window.executeEvent('event.sideBar.updateVisibility', '[false]');");
	//executeEvent(playerid, 0, "window.executeEvent('cef.modals.closeModal', `[\"dialog\"]`);");
	executeEvent(playerid, 0, "window.executeEvent('cef.modals.closeModal', `[\"securityBanner\"]`);"); //vehicleMenu
	executeEvent(playerid, 0, "window.executeEvent('cef.modals.closeModal', `[\"vehicleMenu\"]`);");
	executeEvent(playerid, 0, "window.executeEvent('event.setActiveView', '[ null ]');");
	executeEvent(playerid, 0, "window.executeEvent('event.auth.updateVideoBackgroundVisible', `[false]`);");
	executeEvent(playerid, 0, "window.executeEvent('cef.toggleServerCursor', `[false,true]`);");

	TestDrivePlayer[playerid][0] = -1;

	SelectCont[playerid] = 0;

	dialog_player[playerid][D_Custom] = 0;

	for new i; i < 6; i++ do
		pTemp[playerid][pBrowserOpen][i] = false;

	if(LoginQuest[playerid][0] > 0)
	{
		SetCameraBehindPlayer(playerid); //NewQuests[playerid][1]
		TogglePlayerControllable(playerid,1);
	}

	tradeopen{playerid} = false;

	if shopopen{playerid} || kioskopen{playerid} *then DestroyShopTD(playerid);

	if(pTemp[playerid][pBrowserOpen][3]) pTemp[playerid][pBrowserOpen][3] = false;

	if(ShowTypeOpen[playerid] == 10) TreasureFunction(playerid, 0);//'event.auth.updateVideoBackgroundVisible'


	if Int_GetPlayerData(playerid, "OtherInventOpen") && PI[playerid][pCustomInterface][4] *then
	{
		DPlayerData(playerid, "OtherInventOpen");
		OtherInventoryDataId[playerid] = -1;
		HideInvent(playerid);
	}

	if(KindFuel[playerid] != -1)
	{
		KindFuel[playerid] = -1;
		CountFuel[playerid] = 0.0;
		SpeedometrSetting(playerid, 1);
	}

	if InventoryOpen{playerid} && PI[playerid][pCustomInterface][4] *then 
		HideInvent(playerid);


	showPlayerHud(playerid);
	/*UpdateBrowser(playerid, 220, 17, 0, 0, 0);
	UpdateBrowser(playerid, 52, 2);
	UpdateBrowser(playerid, 86, 0);
	UpdateBrowser(playerid, 73, 0);*/
	return true;
}
stock cursorPlayer(playerid, browser_id, bool:toggle)
{
	switch(GetPlayerLauncher(playerid))
	{
		case 1: executeEvent(playerid, 0, (str_f("window.executeEvent('cef.toggleServerCursor', `[%s,true]`);", !toggle ? "false" : "true")));
		case 2:
		{
			new BitStream:bs = BS_New();

			BS_WriteValue(bs, \
				PR_UINT8, 220, \
				PR_UINT8, 62, \
				PR_UINT8, browser_id, \
				PR_BOOL, toggle);

			PR_SendPacket(bs, playerid), BS_Delete(bs);
		}
	}
	return (pTemp[playerid][cefFocus] = toggle);
}

stock customCursorPlayer(playerid, browserid, bool:toggle)
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs,
		PR_UINT8, 220,
		PR_UINT8, GetPlayerLauncher(playerid) == 2 ? 62:25,
		GetPlayerLauncher(playerid) == 2 ? PR_UINT8:PR_UINT32, browserid,
		PR_BOOL, toggle);

	return PR_SendPacket(bs, playerid), BS_Delete(bs);

}

stock setBrowserWindowPicture(playerid, browserid, url[])
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs, 
		PR_UINT8, 220,
		PR_UINT8, 16,
		PR_UINT32, browserid,
		PR_STRING32, url);

	return PR_SendPacket(bs, playerid), BS_Delete(bs);
}

stock GetBussinesText(type, i)
{
	static text[248] = "";

	switch(BizData[i][bState]){
		case 2: SetString(text, type == 1 ? "Место в котором можно приобрести продукты питания, базовые расходники и личные вещи, которые могут вам пригодиться." : "market");
		case 0: SetString(text, type == 1 ? "Здесь вы можете приобрести различное оружие и сразу проверить его в тире, повышая и оттачивая свои навыки стрельбы." : "ammo");
		case 6: SetString(text, type == 1 ? "Закусочная для вашей железной ласточки. Если с ней возникли проблемы, то здесь можно купить предметы и расходники первой необходимости для ее починки." : "gas");
		case 1: SetString(text, type == 1 ? "Здесь можно смочить горло алкогольными напитками, познакомиться с другими игроками, посмотреть видео с ютуба на проекторе и втянуться в мир азартных игр." : "bar");
		case 3: SetString(text, type == 1 ? "В этом месте за небольшую сумму можно прилично приодеться. С купленной в этом магазине одеждой - вам будет не стыдно выходить в люди." : "clothing");
		case 19: SetString(text, type == 1 ? "Место, в котором собрались все новые технологии вместе. Здесь можно приобрести видеокарты, жесткие диски и прочее компьютерное комплектующие, включая расходники, которые понадобятся для майнинга." : "computer_shop");
		case 17: SetString(text, type == 1 ?"Если вы увлекаетесь играми, то здесь можно сделать ставку на игровые события. Или просто отдыхать, следя за происходящим в вашей любимой игре на большом экране." : "bookmaker");
		case 22: SetString(text, type == 1 ? "Здесь можно починить вашу изношенную одежду, а так же улучшить ее за точильные камни, чтобы она повысила характеристики вашего персонажа." : "atelier");
		case 54: SetString(text, type == 1 ? "Магазин, в котором можно приобрести все необходимое для рыбалки, а также улучшить рыболовное снаряжение." : "fish_market");
	}

	return text;
}

