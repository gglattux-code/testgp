		//CreateDynamicPickup(19523, 1, Position[0], Position[1], Position[2], OtelInfo[ID[1]][otBusiness], 8);

		cache_get_value_name(i, "ownername", owner, 24);
		UpdateOtelRoom(ID[1], ID[0], owner);
	}
	cache_delete(result);
	return false;
}

