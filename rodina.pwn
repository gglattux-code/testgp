						PlayerTextDrawSetString(playerid, recon_p[playerid][16],"-");
						PlayerTextDrawSetString(playerid, recon_p[playerid][9],"-");
					}
					if(GetPlayerState(SERIU[playerid][sID]) == 2)
					{
						new Float:HP;
						GetVehicleHealth(GetPlayerVehicleID(SERIU[playerid][sID]),HP);
