cmd:createnpc(playerid)
{
	new npcid = Iter_Free(CustomNPC);

	Taxi_actorData[npcid][taxi_OwnerID] = playerid,
	Taxi_actorData[npcid][taxi_Npcid] = Taxi_playerData[playerid][taxi_ID] = npcid;

	Iter_Add(CustomNPC, npcid);

	CreatePed(playerid,
	Taxi_actorData[npcid][taxi_Npcid],
	randomF(19,30),
	-310.4775,682.1566,12.0391,174.6206,
	100.0, 100.0,
	0, 0,
	0xFFFFFFFF, "Иван",
	0xFFFFFFFF, "" );
	return true;
}
cmd:deletenpc(playerid)
{
	new npcid = Taxi_playerData[playerid][taxi_ID];
	DestroyPed(playerid, npcid);

	Taxi_playerData[playerid][taxi_Spawn] = false,
	Taxi_actorData[npcid][taxi_OwnerID] = Taxi_actorData[npcid][taxi_Npcid] = Taxi_playerData[playerid][taxi_ID] = INVALID_PLAYER_ID,
	Iter_Remove(CustomNPC, npcid);
	return true;
}
cmd:setnpc(playerid)
{
	new npcid = Taxi_playerData[playerid][taxi_ID];
	enter_vehiclePed(playerid, npcid, GetPlayerVehicleID(playerid), 1);
	Taxi_actorData[npcid][taxi_CarIdSeat] = GetPlayerVehicleID(playerid);
	Taxi_playerData[playerid][taxi_PutInVehicle] = true;
	return true;
}

stock DestroyPed(sendId, npcid, toStream = true)
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs,
		PR_UINT8, 221,
		PR_UINT16, 51,
		PR_UINT16, npcid);

	return toStream ? PR_SendPacketToStream(bs, sendId) : PR_SendPacket(bs, sendId), BS_Delete(bs);
}
stock PR_SendPacketToStream(BitStream:bs, playerid, PR_PacketPriority:priority = PR_HIGH_PRIORITY, PR_PacketReliability:reliability = PR_RELIABLE_ORDERED, orderingchannel = 0)
{
	foreach (new i : Player)
	{
    	if (!IsPlayerStreamedIn(i, playerid) or !GetPlayerLauncher(i))
        	continue;

    	PR_SendPacket(bs, i, priority, reliability, orderingchannel);
	}
	return PR_SendPacket(bs, playerid, priority, reliability, orderingchannel);
}

stock enter_vehiclePed(sendId, npcid, carid, seatid)
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs,
		PR_UINT8, 221,
		PR_UINT16, 81,
		PR_UINT16, npcid,
		PR_UINT16, carid,
		PR_UINT16, seatid,
		PR_UINT32, 1000);

	return PR_SendPacketToStream(bs, sendId), BS_Delete(bs);
}

stock CreatePed(sendId, npcid, skin, Float:X, Float:Y, Float:Z, Float:A, Float:Health, Float:Armour, weaponIdd, rounds, color_text_1, text_1[], color_text_2 = 0xFFFFFFFF, text_2[] = "None", toStream = true)
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs,
		PR_UINT8, 221,
		PR_UINT16, 50,
		PR_UINT16, npcid,
		PR_UINT16, skin,
		PR_FLOAT, X,
		PR_FLOAT, Y,
		PR_FLOAT, Z,
		PR_FLOAT, A,
		PR_BOOL, true,
		PR_FLOAT, Health,
		PR_FLOAT, Armour,
		PR_UINT16, weaponIdd,
		PR_UINT8, rounds,
		PR_UINT32, color_text_1,
		PR_STRING32, text_1,
		PR_UINT8, strlen(text_2) > 1 ? 0 : 1,
		PR_UINT32, color_text_2,
		PR_STRING32, text_2,
		PR_UINT32, 0xFFFF00FF);

	return toStream ? PR_SendPacketToStream(bs, sendId) : PR_SendPacket(bs, sendId), BS_Delete(bs);
}
stock AttachKenguryatnik(vehicleid) {

	for(new i; i < sizeof(Kenguryatnik_Data); i++) {
		if(Kenguryatnik_Data[i][KengModel] != GetVehicleModelEx(vehicleid)) continue;

		VehicleInfo[vehicleid][vObject][1] = Kenguryatnik_Data[i][KengObject];
		
		VehicleInfo[vehicleid][vObject][0] = CreateDynamicObject(VehicleInfo[vehicleid][vObject][1], 0.000000, 0.000000, -1000.000000, 0.000000, 0.000000, 0.000000, 0, 0, -1, STREAMER_OBJECT_SD, 150.0); // 0
		AttachDynamicObjectToVehicle(VehicleInfo[vehicleid][vObject][0], vehicleid, Kenguryatnik_Data[i][KengAttach][0], Kenguryatnik_Data[i][KengAttach][1], Kenguryatnik_Data[i][KengAttach][2], 0.000000, 0.000000, 0.000000);
	
	
		break;
	}
}
stock IsGiftUsed(const string[])
{
    f(mysql_string, 128, "SELECT `Name` FROM `gift` WHERE BINARY `Name` = '%s' LIMIT 1", string);
	mysql_query(mysql, mysql_string);

    return cache_num_rows();
}

cmd:addcode(playerid, params[])
{
    static text[30];

	if !CheckFD(playerid, 2) *then
	    return SCM(playerid, COLOR_RED, "[Ошибка]{FFFFFF} Неизвестная команда! Введите /help для просмотра доступных функций.");
        
    if(sscanf(params, "s[30]dd", text, params[1], params[2]))
		return SCM(playerid, COLOR_OLDRED, "Используйте: /addcode [name] [кол-во использований] [показывать в общий чат (0 - нет, 1 - да]");
		
    if(params[1] <= 0 or params[2] > 1 or params[2] < 0) 
		return false;
		
    if(IsGiftUsed(text))
		return SCMF(playerid, COLOR_OLDRED, "[Ошибка] {FFFFFF}Подарок %s уже существует", text);
		
    SPD(playerid, 29991, DIALOG_STYLE_LIST, "{FFFFFF}Выберите приз | {ae433d}Подарочная система", "{ae433d}[1] {FFFFFF}АЗ-Рубли\n{ae433d}[2] {FFFFFF}Предмет\n{ae433d}[3] {FFFFFF}Автомобиль\n{ae433d}[4] {FFFFFF}Админ-права\n{ae433d}[5] {FFFFFF}Вип-права", "Выбрать", "Назад");
    return SetPVarString(playerid, "gText", text), Int_SetPlayerData(playerid, "gActivations", params[1]), Int_SetPlayerData(playerid, "gForAll", params[2]);
}
cmd:code(playerid, params[])
{
	if(sscanf(params, "s[30]", params[0]))
		return SCM(playerid, COLOR_OLDRED, "Используйте: /code [name]");
	
	f(mysql_string, 200, "SELECT * FROM gift_use WHERE gift = '%s' AND playerId = '%d' LIMIT 1;", params[0], PI[playerid][pID]);
	mysql_tquery(mysql, mysql_string, "setgiftusage", "ds", playerid, params[0]);
	
	return false;
}
	
public: setgiftusage(playerid, gift[])
{
	if(!cache_num_rows())
		f(mysql_string, 150, "SELECT * FROM gift WHERE Name = '%s' AND Active > 0 LIMIT 1;", gift),
		mysql_tquery(mysql, mysql_string, "@gift_active", "ds", playerid, gift);
	else 
		SCM(playerid, COLOR_OLDRED, "[Ошибка] {FFFFFF}Нельзя использовать данный подарок повторно!");
}

public: @gift_active(playerid, gift[])
{
	if(!cache_num_rows())
		return SCM(playerid, COLOR_OLDRED, "[Ошибка]{FFFFFF} Подарок не найден!");

	new giftCount, countUse, dataId, gidtId, type;

	cache_get_value_name_int(0, "ID", gidtId);
	cache_get_value_name_int(0, "Active", giftCount);
	cache_get_value_name_int(0, "count", countUse);
	cache_get_value_name_int(0, "data", dataId);
	cache_get_value_name_int(0, "type", type);

	if(giftCount <= 0)
		return SCM(playerid, COLOR_OLDRED, "[Ошибка]{FFFFFF} Количество активаций данного подарка исчерпано!");

	SQL("UPDATE gift SET Active = `Active` - 1 WHERE Name = '%s'", gift);
	SQL("INSERT INTO gift_use (`giftId`, `gift`, `playerId`, `playerName`) VALUES ('%d', '%s', '%d', '%s')", gidtId, gift, PI[playerid][pID], PlayerName[playerid]);

	new prize_str[125];
	switch(type)
	{
		case 0:
		{
			f(prize_str, 100, "%d AZ-Рублей", countUse);
			GiveRoubles(playerid, countUse, "активации /gift");
		}

		case 1:
		{
			f(prize_str, 100, "Предмет %s (%d шт.)", ItemsInfo[dataId][itemName], countUse);
			AddItem(playerid, dataId, countUse);
		}
		
		case 2:
		{
			f(prize_str, 100, "Автомобиль %s", GetVehicleName(dataId, true));
			SQL("INSERT INTO `ownable` (`Model`, `Owner`, `Cost`, `Keyer`, `ParkedInPark`) VALUES ('%d', '%s', '10000', 'The State', '1')", dataId, PlayerName[playerid]);
		}
		case 3:
		{
			f(prize_str, 100, "Админ-права %d LVL", countUse);

			if(PI[playerid][pAdmin] < countUse)
			{
				SQL("INSERT INTO `admin` (`name`, `level`, `last_connect`, `put_admin`, `data`) VALUES ('%s', '%d', CURDATE(), 'Server', CURDATE())", PN(playerid), countUse);
				SQL("UPDATE accounts SET Admin = %d WHERE NickName = '%s'", PI[playerid][pAdmin] = countUse, PN(playerid));
			}
		}
		case 4:
		{
		    f(prize_str, 100, "Вип-права %d LVL", countUse);

		    if PI[playerid][pVIP] < countUse *then
		    	SQL("UPDATE `accounts` SET `VIP` = '%d', `VipTime` = '%d' WHERE `ID` = '%d'", PI[playerid][pVIP] = countUse, PI[playerid][pVipTime] = Global_Time + (1800 * 86400), PI[playerid][pID]);
		}
	}
	SCMF(playerid, COLOR_VALIK, "[Информация] {FFFFFF}Вы успешно активировали подарок \"%s\". За активацию вы получили приз: %s", gift, prize_str);

	f(global_str, 256, "[A] {FFFFFF}Игрок %s[%d] активировал подарок [приз: %s]", PlayerName[playerid], playerid,  prize_str);
	return SendAdminsMessage(COLOR_VALIK, global_str);
}

