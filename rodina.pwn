					case 1:
						{
							if(StolInfo[id][stolTime] != 0)
							{
								f(global_str, 256,"[ Стол №%d ]\n\
								{9ACD32}Ожидание игроков:{FFFFFF} %d/6\n\
								{9ACD32}Ставка:{FFFFFF} %d фишек\n\n\
