stock KeyboardRedAge(playerid, type)
{
	switch(type)
	{
		case 0:
		{
			executeEvent(playerid, 0, "window.executeEvent('cef.hud.updateVisibleComponents', JSON.stringify([['walletMoney','needsInformation','serverInformation','wanted','weaponInformation','voiceChatSpeakers','questsInformation','radio','levelInformation']]));");
			executeEvent(playerid, 0, "window.executeEvent('cef.hud.setPlayerKeysHint', JSON.stringify([[{key:'F6',text:'Чат'},{key:'P',text:'Телефон'},{key:'I',text:'Инвентарь'},{key:'Z',text:'Говорить'},{key:'TAB',text:'Список игроков'}]]));");
		}
		case 1:
		{
			if(IsPlayerInAnyVehicle(playerid))
			{
				executeEvent(playerid, 0, "window.executeEvent('cef.hud.updateVisibleComponents', JSON.stringify([['walletMoney','needsInformation','serverInformation','wanted','weaponInformation','voiceChatSpeakers','questsInformation','radio','levelInformation','speedometer']]));");
				executeEvent(playerid, 0, "window.executeEvent('cef.hud.setPlayerKeysHint', JSON.stringify([[{key:'N',text:'Завести'},{key:'J',text:'Ремень'},{key:'CTRL',text:'Фары'},{key:'R',text:'Музыка'}]]));");
			}
			else
			{
				executeEvent(playerid, 0, "window.executeEvent('cef.hud.updateVisibleComponents', JSON.stringify([['walletMoney','needsInformation','serverInformation','wanted','weaponInformation','voiceChatSpeakers','questsInformation','radio','levelInformation']]));");
				executeEvent(playerid, 0, "window.executeEvent('cef.hud.setPlayerKeysHint', JSON.stringify([[{key:'F6',text:'Чат'},{key:'P',text:'Телефон'},{key:'I',text:'Инвентарь'}]]));");
			}
		}
	}
	return 1;
}
CMD:testkeys(playerid, params[])
{
    KeyboardRedAge(playerid, 1);
    return 1;
}
