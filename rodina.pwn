stock ShowSpawnSelection(playerid)
{
    new spawn_json[1024] = "[";

    strcat(spawn_json, "{\"id\": 0, \"title\": \"Вокзал\", \"image\": \"0\", \"favorite\": 0}");

    if(PI[playerid][pHouseKey] != -1 && PI[playerid][pHouseKey] != 0)
        strcat(spawn_json, ",{\"id\": 3, \"title\": \"Мой дом\", \"image\": \"7\", \"favorite\": 0}");

    if(FP_Data[playerid][F_FAMILY_ID] > 0)
        strcat(spawn_json, ",{\"id\": 1, \"title\": \"Семейная квартира\", \"image\": \"4\", \"favorite\": 0}");

    strcat(spawn_json, ",{\"id\": 5, \"title\": \"Остаться\", \"image\": \"16\", \"favorite\": 0}");
    strcat(spawn_json, "]");

    if(GetPlayerLauncher(playerid) == 2)
    {
        eventMobile(playerid, {104, 0}, spawn_json);
        cursorPlayer(playerid, 104, true);
    }
    else
    {
        executeEvent(playerid, 0, "window.executeEvent('cef.clearNotifications', '[ null ]');");
        executeEvent(playerid, 0, "window.executeEvent('cef.hud.updateVisibleComponents', JSON.stringify([['walletMoney','needsInformation','serverInformation','wanted','weaponInformation','voiceChatSpeakers','questsInformation','radio','levelInformation','speedometer','banner','playerVipDuration','battlePassNotification']]));");
        executeEvent(playerid, 0, "window.executeEvent('event.setActiveView', '[\"SpawnSelection\"]');");
        executeEvent(playerid, 0, "window.executeEvent('cef.toggleServerCursor', '[true,true]');");
        executeEvent(playerid, 0, "window.executeEvent('cef.hud.updateVisibleComponents', JSON.stringify([[]]));");

        format(global_str, sizeof(global_str), "window.executeEvent('event.spawn-selection.initializeSpawns', '[%s]');", spawn_json);
        executeEvent(playerid, 0, global_str);
    }

    format(global_str, sizeof(global_str), "window.executeEvent('cef.hud.updatePlayerFood', '[%f]');", float(Fullness[playerid]));
    executeEvent(playerid, 0, global_str);

    return true;
}
