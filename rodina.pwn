            executeEvent(playerid, 0, "window.executeEvent('event.questsApp.initializeBonusProgress', '[{\"categoryId\":1, \"progressCurrent\":0, \"prizes\": [{ \"id\": 0, \"received\": 0 },{ \"id\": 1, \"received\": 0 },{ \"id\": 2, \"received\": 0 },{ \"id\": 3, \"received\": 0 }]}]');");
