                    if(GetCount(pTemp[playerid][pCentralMarketSelectId] == 1 ? crOwnerId : playerid, 3207) < CentralMarketItems[crId][pTemp[playerid][pCentralMarketSelectId]][2][slotId] * count or CentralMarketItems[crId][pTemp[playerid][pCentralMarketSelectId]][2][slotId] * count <= 0) 
