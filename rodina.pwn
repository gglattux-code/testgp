cmd:plpos(playerid, params[])
{
    extract params -> new player:target, Float:coords[3]; else
        return SCM(playerid, COLOR_OLDRED, "Используйте: /plpos [id] [x] [y] [z]");

    SCMF(target, COLOR_LIGHTBLUE, " Вы были телепортированы администратором %s[%d] в координаты %.3f, %.3f, %.3f.", PN(playerid), playerid, coords[0], coords[1], coords[2]);
    SAMF(COLOR_GREY, "[A] %s[%d] телепортировал игрока %s[%d] в координаты %.3f, %.3f, %.3f.", PN(playerid), playerid, PN(target), target, coords[0], coords[1], coords[2]);

    return UpdatePlayerPos(target, coords[0], coords[1], coords[2]);
}

stock IsLegendAccessory(itemid)
{
	for(new i, legend_item[] = {7410, 7846}; i < sizeof(legend_item); i++)
		if(itemid == legend_item[i])
			return true;

	return false;
}
public: SetItemsServerCounts()
{
	new global_ItemInfo[3][InventoryMaxSlot];

	for(new i; i < sizeof(ItemsInfo); i++)
		ItemsInfo[i][itemServerCount] = 0;

	for(new i; i < cache_num_rows(); i++)
	{
		cache_get_value_name(i, "InventoryItem", global_str), Int_UnPackMassive(global_str, global_ItemInfo[0]);
		cache_get_value_name(i, "InventoryCount", global_str), Int_UnPackMassive(global_str, global_ItemInfo[1]);
		cache_get_value_name(i, "AccessoryItem", global_str), Int_UnPackMassive(global_str, global_ItemInfo[2]);
	
		for(new x; x < InventoryMaxSlot; x++)
		{
			if(!global_ItemInfo[0][x] or global_ItemInfo[0][x] >= sizeof(ItemsInfo))
				continue;

			ItemsInfo[global_ItemInfo[0][x]][itemServerCount] += global_ItemInfo[1][x];
		}

		for(new x; x < 8; x++)
		{
			if(!global_ItemInfo[2][x] or global_ItemInfo[2][x] >= sizeof(ItemsInfo))
				continue;
				
			ItemsInfo[global_ItemInfo[2][x]][itemServerCount]++;
		}
	}

	return true;
}

stock LoadCFG()
{
    new FileID = ini_openFile("serverconfig.ini");
	ini_getString(FileID,"server_name",Setting_Server[7]);
	f(VipNames[7], 50, Setting_Server[7]);
    ini_getString(FileID,"full_server_name",ServerCFG[full_server_name]);
    ini_getString(FileID,"server_group_vk",Setting_Server[5]);
    ini_getString(FileID,"server_telegram",Setting_Server[6]);
    ini_getString(FileID,"server_forum",Setting_Server[4]);
    ini_getString(FileID,"server_site",Setting_Server[3]);
    ini_getString(FileID,"bonus_level", ServerCFG[bonus_level]);
    ini_getString(FileID,"bonus_money", ServerCFG[bonus_money]);
    ini_getString(FileID,"bonus_donate", ServerCFG[bonus_donate]);
    ini_getString(FileID,"server_password",ServerCFG[server_password]);
	ini_getString(FileID,"host_bd",mysql_data[0]);
	ini_getString(FileID,"username_bd",mysql_data[1]);
	ini_getString(FileID,"database_bd",mysql_data[3]);
	ini_getString(FileID,"password_bd",mysql_data[2]);

	ini_getString(FileID,"host_bd_log",ServerCFG[host_bd]);
	ini_getString(FileID,"username_bd_log",ServerCFG[username_bd]);
	ini_getString(FileID,"database_bd_log",ServerCFG[database_bd]);
	ini_getString(FileID,"password_bd_log",ServerCFG[password_bd]);
    return ini_closeFile(FileID); 
}

stock sendInventoryCefSlotUpdate(playerid, item, amount, cell_type = 0, slot = 0, text[] = "", id = -1)
{


	new time;

	if(strlen(text) < 3)
		time = GetInventoryItemText(playerid, cell_type, id, slot, mysql_string, false, true);
	
	global_str[0] = EOS;
	
	f(global_str, sizeof(global_str), "{\"slot\":%d%s}", slot, !item ? "" : (str_f(",\"item\":%i,\"amount\":%i,\"text\":\"%s\",\"available\":1,\"time\":%i", item, amount, strlen(text) < 3 ? mysql_string : text, time)));
	
	switch(GetPlayerLauncher(playerid))
	{
		case 1: executeEvent(playerid, 0, (str_f("window.executeEvent('event.inventory.playerInventory', '[{\"action\":2,\"data\":{\"type\":%i,\"items\":[%s]}}]');", cell_type == 0 ? 1 : 9, global_str)));
		case 2: eventMobile(playerid, {52, 2}, (str_f("{\"type\":1,\"items\":[%s]}", global_str)));
	}

	
	return true;
}

stock sendInventoryAlItems(playerid, entered_id, cell_type, open, slot, action)
{	
	if(InventOpenNew[playerid] == 18)
		open = 1;

	mysql_string = "";

	if(cell_type != 8)
		GetInventoryItemText(playerid, cell_type, entered_id, slot, mysql_string, false, true);

	else f(mysql_string, sizeof(mysql_string), "%i BTC", Kiosk[entered_id][kItemSell][slot]);

	strcat(global_str, (str_f("{\"slot\":%i%s%s", slot, !(cell_type == 1 ? HouseInfo[entered_id][hItem][slot] : cell_type == 2 ? MusorInfo[entered_id][mItem][slot] : cell_type == 3 ? TrunkInfo[entered_id][tItem][slot] : cell_type == 7 && slot < 15 ? AccessoryKioskData[entered_id][acsKioskAccessory][slot] : cell_type == 8 ? Kiosk[entered_id][kItems][slot] : cell_type == 9 ? ShopInfo[entered_id][sItem][slot] : 0) ? "}" : (str_f(",\"item\":%i,\"amount\":%i,\"text\":\"%s\",\"available\":1}", (cell_type == 1 ? HouseInfo[entered_id][hItem][slot] : cell_type == 2 ? MusorInfo[entered_id][mItem][slot] : cell_type == 3 ? TrunkInfo[entered_id][tItem][slot] : cell_type == 7 && slot < 15 ? AccessoryKioskData[entered_id][acsKioskAccessory][slot] : cell_type == 8 ? Kiosk[entered_id][kItems][slot] : cell_type == 9 ? ShopInfo[entered_id][sItem][slot] : 0), (cell_type == 1 ? HouseInfo[entered_id][hItemCount][slot] : cell_type == 2 ? MusorInfo[entered_id][mItemCount][slot] : cell_type == 3 ? TrunkInfo[entered_id][tItemCount][slot] : 1), mysql_string)), open ? ("") : (","))));

	InventOpenNew[playerid]++;

    if open *then
	{
		switch(GetPlayerLauncher(playerid))
		{
			case 1: executeEvent(playerid, 0, (str_f("window.executeEvent('event.inventory.playerInventory', '[{\"action\":%d,\"data\":{\"type\":9,\"items\":[%s]}}]');", action, global_str)));
			case 2: eventMobile(playerid, {60, 0}, (str_f("{\"type\":38,\"items\":[%s]}",  global_str)));
		}
		InventOpenNew[playerid] = 0;
		global_str = "";
	}

	return true;
}

stock sendInventoryKioskItems(playerid, ID, number_1 = 0, number_2 = 0)
{
	global_str = "";

	if(number_2 > 30) number_2 = 30;

	for(new i = number_1; i < number_2; i++) {
		f(global_str, sizeof(global_str), "%s{\"slot\":%i%s}%s", global_str, i, !Kiosk[ID][kItems][i] ? "" : (str_f(",\"item\":%i,\"amount\":1,\"text\":\"%i BTC\",\"available\":%i,\"enchant\":0,\"time\":0,\"color\":%i,\"background\":%i", Kiosk[ID][kItems][i], Kiosk[ID][kItemSell][i], Kiosk[ID][kOpenAks][i], Kiosk[ID][kItemsColor][i], ItemsInfo[Kiosk[ID][kItems][i]][itemColor])), i == number_2-1 ? ("") : (","));
	}
	switch(GetPlayerLauncher(playerid))
	{
		case 1:	executeEvent(playerid, 0, (str_f("window.executeEvent('event.inventory.playerInventory', `[{\"action\":0,\"data\":{\"type\":%d,\"items\":[%s]}}]`);", GetPlayerLauncher(playerid) == 1 ? 13:5, global_str)));
		case 2: eventMobile(playerid, {52, 0}, (str_f("{\"type\":%d,\"items\":[%s]}", GetPlayerLauncher(playerid) == 1 ? 13:5, global_str)));
	}

	if(number_2 < 30) 
		return sendInventoryKioskItems(playerid, ID, number_2, number_2 + 15);

	return true;
}

stock sendInventoryCefOtherItems(playerid, entered_id, cell_type, text[] = "", number_1 = 0, number_2 = 14)
{

	global_str = "";
	for(new i; i < (cell_type == 1 ? 90 : cell_type == 2 ? 150 : cell_type == 3 or cell_type == 7 or cell_type == 8 ? 30 : cell_type == 9 ? 64 : 300); i++)
		sendInventoryAlItems(playerid, entered_id, cell_type, i == (cell_type == 1 ? 90 : cell_type == 2 ? 150 : cell_type == 3 or cell_type == 7 or cell_type == 8 ? 30 : cell_type == 9 ? 64 : 300)-1 ? 1:0, i, 0);

	switch(GetPlayerLauncher(playerid))
	{
		case 1:
		{
			hidePlayerHud(playerid);
			executeEvent(playerid, 0, (str_f("window.executeEvent('event.inventory.playerInventory', '[{\"action\":1,\"data\":{\"name\":\"%s\",\"type\":1,\"buttons\":1}}]');", cell_type == 1 ? "Шкаф" : cell_type == 2 ? "Мусорка" : cell_type == 3 ? "Багажник" : cell_type == 7 ? "Магазин" : cell_type == 8 ? "Аренда аксессуаров" : "На продаже")));

			executeEvent(playerid, 0, "window.executeEvent('event.setActiveView', '[\"Inventory\"]');"), 

			cursorPlayer(playerid, 0, true), dialog_player[playerid][D_Custom] = 1;

			executeEvent(playerid, 0, "window.executeEvent('event.inventory.setStoreVisible', '[true, 9]');");

			global_str = "";
			for(new i; i < PI[playerid][pInvCell]; i++)
				sendInventoryAllItemsInv(playerid, i == PI[playerid][pInvCell]-1 ? 1:0, i, 2);
		}
		case 2:
		{
			eventMobile(playerid, {60, 1}, "{\"name\":\"\",\"type\":1,\"buttons\":0}");
			cursorPlayer(playerid, 60, true);

			global_str = "";
			for(new i; i < PI[playerid][pInvCell]; i++)
				sendInventoryAllItemsInv(playerid, i == PI[playerid][pInvCell]-1 ? 1:0, i, 3);
		}
	}	


	return 1;
}

public: sendInventoryCefItems(playerid)
{	
	global_str = "";
	for(new i; i < PI[playerid][pInvCell]; i++)
		sendInventoryAllItemsInv(playerid, i == PI[playerid][pInvCell]-1 ? 1:0, i, 0);

	global_str = "";
	for(new i; i < 6; i++)
	{
		f(global_str, sizeof(global_str), "%s{\"slot\":%d%s", global_str, i, AksSlot[playerid][0][i] != 0 ? (str_f(",\"item\":%d,\"amount\":1,\"text\":\"%d\",\"background\":%d,\"is_use\":0,\"strength\":78,\"available\":1}", AksSlot[playerid][0][i], !AksSlot[playerid][1][i] ? "" : (str_f("+%i", AksSlot[playerid][1][i])), ItemsInfo[AksSlot[playerid][0][i]][itemColor])) : "}");
		strcat(global_str, ",");
	}
	strdel(global_str,strlen(global_str)-1,strlen(global_str));
	executeEvent(playerid, 0, (str_f("window.executeEvent('event.inventory.playerInventory', '[{\"action\":0,\"data\":{\"type\":2,\"items\":[%s]}}]');", global_str)));
	eventMobile(playerid, {52, 0}, (str_f("{\"type\":2,\"items\":[%s]}", global_str)));

	executeEvent(playerid, 0, "window.executeEvent('event.inventory.playerInventory', '[{\"action\":0,\"data\":{\"type\":3,\"items\":[{\"slot\":0},{\"slot\":1}]}}]');");

	if PI[playerid][pSkin][0] != 18 *then executeEvent(playerid, 0, (str_f("window.executeEvent('event.inventory.playerInventory', `[{\"action\":0,\"data\":{\"type\":4,\"items\":[{\"slot\":0,\"item\":%i,\"amount\":1,\"text\":\"ID:%i\",\"available\":1,\"time\":0}]}}]`);", GetSkinInfo(PI[playerid][pSkin][0], 1), PI[playerid][pSkin][0])));
	else executeEvent(playerid, 0, "window.executeEvent('event.inventory.playerInventory', `[{\"action\":0,\"data\":{\"type\":4,\"items\":[{\"slot\":0}]}}]`);");

	executeEvent(playerid, 0, "window.executeEvent('event.inventory.playerInventory', '[{\"action\":0,\"data\":{\"type\":5,\"items\":[{\"slot\":0},{\"slot\":1},{\"slot\":2},{\"slot\":3},{\"slot\":4},{\"slot\":5}]}}]');");
	executeEvent(playerid, 0, "window.executeEvent('event.inventory.playerInventory', '[{\"action\":0,\"data\":{\"type\":6,\"items\":[{\"slot\":0,\"item\":1256,\"amount\":1,\"text\":\"24 дней\",\"available\":1,\"time\":1733825590},{\"slot\":1},{\"slot\":2,\"item\":103,\"amount\":1,\"text\":\"256 дней\",\"available\":1,\"time\":1753862821},{\"slot\":3},{\"slot\":4},{\"slot\":5},{\"slot\":6},{\"slot\":7},{\"slot\":8},{\"slot\":9},{\"slot\":10},{\"slot\":11}]}}]');");
	executeEvent(playerid, 0, "window.executeEvent('event.inventory.playerInventory', '[{\"action\":0,\"data\":{\"type\":28,\"items\":[{\"slot\":0,\"id\":0},{\"slot\":1,\"id\":0},{\"slot\":2,\"id\":0},{\"slot\":3,\"id\":0},{\"slot\":4,\"id\":0},{\"slot\":5,\"id\":0},{\"slot\":6,\"id\":0},{\"slot\":7,\"id\":0},{\"slot\":8,\"id\":0},{\"slot\":9,\"id\":0},{\"slot\":10,\"id\":0},{\"slot\":11,\"id\":0},{\"slot\":0,\"id\":1},{\"slot\":1,\"id\":1},{\"slot\":2,\"id\":1},{\"slot\":3,\"id\":1},{\"slot\":4,\"id\":1},{\"slot\":5,\"id\":1},{\"slot\":6,\"id\":1},{\"slot\":7,\"id\":1},{\"slot\":8,\"id\":1},{\"slot\":9,\"id\":1},{\"slot\":10,\"id\":1},{\"slot\":11,\"id\":1},{\"slot\":0,\"id\":2},{\"slot\":1,\"id\":2},{\"slot\":2,\"id\":2},{\"slot\":3,\"id\":2},{\"slot\":4,\"id\":2},{\"slot\":5,\"id\":2},{\"slot\":6,\"id\":2},{\"slot\":7,\"id\":2},{\"slot\":8,\"id\":2},{\"slot\":9,\"id\":2},{\"slot\":10,\"id\":2},{\"slot\":11,\"id\":2},{\"slot\":0,\"id\":3},{\"slot\":1,\"id\":3},{\"slot\":2,\"id\":3},{\"slot\":3,\"id\":3},{\"slot\":4,\"id\":3},{\"slot\":5,\"id\":3},{\"slot\":6,\"id\":3},{\"slot\":7,\"id\":3},{\"slot\":8,\"id\":3},{\"slot\":9,\"id\":3},{\"slot\":10,\"id\":3},{\"slot\":11,\"id\":3}]}}]');");
	executeEvent(playerid, 0, "window.executeEvent('event.inventory.playerInventory', '[{\"action\":0,\"data\":{\"type\":30,\"items\":[{\"slot\":0,\"id\":0},{\"slot\":1,\"id\":0},{\"slot\":2,\"id\":0},{\"slot\":3,\"id\":0},{\"slot\":0,\"id\":1},{\"slot\":1,\"id\":1},{\"slot\":2,\"id\":1},{\"slot\":3,\"id\":1},{\"slot\":0,\"id\":2},{\"slot\":1,\"id\":2},{\"slot\":2,\"id\":2},{\"slot\":3,\"id\":2},{\"slot\":0,\"id\":3},{\"slot\":1,\"id\":3},{\"slot\":2,\"id\":3},{\"slot\":3,\"id\":3}]}}]');");	



	return true;
}

stock sendInventoryAllItemsInv(playerid, open, slot, action)
{	
	if(InventOpenNew[playerid] == 18)
		open = 1;

	mysql_string = "";

	if(Inventory[playerid][0][slot] != 0)
	{
		new time_item;
		GetInventoryItemText(playerid, 0, 0, slot, mysql_string);
		if(PI[playerid][pNFTSet]) {
			for(new i; i <= PI[playerid][pNFTSet]; i++) {
				if(PI[playerid][pNFTTime][i] && PI[playerid][pNFTItem][i] == slot) {
					time_item = i + 1;
					break;
				}
			}
		}
		strcat(global_str, (str_f("{\"slot\":%d,\"item\":%i,\"amount\":%i,\"text\":\"%s\",\"available\":%d,\"time\":%i}%s", slot, Inventory[playerid][0][slot], Inventory[playerid][1][slot], mysql_string, InventSlotUse[playerid][slot] ? 0:1, time_item ? PI[playerid][pNFTTime][time_item - 1] : Inventory[playerid][6][slot], open ? "":",")));
	}
	else
		strcat(global_str, (str_f("{\"slot\":%d}%s", slot, open ? "":",")));

	InventOpenNew[playerid]++;

    if open *then
	{
		
		switch(GetPlayerLauncher(playerid))
		{
			case 1: executeEvent(playerid, 0, (str_f("window.executeEvent('event.inventory.playerInventory', '[{\"action\":%d,\"data\":{\"type\":1,\"items\":[%s]}}]');", action, global_str)));
			case 2:
			{
				if(action != 3) eventMobile(playerid, {52, 0}, (str_f("{\"type\":1,\"items\":[%s]}", global_str)));
				else  eventMobile(playerid, {52, 2}, (str_f("{\"type\":1,\"items\":[%s]}", global_str)));
			}
		}
		InventOpenNew[playerid] = 0;
		global_str = "";
	}

	return true;
}


stock sendInventoryCEF(playerid)
{
    switch(GetPlayerLauncher(playerid))
    {
        case 1:
        {
            static invString[4096];
            static skinExtra[128];
            new model, background;

            hidePlayerHud(playerid);

            if(IsPlayerInAnyVehicle(playerid) && IsAOwnableCar(GetPlayerVehicleID(playerid)))
            {
                model = 400 + SearchVehicleMassiveID(GetVehicleModelEx(GetPlayerVehicleID(playerid)));
                background = -1;
                format(skinExtra, sizeof(skinExtra), ",\"oil\":100,\"health\":100,\"max_health\":100");
            }
            else
            {
                model = GetSkinInfo(PI[playerid][pSkin][0], 0);
                background = ItemsInfo[GetSkinInfo(PI[playerid][pSkin][0], 1)][itemColor];
                format(skinExtra, sizeof(skinExtra), ",\"security\":%i", RD_HasGuard(playerid) ? 1 : 0);
            }

            format(invString, sizeof(invString),
                "window.executeEvent('event.inventory.playerInventory','[{\"action\":1,\"data\":{\"skin\":{\"model\":%i,\"background\":%i}%s,\"buttons\":%i,\"accsPages\":{\"total\":3,\"page\":1}}}]');",
                model,
                background,
                skinExtra,
                getInventoryPlayerButton(playerid)
            );
            executeEvent(playerid, 0, invString);

            executeEvent(playerid, 0, "window.executeEvent('event.setActiveView', '[\"Inventory\"]');");
            cursorPlayer(playerid, 0, true);
            dialog_player[playerid][D_Custom] = 1;
            executeEvent(playerid, 0, "window.executeEvent('event.inventory.setPlayerInventoryVisible', '[true]');");

            global_str[0] = EOS;

            for(new i; i < PI[playerid][pInvCell]; i++)
                sendInventoryAllItemsInv(playerid, i == PI[playerid][pInvCell]-1 ? 1:0, i, 2);

            if(IsPlayerInAnyVehicle(playerid) && IsAOwnableCar(GetPlayerVehicleID(playerid)))
            {
                format(invString, sizeof(invString),
                    "window.executeEvent('event.inventory.playerInventory', '[{\"action\":0,\"data\":{\"type\":16,\"items\":[{\"slot\":0%s}]}}]');",
                    CarInfo[GetVehicleID(GetPlayerVehicleID(playerid))][cInvCell][21] ?
                    (format(skinExtra, sizeof(skinExtra), ",\"item\":%i,\"amount\":1,\"text\":\"\",\"available\":1,\"time\":0", CarInfo[GetVehicleID(GetPlayerVehicleID(playerid))][cInvCell][21]), skinExtra) : ""
                );
                executeEvent(playerid, 0, invString);

                global_str[0] = EOS;
                for(new i; i < 10; i++)
                {
                    format(invString, sizeof(invString), "%s{\"slot\":%i%s%s",
                        global_str, i,
                        CarInfo[GetVehicleID(GetPlayerVehicleID(playerid))][cInvCell][i] == 0 ? "}" :
                        (format(skinExtra, sizeof(skinExtra), ",\"item\":%i,\"amount\":1,\"text\":\"\",\"available\":1,\"time\":0}", CarInfo[GetVehicleID(GetPlayerVehicleID(playerid))][cInvCell][i]), skinExtra),
                        i == 9 ? "" : ","
                    );
                    format(global_str, sizeof(global_str), "%s", invString);
                }
                format(invString, sizeof(invString),
                    "window.executeEvent('event.inventory.playerInventory', '[{\"action\":0,\"data\":{\"type\":14,\"items\":[%s]}}]');",
                    global_str
                );
                executeEvent(playerid, 0, invString);

                global_str[0] = EOS;
                for(new i; i < 10; i++)
                {
                    format(invString, sizeof(invString), "%s{\"slot\":%i%s%s",
                        global_str, i,
                        CarInfo[GetVehicleID(GetPlayerVehicleID(playerid))][cInvCell][i + 10] == 0 ? "}" :
                        (format(skinExtra, sizeof(skinExtra), ",\"item\":%i,\"amount\":1,\"text\":\"\",\"available\":1,\"time\":0}", CarInfo[GetVehicleID(GetPlayerVehicleID(playerid))][cInvCell][i + 10]), skinExtra),
                        i == 9 ? "" : ","
                    );
                    format(global_str, sizeof(global_str), "%s", invString);
                }
                format(invString, sizeof(invString),
                    "window.executeEvent('event.inventory.playerInventory', '[{\"action\":0,\"data\":{\"type\":15,\"items\":[%s]}}]');",
                    global_str
                );
                executeEvent(playerid, 0, invString);

                executeEvent(playerid, 0, "window.executeEvent('event.inventory.updateCharacterTab',`[\"vehicle\"]`);");
            }
            else executeEvent(playerid, 0, "window.executeEvent('event.inventory.updateCharacterTab',`[\"character\"]`);");
        }

        case 2:
        {
            if(IsPlayerInAnyVehicle(playerid) && IsAOwnableCar(GetPlayerVehicleID(playerid)))
            {
                eventMobile(playerid, {66, 0}, (str_f("{\"type\":16,\"items\":[{\"slot\":0,\"available\":1%s}],\"max_slot\":1}", CarInfo[GetVehicleID(GetPlayerVehicleID(playerid))][cInvCell][21] ? (str_f(",\"item\":%i,\"amount\":1,\"text\":\"\",\"time\":0", CarInfo[GetVehicleID(GetPlayerVehicleID(playerid))][cInvCell][21])) : "")));
                global_str[0] = EOS;
                for(new i; i < 10; i++)
                    f(global_str, sizeof(global_str), "%s{\"slot\":%i,\"available\":1%s%s", global_str, i, CarInfo[GetVehicleID(GetPlayerVehicleID(playerid))][cInvCell][i + 10] == 0 ? "}" : (str_f(",\"item\":%i,\"amount\":1,\"text\":\"\",\"time\":0}", CarInfo[GetVehicleID(GetPlayerVehicleID(playerid))][cInvCell][i + 10])), i == 9 ? ("") : (","));
                eventMobile(playerid, {66, 0}, (str_f("{\"type\":15,\"items\":[%s],\"max_slot\":10}", global_str)));
                global_str[0] = EOS;
                for(new i; i < 10; i++)
                    f(global_str, sizeof(global_str), "%s{\"slot\":%i,\"available\":1%s%s", global_str, i, CarInfo[GetVehicleID(GetPlayerVehicleID(playerid))][cInvCell][i] == 0 ? "}" : (str_f(",\"item\":%i,\"amount\":1,\"text\":\"\",\"time\":0}", CarInfo[GetVehicleID(GetPlayerVehicleID(playerid))][cInvCell][i])), i == 9 ? ("") : (","));
                eventMobile(playerid, {66, 0}, (str_f("{\"type\":14,\"items\":[%s],\"max_slot\":10}", global_str)));
                eventMobile(playerid, {66, 0}, "{\"type\":41,\"items\":[{\"slot\":0,\"available\":1}],\"max_slot\":1}");
                eventMobile(playerid, {66, 1}, (str_f("{\"skin\":{\"model\":9931,\"background\":-1},\"oil\":86,\"health\":96,\"max_health\":100,\"buttons\":16407,\"name\":\"%s\"}", GetVehicleName(GetPlayerVehicleID(playerid)))));
                cursorPlayer(playerid, 66, true);
            }
            else
            {
                global_str[0] = EOS;
                for(new i; i < PI[playerid][pInvCell]; i++)
                    sendInventoryAllItemsInv(playerid, i == PI[playerid][pInvCell]-1 ? 1:0, i, 2);
                eventMobile(playerid, {52, 1}, (str_f("{\"skin\":{\"model\":%d,\"background\":-1},\"buttons\":1}", GetSkinInfo(PI[playerid][pSkin][0], 0))));
                cursorPlayer(playerid, 52, true);
            }
        }
    }
    return 1;
}

stock showServerInterfaceSettings(playerid)
{
	global_str = "";

	new serverInterfaceNamed[][] = {"Старые SAMP диалоги"};

	for(new i; i < sizeof(serverInterfaceNamed); i++)
		f(global_str, sizeof(global_str), "%s{cccccc}%s\t[ %s ]", global_str, serverInterfaceNamed[i], serverInterfaceSettings[i] ? "{AAE952}Активно{FFFFFF}" : "{E95252}Неактивно{FFFFFF}");

	return SPD(playerid, 26504, DIALOG_STYLE_LIST, "Настройка интерфейсов", global_str, "Изменить", "Закрыть");
}


stock sendInventoryCEFButtonBits(buttons[])
{
	new inventoryCefButtonsData[][][] = 
		{ {1, "Use"}, {32768, "Put"}, {2, "Put_on"}, {65536, "Take"}, {256, "Take_on"}, {64, "Item_open"}, {128, "Item_close"}, {4, "Drop"}, {8, "Split"}, {512, "Clear"}, {1024, "Install"}, {2048, "Edit"}, {4096, "Open"}, {8192, "Rent"}, {16384, "Color"}, {16, "Info"}, {32, "Close"}, {131072, "Sell"}, {262144, "PutInGift"} }, string_data[6][16], bits;

	sscanf(buttons, "P<|>a<s[16]>[6]", string_data);

	for(new id; id < 6; id++)
	{
		if(isnull(string_data[id]))
			continue;

		for(new i; i < sizeof(inventoryCefButtonsData); i++)
			if(GetString(string_data[id], inventoryCefButtonsData[i][1]))
				bits += inventoryCefButtonsData[i][0][0];
	}

	return bits;
}

stock useableAccessory(playerid, slot)
{
	if(AksVidStatus[playerid][slot])
	{
		if(bool:AksDel[playerid][slot] != true) return false;

		switch(AksSlot[playerid][0][slot])
		{
			case 104: {
				SCM(playerid, COLOR_VALIK, "[Рыбалка]{FFFFFF} Вы успешно достали удочку.");
				SCM(playerid, COLOR_VALIK, "[Рыбалка]{FFFFFF} Если хотите начать рыбачить, то используйте команду - {73B461}/fishrod");
				if(!IsPlayerAttachedSlotUsedEx(playerid, 7)) SetPlayerAttachedObject(playerid, 7,18632,6,0.079376,0.037070,0.007706,181.482910,0.000000,0.000000,1.000000,1.000000,1.000000);
			}

			case 99:
			{
				if(CountVehicles() >= MAX_VEHICLES - 1 or AnimPlayed{playerid} or !(GetPlayerState(playerid) == 1)) return SendErrorMessage(playerid);

				new Float:X, Float:Y, Float:Z, Float:A;
				GetPlayerPos(playerid, X, Y, Z), GetPlayerFacingAngle(playerid, A);

				PLVEH_destroy(playerid);
				
				PI[playerid][plveh] = J_AddStaticVehicleEx(510, X, Y, Z, A, 1, 1), PutPlayerInVehicle(playerid, PI[playerid][plveh], 0);

				SetEngineStatus(PI[playerid][plveh], true, playerid);
				RemovePlayerAttachedObject(playerid, 5);
			}
			case 3167:
			{
				if(CountVehicles() >= MAX_VEHICLES - 1 or AnimPlayed{playerid} or !(GetPlayerState(playerid) == 1)) return SendErrorMessage(playerid);

				new Float:X, Float:Y, Float:Z, Float:A;
				GetPlayerPos(playerid, X, Y, Z), GetPlayerFacingAngle(playerid, A);

				PLVEH_destroy(playerid);

				PI[playerid][plveh] = J_AddStaticVehicleEx(1986, X, Y, Z, A, 1, 1), PutPlayerInVehicle(playerid, PI[playerid][plveh], 0);

				SetEngineStatus(PI[playerid][plveh], true, playerid);
				RemovePlayerAttachedObject(playerid, 5);
			}
			
		}
	}

	return true;
}

stock getInventoryPlayerButton(playerid)
{
	new button = 0;

	if(!IsPlayerInAnyVehicle(playerid) && !IsAOwnableCar(GetPlayerVehicleID(playerid)))
	{
		button = 1;
		if(RD_HasGuard(playerid)) button += 4;
		if(HouseEntered[playerid]+50 == GetPlayerVirtualWorld(playerid)) button += 64;
		if(musorka[playerid] != -1) button += 1024;
	}
	if(IsPlayerInAnyVehicle(playerid) && IsAOwnableCar(GetPlayerVehicleID(playerid))) 
	{
		button = 2;
		button += 16;
	}

	return button;
}

stock dropItem(playerid, slot, slot_id = -1)
{
	if(musorka[playerid] == -1) 
		return OtherInvClose(playerid);

	else if(!ItemsInfo[Inventory[playerid][0][slot]][itemTradeable]) 
		return SCM(playerid, COLOR_RED, "[Ошибка]{FFFFFF} Данный предмет нельзя передать!");

	else if(Inventory[playerid][1][slot] == 1)
		AddItemMusor(playerid, musorka[playerid], Inventory[playerid][0][slot], 1, Inventory[playerid][2][slot], Inventory[playerid][3][slot], Inventory[playerid][4][slot], Inventory[playerid][5][slot], 3540), ClearItem(playerid, slot, 1);
	
	else if(Inventory[playerid][1][slot] > 1)
		return PickInvent[playerid] = slot, PickInventSlot[playerid] = (slot_id == -1 ? GetInvID(playerid, slot, 1) : slot_id), SPD(playerid, 8248, DIALOG_STYLE_INPUT, "", "{FFFFFF}Введите количество, которое хотите положить", "Выбрать", "Отмена");

	return true;
}

stock updateDonationPlayerData(playerid)
{
	global_str = "";

	for(new i = 16, status[10], currency_type; i < 18; i++)
	{
		if(PI[playerid][pVIP][0] >= DonateInfo_data[i][data_Give])
			status = "purchased", currency_type = 1;

		else
			status = "available", currency_type = 0; // disabled

		f(global_str, sizeof(global_str), "%s{\"id\":%i,\"title\":\"%s\",\"status\":\"%s\",\"image\":%i,\"category\":\"%s\",\"category_id\":%i,\"discount\":%i,\"currency_type\":%i,\"unix\":0,\"price\":%i}%s", global_str, DonateInfo_data[i][data_ID], DonateInfo_data[i][data_dName], status, DonateInfo_data[i][data_ImageID], DonateInfo_data[i][data_tName], DonateInfo_data[i][data_Type], DonateInfo_data[i][data_Discount], currency_type, DonateInfo_data[i][data_Cost], i == 17 ? "" : ",");
	}

	return executeEvent(playerid, 0, (str_f("window.executeEvent('event.donationshop.InitializeStarterItems', `[[%s]]`);", global_str)));
}


stock separationInt(value) 
{
	new string[32];

    format(string, 32, "%i", value < 0 ? -value : value);

    for(new i = strlen(string); (i -= 3) > 0;)
        if(string[i] != '\0' && '0' <= string[i] <= '9')
            strins(string, ".", i, 32);

    if (value < 0)
        strins(string, "-", 0, 32);

    return string;
}

cmd:givechasall(playerid, params[]) {

	if !CheckFD(playerid, 2) *then
	    return SCM(playerid, COLOR_OLDRED, NO_DOSTUP_TEXT);

	extract params -> new type, count; else
		 return SCM(playerid, COLOR_OLDRED, "Используйте: /givechasall [тип: 0 - обычные, 1 - организационые, 2 - ежедневные] [кол-во]");

	if !(1 <= count <= 100000) *then
		return false;

	foreach(Player, i)
	{
		if(pTemp[i][tAuthorized])
			BonusTime[i][type] += count;
	}

	f(global_str, 125,"Основатель %s выдал всем игрокам %d Часов в /bonus (%s).", PN(playerid), count, type == 1 ? "огранизационные" : type == 2 ? "ежедневные" : "обычные");
	SCMALL(COLOR_RED, global_str);
	return true;
}
stock sendAlert(playerid, type, const title[], const text[], delay)
{
	static 
		notificationType[][] = {"succeeded", "information", "error"};

	switch(GetPlayerLauncher(playerid))
	{
		case 1:	executeEvent(playerid, 0, (str_f("window.executeEvent('cef.addNotification', JSON.stringify(\
		[\
			{\
				\"type\":\"%s\",\
				\"title\":\"%s\",\
				\"description\":\"%s\",\
				\"duration\":%d\
			}\
		]));", notificationType[type], title, text, delay)));
		case 2: 
		{
			type = !type ? 1:type == 1 ? 0:2;

			return cursorPlayer(playerid, 6, true), eventMobile(playerid, {6, 0}, (str_f("{\"styleInt\":%i,\"title\":\"%s\",\"text\":\"%s\",\"duration\":%i}", type, title, text, delay)));
		}
	}

	return true;
}
stock UpdateBizInfo(playerid)
{
	new biz = ShowPBiz[playerid];
	executeEvent(playerid, 0, (str_f("vue.call('business/updateBusiness', '{ \
	\"id\": %d, \
	\"typeId\": %d, \
	\"currentProfit\": %d, \
	\"weeklyProfit\": %d, \
	\"dailyProfit\": %s, \
	\"lock\": %d, \
	\"costEntrance\": 0 }');", biz, BizData[biz][bState], BizData[biz][bMoney], (GetBizWeek(biz, 0) + GetBizWeek(biz, 1) + GetBizWeek(biz, 2) + GetBizWeek(biz, 3) + GetBizWeek(biz, 4) + GetBizWeek(biz, 5) + GetBizWeek(biz, 6)), BizData[biz][bWin], BizData[biz][bLock])));

	return true;
}
stock SetPlayerIdName(playerid, const name[], forplayerid)
{
	new BitStream:bs = BS_New();
	BS_WriteValue(bs,\
		PR_UINT16, forplayerid,\
		PR_UINT8, strlen(name),\
		PR_STRING, name,\
		PR_UINT8, 1);
	PR_SendRPC(bs, playerid, 11);
	return BS_Delete(bs);
}
stock setplayernameall(playerid)
{
	foreach(new i: Player)
	{
		if(pTemp[i][tAuthorized])
		{
			SetPlayerIdName(i, PI[playerid][pRusName], playerid);
			SetPlayerIdName(playerid, PI[i][pRusName], i);
		}
	}
	return true;
}
stock ConvertToRussian(playerid, const input[]) 
{
  	new i, j = 0, output[64];

	while (input[i] != '\0' && j < strlen(input)) 
	{
		if (input[i] == 's' && input[i + 1] == 'h')
			output[j++] = 'ш', i += 2;

		else if (input[i] == 'S' && input[i + 1] == 'h')
			output[j++] = 'Ш', i += 2;

		else if (input[i] == 'c' && input[i + 1] == 'h')
			output[j++] = 'ч', i += 2;

		else if (input[i] == 'Y' && input[i + 1] == 'e')
			output[j++] = 'Е', i += 2;
	
		else if (input[i] == 'y' && input[i + 1] == 'a')
			output[j++] = 'я', i += 2;

		else if (input[i] == 'y' && input[i + 1] == 'u')
			output[j++] = 'ю', i += 2;

		else if (input[i] == 'k' && input[i + 1] == 'h')
			output[j++] = 'х', i += 2;

		else if (input[i] == 'y' && input[i + 1] == 'e')
			output[j++] = 'е', i++;

		else if (input[i] == 'u' && input[i + 1] == 'y')
			output[j++] = 'у', output[j++] = 'й', i += 2;

		else if (input[i] == 'i' && input[i + 1] == 'y')
			output[j++] = 'и', output[j++] = 'й', i += 2;

		else if (input[i] == 'c' && input[i + 1] == 'o')
			output[j++] = 'к', output[j++] = 'о', i += 2;

		else if (input[i] == 'C' && input[i + 1] == 'o')
			output[j++] = 'К', output[j++] = 'о', i += 2;

		else if (input[i] == 'y' && input[i + 1] == 'o' && input[i + 2] == 'u')
			output[j++] = 'ю', i += 3;

		else
		{	
			if(input[i] == 'a')
				output[j++] = 'а';

			else if(input[i] == 'b')
				output[j++] = 'б';

			else if(input[i] == 'c')
				output[j++] = 'ц';

			else if(input[i] == 'd')
				output[j++] = 'д';

			else if(input[i] == 'e')
				output[j++] = 'е';

			else if(input[i] == 'f')
				output[j++] = 'ф';

			else if(input[i] == 'g')
				output[j++] = 'г';

			else if(input[i] == 'h')
				output[j++] = 'х';

			else if(input[i] == 'i')
				output[j++] = 'и';

			else if(input[i] == 'j')
				output[j++] = 'й';

			else if(input[i] == 'k')
				output[j++] = 'к';

			else if(input[i] == 'l')
				output[j++] = 'л';

			else if(input[i] == 'm')
				output[j++] = 'м';

			else if(input[i] == 'n')
				output[j++] = 'н';

			else if(input[i] == 'o')
				output[j++] = 'о';

			else if(input[i] == 'p')
				output[j++] = 'п';

			else if(input[i] == 'q')
				output[j++] = 'к';

			else if(input[i] == 'r')
				output[j++] = 'р';

			else if(input[i] == 's')
				output[j++] = 'с';

			else if(input[i] == 't')
				output[j++] = 'т';

			else if(input[i] == 'u')
				output[j++] = 'у';

			else if(input[i] == 'v')
				output[j++] = 'в';

			else if(input[i] == 'w')
				output[j++] = 'в';

			else if(input[i] == 'x')
				output[j++] = 'к';

			else if(input[i] == 'y')
				output[j++] = 'ы';

			else if(input[i] == 'z')
				output[j++] = 'з';

			else if(input[i] == '_')
				output[j++] = ' ';

			else if(input[i] == 'A')
				output[j++] = 'А';

			else if(input[i] == 'B')
				output[j++] = 'Б';

			else if(input[i] == 'C')
				output[j++] = 'Ц';

			else if(input[i] == 'D')
				output[j++] = 'Д';

			else if(input[i] == 'E')
				output[j++] = 'Е';

			else if(input[i] == 'F')
				output[j++] = 'Ф';

			else if(input[i] == 'G')
				output[j++] = 'Г';

			else if(input[i] == 'H')
				output[j++] = 'Х';

			else if(input[i] == 'I')
				output[j++] = 'И';

			else if(input[i] == 'J')
				output[j++] = 'Й';

			else if(input[i] == 'K')
				output[j++] = 'К';

			else if(input[i] == 'L')
				output[j++] = 'Л';

			else if(input[i] == 'M')
				output[j++] = 'М';

			else if(input[i] == 'N')
				output[j++] = 'Н';

			else if(input[i] == 'O')
				output[j++] = 'О';

			else if(input[i] == 'P')
				output[j++] = 'П';

			else if(input[i] == 'Q')
				output[j++] = 'К';

			else if(input[i] == 'R')
				output[j++] = 'Р';

			else if(input[i] == 'S')
				output[j++] = 'С';

			else if(input[i] == 'T')
				output[j++] = 'Т';

			else if(input[i] == 'U')
				output[j++] = 'У';

			else if(input[i] == 'V')
				output[j++] = 'В';

			else if(input[i] == 'W')
				output[j++] = 'В';

			else if(input[i] == 'X')
				output[j++] = 'К';

			else if(input[i] == 'Y')
				output[j++] = 'Й';

			else if(input[i] == 'Z')
				output[j++] = 'З';

			i++;
		}
  	}

  	output[j] = '\0';
  	SetString(PI[playerid][pRusName], output), SQL("UPDATE `accounts` SET `NameRus` = '%s' WHERE `ID` = '%d' LIMIT 1", output, PI[playerid][pID]);

	return setplayernameall(playerid);
}
stock convert_money(amount, const delimiter[2] = ".") {
  new int_string[15];
  format(int_string, sizeof(int_string), "%d", amount >= 0 ? amount : -amount);
  new value = strlen(int_string);
  switch(value) {
    case 4..6: strins(int_string, delimiter, value - 3, 1);
    case 7..9: strins(int_string, delimiter, value - 3, 1), strins(int_string, delimiter, value - 6, 1);
    case 10..12: strins(int_string, delimiter, value - 3, 1), strins(int_string, delimiter, value - 6, 1), strins(int_string, delimiter, value - 9, 1);
  }
  if(amount < 0) strins(int_string, "-", 0);
  return int_string;
}
stock createShopTD(playerid, value){
	if(shopopen2{playerid}) return false;
	static const name_shop[][] = {"АЗС/МАГАЗИН МЕХАНИКИ", "ПЯТЁРОЧКА", "МАГАЗИН ОРУЖИЯ", "ВКУСНО И ТОЧКА", "РЫБОЛОВНЫЙ МАГАЗИН", "ОБМЕН РЫБНЫХ МОНЕТ"};
	shopopen2{playerid} = true;

	new count = GetShopItemCount(value);

	createShopBox(playerid, value);

	new Float:coord[2], Float:coordx[2]; 
	coord[0] = 186.227982, coord[1] = 215.287720, coordx[0] = 145.197708, coordx[1] = 144.599976;
	
	for(new i; i < 70; i++){
		OtherKletka[playerid][i] = CreatePlayerTextDraw(playerid, coord[0], coordx[0], "ld_spac:white");
		PlayerTextDrawLetterSize(playerid, OtherKletka[playerid][i], 0.480000, 1.120000);
		PlayerTextDrawTextSize(playerid, OtherKletka[playerid][i], 30.589193, 26.897821);
		PlayerTextDrawAlignment(playerid, OtherKletka[playerid][i], 1);
		PlayerTextDrawColor(playerid, OtherKletka[playerid][i], 0xFFFFFFFF);
		PlayerTextDrawUseBox(playerid, OtherKletka[playerid][i], 0);
		PlayerTextDrawBoxColor(playerid, OtherKletka[playerid][i], 0x80808080);
		PlayerTextDrawSetShadow(playerid, OtherKletka[playerid][i], 2);
		PlayerTextDrawSetOutline(playerid, OtherKletka[playerid][i], 0);
		PlayerTextDrawBackgroundColor(playerid, OtherKletka[playerid][i], 0x333333FF);
		PlayerTextDrawFont(playerid, OtherKletka[playerid][i], 5);
		PlayerTextDrawSetProportional(playerid, OtherKletka[playerid][i], 1);
		PlayerTextDrawSetSelectable(playerid, OtherKletka[playerid][i], 1);
		if(i < count){
			new item = ShopData[value][shopItem][i];
            PlayerTextDrawSetPreviewModel(playerid, OtherKletka[playerid][i], ItemsInfo[item][itemModel]);
            PlayerTextDrawSetPreviewRot(playerid, OtherKletka[playerid][i], ItemsInfo[item][itemRotation][0], ItemsInfo[item][itemRotation][1], ItemsInfo[item][itemRotation][2], ItemsInfo[item][itemRotation][3]);

			PlayerTextDrawShow(playerid, OtherKletka[playerid][i]);

			OtherKletkaText[playerid][i] = CreatePlayerTextDraw(playerid, coord[1], coordx[1], (str_f("%s %s", GetShopCost(i, value, BizEntered[playerid]), value == 5 ? "Coins" : "RUB")));
			PlayerTextDrawLetterSize(playerid, OtherKletkaText[playerid][i], 0.099622, 0.597729);
			PlayerTextDrawTextSize(playerid, OtherKletkaText[playerid][i], 1280.000000, 1280.000000);
			PlayerTextDrawAlignment(playerid, OtherKletkaText[playerid][i], 3);
			PlayerTextDrawColor(playerid, OtherKletkaText[playerid][i], 0x11BC11FF);
			PlayerTextDrawUseBox(playerid, OtherKletkaText[playerid][i], 0);
			PlayerTextDrawBoxColor(playerid, OtherKletkaText[playerid][i], 0x80808080);
			PlayerTextDrawSetShadow(playerid, OtherKletkaText[playerid][i], 0);
			PlayerTextDrawSetOutline(playerid, OtherKletkaText[playerid][i], 0);
			PlayerTextDrawBackgroundColor(playerid, OtherKletkaText[playerid][i], 0x00000000);
			PlayerTextDrawFont(playerid, OtherKletkaText[playerid][i], 2);
			PlayerTextDrawSetProportional(playerid, OtherKletkaText[playerid][i], 1);
			PlayerTextDrawSetSelectable(playerid, OtherKletkaText[playerid][i], 0);
			ShowPlayerTD(playerid, OtherKletkaText[playerid][i]);
		}
		else {
			PlayerTextDrawSetPreviewModel(playerid, OtherKletka[playerid][i], 1649);
			PlayerTextDrawSetPreviewRot(playerid, OtherKletka[playerid][i], 0.000000, 0.000000, 90.000000, 2.000000);

			PlayerTextDrawShow(playerid, OtherKletka[playerid][i]);
		}
		coord[0] += 31.863739, coord[1] += 31.863739;
		if(i == 9 || i == 19 || i == 29 || i == 39 || i == 49 || i == 59) coordx[0] += 28.01857, coord[0] = 186.227982, coord[1] = 215.287720, coordx[1] += 28.01857;
	}

	SetPVarInt(playerid, "ShopAntiDeBug", BizEntered[playerid]);
	SetPVarInt(playerid, "ShopMas",value);
	SetPVarInt(playerid, "ShopMax",count);
	return SelectTextDraw(playerid, PI[playerid][pSelectTD]);
}
