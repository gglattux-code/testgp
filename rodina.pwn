stock Float:GetVehicleHandlingData(vehicleid, handle_id)
{
	static vehicle_massive_id; vehicle_massive_id = SearchVehicleMassiveID(GetVehicleModel(vehicleid));

	if(vehicle_massive_id)
		return 0.0;

	return (vehicleModelInfo[vehicle_massive_id][vehicleHandlingData][handle_id] + VehicleInfo[vehicleid][vHandling][handle_id]);
}

stock bool:GetVehicleItemInventory(vehicleid, searchItemId, startSlotCheking = 0)
{
	if(startSlotCheking >= 20)
		return (VehicleInventorySlotData[vehicleid][startSlotCheking][0] == searchItemId);

	for(new i; i < 10; i++)
	{
		if(VehicleInventorySlotData[vehicleid][startSlotCheking + i][0] == searchItemId)
			return true;
	}

	return false;
}    


