					if(!HouseInfo[i][hAuction]) return 0;
					else if(strlen(HouseInfo[i][hAuctionName]) < 2) 
					{
						f(global_str, 450, "\
						{ffffff}Дом {ffff00}№%d\n\
						{ffffff}Стартовая цена аукциона: {ffff00}%d руб\n\
