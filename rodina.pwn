	return false;
}

stock GetMaxCost(Bstate)
{
    switch Bstate do
    {
		case 26: return 30000;
		case B_BAR: return 10000;
		case B_BUY: return 1000000;
		case 13: return 30000;
		case B_RENTCAR: return 50000;
		case B_GAS: return 30000;
		case B_CL_BELL: return 15000;
		case 0: return 30000;
		case 24: return 999999;
		case 11: return 250000;
		case 19: return 2000000;
    }
    return 0;
}
stock GetNameItem(Bstate, bitem)
{
	static Name[32]; Name[0] = EOS;
	switch Bstate do
	{
	    case 0: SetString(Name, ItemsInfo[ShopData[2][shopItem][bitem]][itemName]);
		case 2: SetString(Name, ItemsInfo[ShopData[1][shopItem][bitem]][itemName]);
		case 6: SetString(Name, ItemsInfo[ShopData[0][shopItem][bitem]][itemName]);
		case 11: SetString(Name, "Honda Zoomer 50");
		case 19:{
			static const name_product[][] = {"Видеокарта", "Охлаждающая жидкость для видеокарты", "Смазка для разгона видеокарты"};
			SetString(Name, name_product[bitem]);
		} 
		case 8:{
			static const name_car[][] = {"ВАЗ 21011", "УАЗ 469", "Renault Arkana", "Honda Accord", "Toyota Camry (2010)", "Tesla Model Y", "Пикап"};
			SetString(Name, name_car[bitem]);
		}
	}
	return Name;
}

stock GetMaxItems(stated)
{
	switch stated do
