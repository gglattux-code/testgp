								else SPD(playerid, 26020, DIALOG_STYLE_LIST, "Выберите действие", "[1] Установить новые позиции{33AA33}\t10 BTC\n{FFFFFF}[2] Установить стандартные позиции\t{33AA33}10 BTC", "Выбор", "Отмена");
