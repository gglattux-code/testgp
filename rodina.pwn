stock ShowPlayerKeyReaction(playerid) {
	TogglePlayerControllable(playerid, false); 
	SendPlayerHotKeys(playerid, false);
	executeEvent(playerid, 0, "window.executeEvent('cef.modals.showModal', `[\"keyReaction\",{\"miniGameTitle\":\"Ловля рыбы\",\"miniGameDescription\":\"чтобы словить рыбу\",\"miniGameKeysCount\":10,\"miniGameDuration\":15}]`);"); 
	return cursorPlayer(playerid, 0, true), dialog_player[playerid][D_Custom] = 1;
}

stock DestroyPlayerKeyReaction(playerid)
{
	TogglePlayerControllable(playerid, true); 
	SendPlayerHotKeys(playerid, true);
	executeEvent(playerid, 0, "window.executeEvent('cef.modals.closeModal', `[\"keyReaction\"]`);");
	return cursorPlayer(playerid, 0, false);
}


stock SendPlayerHotKeys(playerid, bool:toggle) {
	SendPlayerClientPacket(playerid, 0, 73, _:toggle);
	SendPlayerClientPacket(playerid, 0, 51, _:toggle);
	SendPlayerClientPacket(playerid, 0, 67, _:toggle);
	SendPlayerClientPacket(playerid, 0, 37, _:toggle);
	SendPlayerClientPacket(playerid, 0, 39, _:toggle);
	SendPlayerClientPacket(playerid, 0, 48, _:toggle);
	SendPlayerClientPacket(playerid, 0, 57, _:toggle);
	SendPlayerClientPacket(playerid, 0, 32, toggle ? 64 : 0);

	for(new i; i < sizeof(HotKey_data); i++)
		SendPlayerClientPacket(playerid, 0, HotKey_data[i][data_KeyID], _:toggle);

	return true;
}

stock SendPlayerClientPacket(playerid, ...)
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs, 
		PR_UINT8, 220);

	for(new i = 1; i < numargs(); i++) 
		BS_WriteValue(bs, 
			PR_UINT8, getarg(i));

	return PR_SendPacket(bs, playerid, PR_MEDIUM_PRIORITY, PR_RELIABLE, 6), BS_Delete(bs);
}
public: PlayerFishing(playerid)
	return ShowPlayerKeyReaction(playerid);

stock GetFormattedTime(unix_time, output[], len) 
{
    new year, month, day, hour, minute, days_in_month[12] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};

    year = 1970;
    while (unix_time >= 31536000) {
        unix_time -= 31536000;
        if ((year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)) {
            if (unix_time >= 86400) unix_time -= 86400;
            else break;
        }
        year++;
    }
    if ((year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)) 
    	days_in_month[1] = 29; // Февраль
    month = 0;
    while (unix_time >= days_in_month[month] * 86400) {
        unix_time -= days_in_month[month] * 86400;
        month++;
    }
    month++;
    day = (unix_time / 86400) + 1;
    unix_time %= 86400;
    hour = unix_time / 3600;
    unix_time %= 3600;
    minute = unix_time / 60;
    format(output, len, "%02d:%02d %02d.%02d.%d", hour, minute, day, month, year);
	return true;
}

stock ShowAdvent(playerid)
{
	HideCef(playerid, 0), print("12");
	hidePlayerHud(playerid);

	if(GetPlayerLauncher(playerid) == 1)
		executeEvent(playerid, 0, "window.executeEvent('event.setActiveView', `[\"DailyReward\"]`);");

	global_str = "";
	for new i; i < 31; i++ do
		strcat(global_str, (str_f("{\"id\":%d,\"day\":%d,\"title\":\"Секретный приз\",\"amount\":0,\"image\":\"calendar_none\"}%s", i+1, i+1, i == 30 ? "":",")));

	switch(GetPlayerLauncher(playerid)) {
		case 1: executeEvent(playerid, 0, (str_f("window.executeEvent('event.dailyReward.rewards', `[[%s]]`);", global_str)));
		case 2: {
			eventMobile(playerid, {88, 0}, (str_f("[%s]", global_str)));
			eventMobile(playerid, {88, 3}, "{\"background\":1,\"header\": \"Майский календарь\"}");
		}
	}

	global_str = "";
	for new i; i < 31; i++ do
		if(PI[playerid][pAdventCalendarDay][0] >= i)
			strcat(global_str, (str_f("{\"currentDay\":%d,\"needToPlay\":1800,\"played\":%d,\"received\":%d}%s", i+1, PI[playerid][pAdventCalendarTime][i], PI[playerid][pAdventCalendar][i], i == PI[playerid][pAdventCalendarDay][0] ? "":",")));

	switch(GetPlayerLauncher(playerid)) {
		case 1: executeEvent(playerid, 0, (str_f("window.executeEvent('event.dailyReward.initializePlayerDay', `[%s]`);", global_str)));
		case 2: eventMobile(playerid, {88, 1}, (str_f("%s", global_str)));
	}

	return cursorPlayer(playerid, GetPlayerLauncher(playerid) == 1 ? 1:88, true), dialog_player[playerid][D_Custom] = 1;
}


stock SaveCalendar(playerid) {
	new TextAdvent[3][100];
	TextAdvent[0] = "", TextAdvent[1] = "", TextAdvent[2] = "";
	for new i; i < 31; i++ do {
		if i < 2 *then
			f(TextAdvent[0], 100, "%s%d,", TextAdvent[0], PI[playerid][pAdventCalendarDay][i]);

		f(TextAdvent[1], 100, "%s%d,", TextAdvent[1], PI[playerid][pAdventCalendarTime][i]);
		f(TextAdvent[2], 100, "%s%d,", TextAdvent[2], PI[playerid][pAdventCalendar][i]);
	}
	return SQL("UPDATE accounts SET AdventCalendarDay = '%s', AdventCalendarTime = '%s', AdventCalendar = '%s' WHERE ID = '%d'", TextAdvent[0], TextAdvent[1], TextAdvent[2], PI[playerid][pID]);
}


stock LoadKiosk()
{
	new Cache:result = mysql_query(mysql, "SELECT * FROM `Kiosk`");
	OWNABLEKIOSK = cache_num_rows();
	for new i; i < OWNABLEKIOSK; i++ do {
		cache_get_value_name_int(i, "bussinesId", AccessoryKioskData[i][acsKioskBussinesID]);
		cache_get_value_name(i, "accessories", AccessoryKioskData[i][acsKioskAccessory]);

		cache_get_value_name_int(i, "kID", Kiosk[i][kID]);
		cache_get_value_name_int(i, "KBizID", Kiosk[i][KBizID]);

		cache_get_value_name(i, "kItems", global_str), Int_UnPackMassive(global_str, Kiosk[i][kItems]);
		cache_get_value_name(i, "kTimes", global_str), Int_UnPackMassive(global_str, Kiosk[i][kTimes]);
		cache_get_value_name(i, "kTimesLast", global_str), Int_UnPackMassive(global_str, Kiosk[i][kTimesLast]);
		cache_get_value_name(i, "kOpenAks", global_str), Int_UnPackMassive(global_str, Kiosk[i][kOpenAks]);
		cache_get_value_name(i, "kItemSell", global_str), Int_UnPackMassive(global_str, Kiosk[i][kItemSell]);
		cache_get_value_name(i, "kPlayerArend", global_str), Int_UnPackMassive(global_str, Kiosk[i][kPlayerArend]);
		cache_get_value_name(i, "kItemsNashivka", global_str), Int_UnPackMassive(global_str, Kiosk[i][kItemsNashivka]);
		cache_get_value_name(i, "kItemsColor", global_str), Int_UnPackMassive(global_str, Kiosk[i][kItemsType]);
		cache_get_value_name(i, "kItemsZatochka", global_str), Int_UnPackMassive(global_str, Kiosk[i][kItemsColor]);
		cache_get_value_name(i, "kTimesAks", global_str), Int_UnPackMassive(global_str, Kiosk[i][kTimesAks]);

		cache_get_value_name_float(i, "kExit_X", Kiosk[i][kExit_X]);
		cache_get_value_name_float(i, "kExit_Y", Kiosk[i][kExit_Y]);
		cache_get_value_name_float(i, "kExit_Z", Kiosk[i][kExit_Z]);
	}
	return cache_delete(result);
}

stock SaveKiosk(id) {
	return SQL("UPDATE `Kiosk` SET `kItems` = '%s', `kTimes` = '%s', `kTimesLast` = '%s', `kOpenAks` = '%s', `kItemSell` = '%s', `kItemsNashivka` = '%s', `kItemsType` = '%s', `kItemsColor` = '%s', `kItemsZatochka` = '%s', `kTimesAks` = '%s' WHERE `kID` = '%d'", Int_PackMassive(0, Kiosk[id][kItems]), Int_PackMassive(1, Kiosk[id][kTimes]), Int_PackMassive(2, Kiosk[id][kTimesLast]), Int_PackMassive(3, Kiosk[id][kOpenAks]), Int_PackMassive(4, Kiosk[id][kItemSell]), Int_PackMassive(5, Kiosk[id][kItemsNashivka]), Int_PackMassive(6, Kiosk[id][kItemsType]), Int_PackMassive(7, Kiosk[id][kItemsColor]), Int_PackMassive(8, Kiosk[id][kItemsZatochka]), Int_PackMassive(9, Kiosk[id][kTimesAks]), id);//kTimesAks
}


stock ShowEnchantWork(playerid, list)
{
	if EnchantWork{playerid} == true or list > 3 *then return false;
	if list == 3 *then return ShowColorsChange(playerid);

	EnchantWorkItem[playerid][0] = 
	EnchantWorkItem[playerid][1] = 
	EnchantWorkProgress[playerid] = 0;
	EnchantWork{playerid} = true;
	
	if !list *then
	{
		#include <textdraws/cataloges/Enchant>
		
		for new i; i < 29; i++ do 
			ShowPlayerTD(playerid, EnchantWorkTD[playerid][i]);

		ShowInventoryPage(playerid, 485.299988, 138.642853, E_INVENTORY_TYPE_ENCHANT);
	}
	else if(list == 2) {
		hidePlayerHud(playerid); //6476 6479 6477 6478

		executeEvent(playerid, 0, "window.executeEvent('event.setActiveView', `[\"VipImprovement\"]`);");

		executeEvent(playerid, 0, (str_f("window.executeEvent('event.vip.improvement.informationInit', `[{\"level\":%d,\"chance\":%d,\"upgradeDuration\":10000,\"allIsFull\":%d}]`);", PI[playerid][pPremiumUp], 14-PI[playerid][pPremiumUp], (GetCount(playerid, 6476) >= 2 && GetCount(playerid, 6479) >= 10 && GetCount(playerid, 6477) >= 2 && GetCount(playerid, 6478) >= 2) ? 1 : 0 )));

		executeEvent(playerid, 0, (str_f("window.executeEvent('event.vip.improvement.materialsInit', `[[{\"id\":0,\"title\":\"Черная паутина\",\"image\":\"6476.webp\",\"number\":%d,\"maxNumber\":2},{\"id\":1,\"title\":\"Сапфировый стержень\",\"image\":\"6479.webp\",\"number\":%d,\"maxNumber\":10},{\"id\":2,\"title\":\"Антрацит\",\"image\":\"6477.webp\",\"number\":%d,\"maxNumber\":2},{\"id\":3,\"title\":\"Кевларовая нить\",\"image\":\"6478.webp\",\"number\":%d,\"maxNumber\":2}]]`);", GetCount(playerid, 6476) >= 2 ? 2 : GetCount(playerid, 6476), GetCount(playerid, 6479) >= 10 ? 10 : GetCount(playerid, 6479), GetCount(playerid, 6477) >= 2 ? 2 : GetCount(playerid, 6477), GetCount(playerid, 6478) >= 2 ? 2 : GetCount(playerid, 6478))));

		cursorPlayer(playerid, 0, true), dialog_player[playerid][D_Custom] = 1;
	}
	else
	{
		InventoryOpen{playerid} = true;
		
		ShowInventoryTextDraw(playerid, 462.401703 + pTemp[playerid][inventorySize][0], 101.500000 + pTemp[playerid][inventorySize][1]);
		
		InventoryOpen{playerid} = false;
		
		ShowInventoryPage(playerid, 627.401672, 101.500000, E_INVENTORY_TYPE_ENCHANT_2);
		
		for new i; i < 8; i++ do
			PlayerTextDrawSetSelectable(playerid, InvItemSlot[playerid][i], false),
			PlayerTextDrawColor(playerid, InvItemSlot[playerid][i], 0x999999FF),
			ShowPlayerTD(playerid, InvItemSlot[playerid][i]);
		
		PlayerTextDrawSetSelectable(playerid, InvTextDraws[playerid][2], false),
		PlayerTextDrawColor(playerid, InvTextDraws[playerid][2], 0x999999FF),
		ShowPlayerTD(playerid, InvTextDraws[playerid][2]);
	}
	
	return SelectTextDraw(playerid, PI[playerid][pSelectTD]);
}

stock ShowWeaponMenu(playerid)
{
    if(WeaponTDStatus[playerid]) return 1;
    #include textdraws/WeaponMenu
    for(new i; i < 26; i++) PlayerTextDrawShow(playerid, GlobalTDPlayer[playerid][i]);
    WeaponTDStatus[playerid] = true;
    SelectTextDraw(playerid, 0xFF6347FF);
	player_Global_Int1[playerid][10] = 0;
    return UpdateWeaponMenu(playerid, -1, 0, 1);
}
stock HideWeaponMenu(playerid)
{
	if(!WeaponTDStatus[playerid]) return 1;
	for(new i; i < 26; i++) DestroyPlayerTD(playerid, GlobalTDPlayer[playerid][i]);
	WeaponTDStatus[playerid] = false; //SystemTextDrawHide
	CancelSelectTextDraw(playerid);
	return 1;
}
stock UpdateWeaponMenu(playerid, last, select, next)
{
	player_Global_Int1[playerid][10] = select;
	//select global
	PlayerTextDrawSetPreviewModel(playerid, GlobalTDPlayer[playerid][15], InfoWeaponMenuID[select][id_gun]);
	PlayerTextDrawSetPreviewRot(playerid, GlobalTDPlayer[playerid][15], InfoWeaponMenuID[select][x5], InfoWeaponMenuID[select][y5], InfoWeaponMenuID[select][z5], InfoWeaponMenuID[select][a5]);
	PlayerTextDrawShow(playerid, GlobalTDPlayer[playerid][15]);
	//last
	if(player_Global_Int1[playerid][10] > 0 && last != -1)
	{
		PlayerTextDrawSetPreviewModel(playerid, GlobalTDPlayer[playerid][5], InfoWeaponMenuID[last][id_gun]);
		PlayerTextDrawSetPreviewRot(playerid, GlobalTDPlayer[playerid][5], InfoWeaponMenuID[last][x5], InfoWeaponMenuID[last][y5], InfoWeaponMenuID[last][z5], InfoWeaponMenuID[last][a5]);
		PlayerTextDrawShow(playerid, GlobalTDPlayer[playerid][5]);
	}
	else PlayerTextDrawHide(playerid, GlobalTDPlayer[playerid][5]);
	//select
	PlayerTextDrawSetPreviewModel(playerid, GlobalTDPlayer[playerid][4], InfoWeaponMenuID[select][id_gun]);
	PlayerTextDrawSetPreviewRot(playerid, GlobalTDPlayer[playerid][4], InfoWeaponMenuID[select][x5], InfoWeaponMenuID[select][y5], InfoWeaponMenuID[select][z5], InfoWeaponMenuID[select][a5]);
	PlayerTextDrawShow(playerid, GlobalTDPlayer[playerid][4]);
	//next
	if(player_Global_Int1[playerid][10] != sizeof(InfoWeaponMenuID)-1 && next != -1)
	{
		PlayerTextDrawSetPreviewModel(playerid, GlobalTDPlayer[playerid][3], InfoWeaponMenuID[next][id_gun]);
		PlayerTextDrawSetPreviewRot(playerid, GlobalTDPlayer[playerid][3], InfoWeaponMenuID[next][x5], InfoWeaponMenuID[next][y5], InfoWeaponMenuID[next][z5], InfoWeaponMenuID[next][a5]);
		PlayerTextDrawShow(playerid, GlobalTDPlayer[playerid][3]);
	}
	else PlayerTextDrawHide(playerid, GlobalTDPlayer[playerid][3]);
	//text
	PlayerTDSetStringf(playerid,GlobalTDPlayer[playerid][14], "%s", InfoWeaponMenuID[select][name_gun]);
    return 1;
}
