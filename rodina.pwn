							if(StolInfo[id][stolTime] < 1)
							{
								StolInfo[id][stolXod]++;
								if(StolInfo[id][stolXod] >= StolInfo[id][stolPlayers]) StolInfo[id][stolXod] = 0;

								StolInfo[id][stolBit] = StolInfo[id][stolXod]+1;
